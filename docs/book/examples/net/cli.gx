
let cli: args::ParseResult = select args::parse(
    args::command(
        #name: "example",
        #version: "0.1.0",
        #about: "An example CLI tool",
        #subcommands: [
            args::command(
                #name: "serve",
                [args::option(#name: "port", #short: "p", #default: "8080")]
            )
        ],
        [
            args::positional(#name: "file", #help: "Input file"),
            args::option(#name: "count", #short: "n", #default: "1", #help: "Repeat count"),
            args::flag(#name: "verbose", #short: "v", #help: "Verbose output")
        ]
    )
) {
    // CR claude for claude: [readability/low] The book's way to split a Result is
    // `error as e => .., v => v`. This example, the only one on the args page, tests
    // both sides by written type instead, and writes the error side as `Error<'e>`, a
    // fresh variable in a pattern; select.md uses that form only to test inside a
    // declared type variable. `error as e => select e.0 { .. }, r => r`, under the same
    // `let cli: args::ParseResult` annotation, checks and behaves the same for help,
    // version, a usage error and a subcommand. Also drop the blank first line, which
    // opens the book's code block empty. probe:
    // design/review-2026-11-16/repro/examples-rest-cli-error-idiom.gx
    // (examples-rest-03)
    args::ParseResult as r => r,
    Error<'e> as e => select e.0 {
        `ArgHelp(text) => on text {
            println(text);
            sys::exit(0)
        },
        `ArgError(text) => on text {
            println(text);
            sys::exit(2)
        }
    }
};

println("Command: [cli.command]");
println("Values: [cli.values]");
sys::exit(cli ~ 0)
