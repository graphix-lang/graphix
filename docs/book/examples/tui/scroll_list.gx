use tui::{
  line,
  input_handler::{Event, input_handler, on_press},
  list::list,
  scrollbar::scrollbar
};

let items = array::init(30, |i| line("Item [i + 1]"));
let last = array::len(items) - 1;
let selected = 0;
let scroll_pos = 0;
// CR claude for claude: [bug/medium] `visible` is a constant, but ratatui scrolls the
// list by its real height. Below 10 rows the list moves while the thumb stays put.
// Above 10 rows the example scrolls although the selection fits. The list also sets no
// highlight, so the selection cannot be seen. Fix: `let size: Size = never(); let
// visible = size.height;`, pass `#size: &mut size` to the scrollbar, and add
// `#highlight_style` to the list. Then fix scroll_list_follows_the_selection in
// examples_test, which pins the over-scroll at 24 rows. probe:
// design/review-2026-10-19/repro/examples-tui-list-overscroll.sh (examples-tui-02)
let visible = 10;

// Auto-scroll to keep selection visible
scroll_pos <- select selected {
    s if s < scroll_pos => s,
    s if s >= (scroll_pos + visible) => s - visible + 1,
    _ => never()
};

let handle_event = |e: Event| on_press(e, |k| select k.code {
    k@`Up if selected > 0 => {
        selected <- (k ~ selected) - 1;
        `Stop
    },
    k@`Down if selected < last => {
        selected <- (k ~ selected) + 1;
        `Stop
    },
    _ => `Continue
});

input_handler(
    #handle: &handle_event,
    &scrollbar(
        #position: &scroll_pos,
        #content_length: &array::len(items),
        #viewport_length: &visible,
        &list(
            #scroll: &scroll_pos,
            #selected: &selected,
            &items
        )
    )
)
