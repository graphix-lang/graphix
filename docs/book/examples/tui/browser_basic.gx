use tui::{Size, block::block, browser::browser};

let selected_path: [string, null] = never();
let size: Size = never();

block(
    #border: &`None,
    #size: &mut size,
    &browser(
        #size,
        #selected_path: &mut selected_path,
        // Start browsing from root
        "/"
    )
)
