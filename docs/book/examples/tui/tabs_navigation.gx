use tui::{
  line, style,
  block::block,
  input_handler::{Event, input_handler, on_press},
  tabs::tabs,
  text::text
};

let selected_tab = 0;

let handle_event = |e: Event| on_press(e, |k| on k {
    select k.code {
        `Left if selected_tab > 0 => {
            selected_tab <- selected_tab - 1;
            `Stop
        },
        `Right if selected_tab < 2 => {
            selected_tab <- selected_tab + 1;
            `Stop
        },
        `Tab => {
            selected_tab <- (selected_tab + 1) % 3;
            `Stop
        },
        _ => `Continue
    }
});

let overview = text(&"Overview");
let items = text(&"Items");
let settings = text(&"Settings");

input_handler(
    #handle: &handle_event,
    &block(
        #border: &`All,
        #title: &line("Application (←/→ to navigate)"),
        &tabs(
            #highlight_style: &style(#fg: `Yellow, #add_modifier: [`Bold]),
            #style: &style(#fg: `Gray),
            #selected: &selected_tab,
            &[
                (line("Overview"), overview),
                (line("Items"), items),
                (line("Settings"), settings)
             ]
        )
    )
)

