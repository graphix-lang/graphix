use tui::{line, paragraph::paragraph};
use sys::time;

// Self-contained: publish a simulated log entry every second, then
// subscribe to display the rolling window. Drop the publish to point
// the viewer at any other string publisher.
let tick = time::timer(duration:1.s, true);
let n = count(tick);
let messages = [
    "request handled",
    "cache miss",
    "user signed in",
    "background job complete",
    "config reloaded",
];
let log_source = "";
log_source <- tick ~ "[n] [rand::pick(tick ~ messages)]";
sys::net::publish("/local/graphix/paragraph_log_viewer/log", log_source);

let log_entries = [];
let new_entry: string = sys::net::subscribe("/local/graphix/paragraph_log_viewer/log")$;

// CR claude for claude: [bug/medium] `array::window` appends the newest entry at the
// end, and the paragraph below keeps its default scroll of {x: 0, y: 0}. So a view H
// lines tall shows entries 0..H forever, and once the log is taller than the terminal
// (about 22 s at 24 lines) every new entry is out of sight. The page sells this as a
// live log viewer. Fix: follow the tail, e.g. a `block` with `#size: &mut size` and
// `#scroll: &{x: 0, y: max(0, array::len(log_entries) - size.height)}`, or keep the
// newest entry first. probe:
// design/review-2026-10-19/repro/book-ui-a-log-viewer-newest-hidden.gx (book-ui-a-03)
log_entries <- array::window(
    #n: 100,
    new_entry ~ log_entries,
    line(new_entry)
);

// CR claude for claude: [bug/medium] The paragraph draws from the top and new entries
// are appended at the end, so once the screen is full the newest entries are never
// visible. The initial `log_source = ""` is published too, which makes the first line
// blank. Fix: `let log_source: string = never();`, and follow the tail with a block's
// `#size` output: `#scroll: &{x: 0, y: max(0, array::len(log_entries) - size.height)}`
// and `#wrap: &false`. probe:
// design/review-2026-10-19/repro/examples-tui-log-viewer-tail.sh (examples-tui-03)
paragraph(&log_entries)
