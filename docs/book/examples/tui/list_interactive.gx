use tui::{
  line, style,
  block::block,
  input_handler::{Event, input_handler, on_press},
  list::list
};

let items = [
    line("Apple"), line("Banana"), line("Cherry"),
    line("Date"), line("Elderberry"), line("Fig"), line("Grape")
];

let last = array::len(items) - 1;
let selected = 0;

let handle_event = |e: Event| on_press(e, |k| on k {
    select k.code {
        `Up if selected > 0 => {
            selected <- selected - 1;
            `Stop
        },
        `Down if selected < last => {
            selected <- selected + 1;
            `Stop
        },
        `Home => { selected <- 0; `Stop },
        `End => { selected <- last; `Stop },
        _ => `Continue
    }
});

input_handler(
    #handle: &handle_event,
    &block(
        #border: &`All,
        #title: &line("Fruit Selection"),
        &list(
            #highlight_style: &style(#fg: `Black, #bg: `Yellow),
            #highlight_symbol: &"▶ ",
            #selected: &selected,
            &items
        )
    )
)
