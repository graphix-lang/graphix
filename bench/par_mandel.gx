// Fused data parallelism: a mandelbrot grid (800x600, 256 max
// iterations) recomputed 10 times, the window shifting each cycle, so
// the fused array::init's loop reruns. Each pixel's escape count is a
// tail-recursive kernel called from the init callback: the loop's
// chunks fork across the pool. Prints the first cycle and the 9 that
// follow separately.
// CR claude for claude: [doc-drift] k runs 0..10. `first` is stamped after the k=0
// computation and t1 after the k=10 one, so steady_s times 10 recomputations, not 'the
// 9 that follow' (11 computations in all). par_wide.gx:6-7 says 59 where it is 60, and
// bench/README.md:185 and 189 repeat 59 and 9. README:200's '4-thread cycle's 50' ms is
// 0.45 s / 9; over 10 cycles it is 45 ms. Say 10 and 60, or stop the loops at k == 9
// and k == 59. probe: `count(r)` sampled at `done` reads 11 here (at 40x30) and 61 in
// par_wide (at depth 3). (examples-06)
let t0 = sys::time::now(0);
let w = 800;
let h = 600;
let max_iter = 256;
let rec iterate = |zr: f64, zi: f64, cr: f64, ci: f64, i: i64| -> i64
  select i {
    0 => 0,
    _ if zr * zr + zi * zi > 4.0 => i,
    _ => iterate(zr * zr - zi * zi + cr, 2.0 * zr * zi + ci, cr, ci, i - 1)
  };
let k = 0;
let shift = cast<f64>(k)$ * 0.001;
let xmin = -2.5 + shift;
let dx = 3.5 / cast<f64>(w)$;
let dy = 2.625 / cast<f64>(h)$;
let counts = array::init(w * h, |idx| {
  let cr = xmin + cast<f64>(idx % w)$ * dx;
  let ci = -1.3125 + cast<f64>(idx / w)$ * dy;
  iterate(0.0, 0.0, cr, ci, max_iter)
});
let r = array::fold(counts, 0, |acc, n| acc + n);
k <- r ~ select k { k if k < 10 => k + 1, _ => never() };
let first = sys::time::now(select k { 0 => r, _ => never() });
let done = select k { 10 => r, _ => never() };
let t1 = sys::time::now(done);
let build = cast<f64>(first)$ - cast<f64>(t0)$;
let steady = cast<f64>(t1)$ - cast<f64>(first)$;
println("par_mandel r=[done] build_s=[build] steady_s=[steady] elapsed_s=[steady]");
sys::exit(steady ~ 0)
