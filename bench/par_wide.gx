// A wide node-walked cycle, computed 61 times: 16 independent slots,
// each a fixed-shape recursion (2^11 activations) over a value that
// changes every cycle, so the cost model learns the slots and forks
// them without an attribute. Fusion would turn the map into one native
// loop with nothing to fork: run it --no-fusion (bench/par.sh does). It
// prints the first cycle (the activations' construction) and the 60
// that follow separately.
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$ % 2;
let rec f = |d: i64, v: i64| -> i64 select d {
    0 => v,
    d => (f(d - 1, v + 1) + f(d - 1, v * 3)) % 1000003
};
let k = 0;
let xs = array::init(16, |i| k + seed + i);
let r = array::fold(array::map(xs, |x| f(11, x)), 0, |a, b| a + b);
k <- r ~ select k { k if k < 60 => k + 1, _ => never() };
let first = sys::time::now(select k { 0 => r, _ => never() });
let done = select k { 60 => r, _ => never() };
let t1 = sys::time::now(done);
let build = cast<f64>(first)$ - cast<f64>(t0)$;
let steady = cast<f64>(t1)$ - cast<f64>(first)$;
println("par_wide r=[done] build_s=[build] steady_s=[steady] elapsed_s=[steady]");
sys::exit(steady ~ 0)
