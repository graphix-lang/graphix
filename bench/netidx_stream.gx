// Same per-tick stats pipeline as stream_stats, but every tick makes a
// REAL netidx round trip: the price is published at a path, received via
// subscribe, and the NEXT tick is published only after the current one's
// stats have landed (self-clocking, so publisher coalescing can never
// drop a tick). The round trip is expected to dominate per-event cost;
// the bench measures how much end-to-end throughput the fused per-event
// compute buys on top of it.
mod winstats;

let n = 2000;
let wsize = 64;
let path = "/local/bench/stream/price";
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let idx = 0;
let tick_out = {
  let x = (seed + idx * 1103515245 + 12345) % 1000;
  100.0 + cast<f64>(x)$ / 10.0
};
sys::net::publish(path, tick_out)$;
let tick: f64 = sys::net::subscribe(path)$;
let chk = winstats::stats(wsize, tick);
let processed = count(chk) - 1;
// XCR claude for claude: [bug/medium] netidx_stream is not self-clocked, and `processed`
// over-counts. `let (variance, chk) = winstats::stats(..)` fires both names whenever
// the tuple fires. The tuple fires twice per tick: when the inner variance fires, and
// again when the inner chk lands a cycle later. So idx advances twice per received
// tick, two or more ticks are in flight (the coalescing this header rules out is
// possible), and `count(chk) - 1` counts some ticks twice, so `done` can fire before n
// ticks were processed. Fix: have winstats::stats return chk alone (stream_stats uses
// nothing else) and clock on it: `let processed = count(chk) - 1; idx <- select
// processed { p if p > 0 && p < n => p, _ => never() }`, which keeps one tick in flight
// and ends at processed = n. winstats' header is wrong too: variance fires from the
// first tick, not after the window fills. probe:
// design/review-2026-10-19/repro/examples-rest-netidx-stream-double-clock.gx
// (examples-rest-01)
// 2026-10-19 claude: winstats::stats returns chk alone and netidx_stream clocks idx on
// processed (p > 0 && p < n). At n = 50 under --no-netidx the run prints one result
// line and its chk equals stream_stats' for the same seed. Its README Results row was
// measured on the double clock: re-measure it with bench/run.sh on a quick build. The
// winstats header now says chk fires at birth and once per tick.
idx <- select processed {
  p if p > 0 && p < n => p,
  _ => never()
};
let done = select processed {
  p if p < n => never(),
  p => p
};
let t1 = sys::time::now(done);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
let rate = cast<f64>(done)$ / elapsed;
println("netidx_stream n=[n] win=[wsize] chk=[chk] events_per_s=[rate] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
