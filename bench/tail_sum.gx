// Scalar integer tail loop: 100k iterations of (cmp, sub, add). The JIT
// lowers self-tail-calls to a native rebind-and-jump loop. The node-walk
// runs every call as an activation it keeps (design/tail_calls_are_calls.md),
// one per iteration, so the size is held at 100k.
let rec sum_to = |n: i64, acc: i64| -> i64
  select n {
    0 => acc,
    _ => sum_to(n - 1, acc + n)
  };
let n = 100000;
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let result = sum_to(n, seed);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("tail_sum n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
