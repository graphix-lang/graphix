// Symbolic differentiation over a recursive ADT, the symbolic-processing
// workload class (`symexpr`): one tree per seed, the per-seed results
// accumulated into a float checksum by array::fold.
mod symexpr;

let n = 32;
let k = 32;
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;

let result =
  array::fold(array::init(k, |i| i), 0.0, |acc, i| acc + symexpr::run_one(n, seed + i));
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("symbolic n=[n] k=[k] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
