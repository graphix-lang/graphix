// A node-walked chain of 1000 distinct functions, each calling the one
// before it, timed through its first cycle: every operator in it is a
// fork point with one operand that does work, so Auto must cost what
// serial does (bench/par.sh runs it --no-fusion).
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$ % 2;
let f0 = |x: i64| x + 1;
let f1 = |x: i64| f0(x) * 2 + 1;
let f2 = |x: i64| f1(x) * 2 + 2;
let f3 = |x: i64| f2(x) * 2 + 3;
