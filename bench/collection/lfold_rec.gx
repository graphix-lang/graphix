// list fold written in Graphix: natural tail recursion over native List
// patterns. Its twin at this size is lfold_intr_4k; lfold_rec_100k runs it
// at lfold_intr's size.
let n = 4000;
let src = list::init(n, |i| i);
let rec lfold_go = |l: List<i64>, f: fn(acc: i64, x: i64) -> i64, acc: i64| -> i64
    select l {
        [<>] => acc,
        [<x, rest..>] => lfold_go(rest, f, f(acc, x))
    };
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let result = lfold_go(src, |a, x| a + x, seed);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("lfold_rec n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
