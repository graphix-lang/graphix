// P2b: array filter as the trait DEFAULT body — filter_map with a
// select on the predicate.
let n = 100000;
let src = array::init(n, |i| i);
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let flt = array::filter_map(src, |x| select (x + seed) % 2 == 0 {
    true => x,
    false => null
});
let result = array::fold(flt, 0, |a, x| a + x);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("filter_fmshape n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
