// P2b: array fold written in Graphix — tail recursion over indexes,
// callback threaded as a parameter (the stdlib-body shape).
let n = 100000;
let src = array::init(n, |i| i);
let rec fold_go = |a: Array<i64>, f: fn(acc: i64, x: i64) -> i64, i: i64, acc: i64| -> i64
    select i < array::len(a) {
        true => fold_go(a, f, i + 1, f(acc, a[i]$)),
        false => acc
    };
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let result = fold_go(src, |a, x| a + x, 0, seed);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("fold_rec n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
