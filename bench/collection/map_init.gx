// P2b: array map as a Graphix body over the init intrinsic:
// map = |a, f| init(len(a), |i| f(a[i])).
let n = 100000;
let src = array::init(n, |i| i);
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let mapped = array::init(array::len(src), |i| src[i]$ * 3 + seed);
let result = array::fold(mapped, 0, |a, x| a + x);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("map_init n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
