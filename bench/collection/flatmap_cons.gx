// P2b: array flat_map derived in Graphix — cons every produced element
// onto a List (O(1) each) and finish with ONE list::to_array_rev pass.
// O(n) total, against flatmap_fold's O(n^2) concat copies. The chunk
// is consed directly; see flatmap_list for the same thing through a
// nested fold, which is the nested-HOF quadratic witness.
let n = 10000;
let src = array::init(n, |i| i);
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let empty: List<i64> = list::nil(0);
let rev = array::fold(src, empty, |acc, x| list::cons(x * 2, list::cons(x + seed, acc)));
let result = array::fold(list::to_array_rev(rev), 0, |a, x| a + x);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("flatmap_cons n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
