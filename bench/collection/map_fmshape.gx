// P2b: array map as the trait DEFAULT body — filter_map with a total
// callback (map = |c, f| filter_map(c, |x| f(x))).
let n = 100000;
let src = array::init(n, |i| i);
let t0 = sys::time::now(0);
let seed = cast<i64>(t0)$;
let result = array::fold(array::filter_map(src, |x| x * 3 + seed), 0, |a, x| a + x);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("map_fmshape n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
