// array map as the trait DEFAULT body: filter_map with a callback that
// keeps every element (map = |c, f| filter_map(c, |x| `Keep(f(x)))).
let n = 100000;
let src = array::init(n, |i| i);
let t0 = sys::time::now(src);
let seed = cast<i64>(t0)$;
let result = #[native] array::fold(array::filter_map(src, |x| `Keep(x * 3 + seed)), 0, |a, x| a + x);
let t1 = sys::time::now(result);
let elapsed = cast<f64>(t1)$ - cast<f64>(t0)$;
println("map_fmshape n=[n] result=[result] elapsed_s=[elapsed]");
sys::exit(elapsed ~ 0)
