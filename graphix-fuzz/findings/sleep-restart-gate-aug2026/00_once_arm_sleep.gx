// P7 Sync-flip witness: once() inside a select arm that deselects and
// re-selects. Interp: arm deselection sleeps once (documented RESTART
// semantics) so re-selection re-arms it. If the fused kernel has no
// interior arm-sleep initiator for DynCall slots, once stays burned.
// schedule-v1: cap=96 events=768; in0=i64:0; in0=i64:1; in0=i64:2; in0=i64:4
{
	let sel = select in0 % 2 {
		0 => once(in0),
		_ => i64:-1
	};
	sel
}
