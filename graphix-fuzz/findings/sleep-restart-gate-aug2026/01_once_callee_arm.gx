// P7 witness (callee-carried): the once lives in a CALLEE kernel; the
// call site sits in a select arm. The caller must consult the callee's
// transitive stateful fact and refuse (interior-sleep gate).
// schedule-v1: cap=96 events=768; in0=i64:0; in0=i64:1; in0=i64:2; in0=i64:4
{
	let g = |x: i64| -> i64 once(x);
	let sel = select in0 % 2 {
		0 => g(in0),
		_ => i64:-1
	};
	sel
}
