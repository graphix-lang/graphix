// The finding as minimized: the same sleep is a seq step between runs.
// Expected (both engines): the second run stalls at `v3(..)`.
// schedule-v1: cap=96 events=768; in0=i64:1; in0=i64:0 in1=i64:0
{let v0: List<i64> = [<((i64:0 % in0) % (in0 % i64:2))>]; let v1 = in1 ~ i64:0; v1 <- select v1 {s if s < i64:3 => s + i64:1, _ => never()}; let v2 = select v1 {i64:1 | i64:2 => v1, _ => never()}; let v3 = |v4: i64| -> i64 v4 * i64:3 + (select v0 {[<h0, ..>] => h0, [<>] => i64:0}); let v5 = |v4: i64| -> [i64, Error<`Oops>] select (v4 % i64:2) {i64:0 => error(`Oops), _ => v4}; let v6: Error<Any> = never(); catch(e) v6 <- e; let v7 = i64:0; v7 <- v6 ~ (v7 + i64:1); let v8 = i64:0; let v10 = seq v2 {println("s0 [in1]"); let v9 = v3((-(v2))); println("s2 [in0]"); v8 <- v8; select v0 {[<h0, ..>] => h0, [<>] => select v0 {[<h0, ..>] => h0, [<>] => in1}}}; println("run [v10]"); let v11 = i64:0; v11 <- v10 ~ (v11 + i64:1); let v12 = i64:0; v12 <- v10; let v13 = i64:0; select v13 {v14 if v14 < i64:2 => v13 <- (v14 ~ v13) + i64:1, _ => never()}; ((v11 + v12) - in0)}
