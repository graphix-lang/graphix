// Same sleep, a let: the wake refresh published values only, so `y` kept 0.
// Expected (both engines): the last epoch is quiet.
// schedule-v1: cap=96 events=768; in0=i64:1 in1=i64:1; in1=i64:0; in0=i64:0; in1=i64:1
{let v0 = i64:10 % in0;  select in1 {i64:1 => { println("arm"); { let y = v0; y + i64:1 } }, _ => i64:-1}}
