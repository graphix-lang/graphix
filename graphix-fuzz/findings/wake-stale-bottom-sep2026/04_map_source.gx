// Same sleep, a collection HOF whose source is the bottom: it rode its built array.
// Expected (both engines): the last epoch is quiet.
// schedule-v1: cap=96 events=768; in0=i64:1 in1=i64:1; in1=i64:0; in0=i64:0; in1=i64:1
{let v0 = [i64:10 % in0, i64:3]; select in1 {i64:1 => { println("arm"); array::map(v0, |x| x + i64:1) }, _ => [i64:-1]}}
