// sep19b ryouko reactive divergence_000000 (2026-09-20), cut by hand.
// `v0` goes bottom (in0 = 0) while the println arm sleeps. At the wake
// the inner select's scrutinee is a STALE bottom; the interp rode its
// pre-sleep resident out as a value (100), the kernel read the bottom.
// A bottom scrutinee now always sets a bottom resident.
// Expected (both engines): -1; 100; -1; <quiet>; <quiet>.
// schedule-v1: cap=96 events=768; in0=i64:1 in1=i64:1; in1=i64:0; in0=i64:0; in1=i64:1
{let v0 = i64:10 % in0; select in1 {i64:1 => { println("arm"); select v0 {i64:0 => i64:100, n => n + i64:1} }, _ => i64:-1}}
