// Same sleep, a call: the arg cell and the formal were re-seeded from values only.
// Expected (both engines): the last epoch is quiet.
// schedule-v1: cap=96 events=768; in0=i64:1 in1=i64:1; in1=i64:0; in0=i64:0; in1=i64:1
{let v0 = i64:10 % in0; let f = |x: i64| -> i64 x + i64:1; select in1 {i64:1 => { println("arm"); f(v0) }, _ => i64:-1}}
