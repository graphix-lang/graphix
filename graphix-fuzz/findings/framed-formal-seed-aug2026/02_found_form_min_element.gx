// bisect: divergence (interp != jit) — FIXED, kept as regress pin.
// The soak-found form of 01 (hz0 aug18a divergence_000000, fuzzer-
// minimized): same class, with the i64 MIN element and the count/select
// wrapper the generator wrapped around it. interp Trace([]) vs jit
// firing per epoch before the fix.
{let x = array::iter([i64:0, i64:2, i64:-9223372036854775808, i64:4]); let m = x; let rec f = |n| select n {i64:0 => array::fold([x, x], i64:0, |a, b| a + b * b), _ => f(i64:0)}; let c = f(i64:3); c}
