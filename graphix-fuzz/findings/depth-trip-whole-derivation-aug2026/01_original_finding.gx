// RULED (Eric, 2026-08-14): WHOLE-DERIVATION — a depth trip bottoms
// the entire function call at the root, with log::error at the trip
// (a program hitting the limit is a serious problem for the user).
// Implementation: ctx.depth_tripped is set at the trip and cleared
// when the derivation's root pops the depth to 0; while set, the
// select scrutinee ride refuses (no stale fragment may be assembled
// mid-unwind) and a tainted guard's held ride reads FALSE (the
// kernel's tainted-guard mask). The kernel needed only the log — its
// value-level trip propagation with no interior ride storage already
// implements the ruling. Both engines agree; the old interp behavior
// (per-level unwind with retained-instance rides, ambient-depth
// sensitive) is repealed.
//
// bisect: fusion/JIT bug (interp != jit)
// interp: Trace(Trace { epochs: [Epoch { events: [(1, I64(-1)), (2, I64(1)), (3, I64(-1)), (4, I64(3))], capped: false }], stdout: [] })
// jit:    Trace(Trace { epochs: [Epoch { events: [(1, I64(-1)), (3, I64(-1))], capped: false }], stdout: [] })
// mutant: {let x = array::iter([i64:0, i64:2, i64:0, i64:4]); let m = x / i64:3; let f = |k| select i64:-1 {i64:0 if m == i64:0 => i64:1, _ => i64:1}; let m = count(let rec f = |n: i64| -> i64 select n {i64:0 => i64:0, _ => n - f(f(x) + i64:1 - i64:1)}); f(x - i64:1)}
// minimized:
{
    let x = array::iter([i64:0, i64:2, i64:0, i64:4]);
    let rec f = |n: i64| -> i64 select n {
        i64:0 => i64:0,
        _ => n - f(f(x) + i64:1 - i64:1)
    };
    f(x - i64:1)
}
