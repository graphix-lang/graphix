// The same with `seq`: the JIT dropped the woken run.
// schedule-v1: cap=192 events=1536; in1=i64:0; in1=i64:1; in0=bool:false in1=i64:2
{ let v3 = |v1: i64| -> [i64, Error<`Oops>] select (v1 % 2) { 0 => error(`Oops), _ => v1 }; let v4: Error<Any> = never(); catch(e) v4 <- e; let v5 = 0; v5 <- v4 ~ (v5 + 1); let v6 = 0; let v10 = select (in1 % 2) { 0 => seq in1; abort(in1) { println("run [in1]"); let v9 = v3((in1 % in1))?; println("after [in1]"); cast<i64>(z64:42)$ }, _ => never() }; let v11 = 0; let v12 = 0; let v13 = 0; println("v5 [v5]"); ((v13 * v5) * v5) }
