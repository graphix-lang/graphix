// A native tail loop's selects sit on its spine, and what they consumed
// reaches the return through the spine's accumulator: the depth `v0`,
// written 1 and 3 while arm 0 sleeps, decides the loop, so its answer
// moved at the wake (in0 = 4) and the formal it stands in fires 3 for the
// closure `once` holds. An accumulator that carried only the scrutinees'
// fire left the formal quiet at 0.
// Expected trace (both engines): 0; 3.
// schedule-v1: cap=96 events=768; in0=i64:2 in1=i64:0; in0=i64:1; in0=i64:3; in0=i64:4; in1=i64:8; in0=i64:6
{ let v0 = i64:0; v0 <- select (in0 % i64:2) { i64:1 => in0, _ => never() }; let v1 = |v2: i64| |v3: i64| { let v8 = v3; v2 }; let rec v9 = |v10: i64, v11: i64| -> i64 select v10 { i64:0 => v11, _ => v9(v10 - i64:1, v11 + i64:1) }; let v4 = select (in0 % i64:2) { i64:0 => v1(v9(v0, i64:0)), _ => v1(v0 + i64:100) }; let v5 = once(v4); let v6 = v5(in1); let v7 = count(v6); println("[v6]"); println("[v7]"); v6 }
