// What a wake stands moved is a fire for a reader outside the woken arm
// (design/bind_driven_bodies.md, the moved mark). Arm 0 makes a closure
// over `mk`'s formal and sleeps through the writes of `v0` (1, then 3);
// `once` holds the closure where no sleep reaches. At the wake (in0 = 4)
// the formal is re-seeded 3, moved, and fires for the held closure's
// kernel: its select takes `3 => 30 + y`. Before the rule the formal
// changed with no fire: the kernel routed by it at the next fire of `y`
// (38) while the node-walk kept its arm (3008).
// Expected trace (both engines): 0; 0; 30; 38.
// schedule-v1: cap=96 events=768; in0=i64:2 in1=i64:0; in0=i64:1; in0=i64:3; in0=i64:4; in1=i64:8; in0=i64:6
{ let v0 = i64:0; v0 <- select (in0 % i64:2) { i64:1 => in0, _ => never() }; let v1 = |v2: i64| |v3: i64| #[native] select v2 { i64:3 => i64:30 + v3, v => v * i64:1000 + v3 }; let v4 = select (in0 % i64:2) { i64:0 => v1(v0), _ => v1(v0 + i64:100) }; let v5 = once(v4); let v6 = v5(in1); let v7 = count(v6); println("[v6]"); println("[v7]"); v6 }
