// The aug15b katana witness as the campaign minimized it: the connect
// target is an arm-local fed by a fold, ten tail-recursive frames deep.
{let rec f = |x: i64| select x {x if x < i64:10 => f(x + i64:1), x => {let a = [i64:1, i64:2, i64:3]; let s = i64:0; s <- array::fold(a, i64:0, |acc, e| acc + e); s}}; f(i64:0)}
