// A non-scalar cast lowers to the same DynCall path with a `[T, Error]`
// Value-shape return — the same missing fold.
{let x = array::iter([i64:1, i64:2, i64:3, i64:4]); let f = |n| array::map([n], |i| cast<string>(i64:7)); let a = f(x); let c = count(a); select count(x) {i64:4 => c, _ => never()}}
