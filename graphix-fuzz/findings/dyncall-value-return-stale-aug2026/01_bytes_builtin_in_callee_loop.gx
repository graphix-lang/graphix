// The minimal face of 00: a bytes-returning constant-arg builtin in a
// callee's loop fires on every invocation of the callee.
{let x = array::iter([i64:1, i64:2, i64:3, i64:4]); let f = |n| array::map([n], |i| buffer::from_string("hello")); let a = f(x); let c = count(a); select count(x) {i64:4 => c, _ => never()}}
