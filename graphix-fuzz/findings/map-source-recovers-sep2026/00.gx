// sep20b ryouko/0. A map whose callback ignores its element: the source went bottom while the arm slept, then came back with no slot firing, and the node-walk rode the bottom resident.
// Expected (both engines): 6, 0, 0, then 6 at x=1.
{ let x = array::iter([1, 2, 3, 4, 1]); let d = select x { 1 | 2 => 1, _ => 0 }; let v0 = 2 / d; let r = select x { 1 | 4 => array::fold(array::map([v0, 3], |y| 2 + 1), 0, |a, y| a + y), _ => 0 }; r }
