// catch(e: T) ascribes T to e and still checks that T contains every
// error the covered region can throw. An index error is coverable
// here, the annotation only admits ArithError -> compile-reject.
{
    let a = [1, 2, 3];
    catch(e: Error<ErrChain<`ArithError(string)>>) never(e);
    a[10]?
}
