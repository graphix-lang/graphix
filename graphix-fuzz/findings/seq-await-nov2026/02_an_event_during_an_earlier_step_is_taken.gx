// An event that fired while an earlier step of the run was under way is not lost:
// the await takes it when it is entered. Expected: [30, 6].
{ let step = 0; step <- select step { n if n < 12 => n + 1, _ => never() }; let ev = never<i64>(); ev <- select step { 3 => 30, 8 => 80, _ => never() }; let t = select step { 1 => null, _ => never() }; seq t { until live(step) >= 5; let got = await(ev); (got, live(step)) } }
