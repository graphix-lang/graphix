// THE STRICT SELECT RULE (Eric's ruling 2026-08-06): a select emits
// iff its SELECTION CHANGES (becoming-selected emits the new arm's
// current value) or the TAKEN ARM's body produces. A scrutinee
// re-fire that changes neither is QUIET — the interp's same-arm ride
// re-emit and the kernel's scrutinee-disc fold at value merges are
// both gone (they disagreed exactly on starved shapes: this witness
// was the aug05h jit missing-fire, then the 6fcd6c1e "fix" flooded 48
// over-fires in an hour). Uniform in every position: |n| select ...
// and |n| { let x = select ...; x } fire identically.
// Both modes now: [0:2]; [] — becoming-selected fires once, the
// starved fold arm (v10 never emits: the try-catch value channel is
// the try block's last expr) never re-fires.
// schedule-v1: cap=80 events=640; in0=i64:1
{let v0: Array<i64> = []; v0 <- in0 ~ array::push(v0, in0); let v8 = |v9: i64| select v9 {i64:0 => (i64:1 + v9), _ => error(true)}; let v10 = { catch(e) (-(in0)); (v8(i64:1))? }; let v11: i64 = select in0 {v11 => array::fold(v0, i64:2, |v12, x| v10)}; v11}
