{let a = [i64:0, ("foo", f64:42.)]; let out = select a {[x, tl..] => {type List<'a> = [`Cons('a, List<'a>), `Nil]; let l: List<Any> = `Cons(i64:42, `Cons(i64:3, `Nil)); l}, _ => never()}; "[array::group(out, |i, x| true)]"}
