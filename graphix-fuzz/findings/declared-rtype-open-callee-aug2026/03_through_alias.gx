// The third way to reach the def without a static call site: bind it to
// an annotated alias and call the alias. The annotation is checked
// against the lambda's SIGNATURE, whose return cell is still open at
// that point, so it agrees with anything; the body is never revisited.
{
  let f = |#x: i64| {
    let s = |n| [n];
    s(x)
  };
  let g: fn(#x: i64) -> i64 = f;
  g(#x: i64:4)
}
