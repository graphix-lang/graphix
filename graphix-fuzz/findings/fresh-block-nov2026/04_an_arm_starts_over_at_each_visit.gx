// In a select arm the event is the arm's bind: each visit starts the arm's body over,
// right at the entry (`data` moved while the arm slept) and live after it.
// Expected: [[1, 1], [1, 2], [2, 1], [3, 2], [4, 1]].
{ let step = 0; step <- select step { n if n < 8 => n + 1, _ => never() }; let tab: [`A, `B] = `A; tab <- select step { 1 => `B, 3 => `A, 5 => `B, 7 => `A, _ => never() }; let data = 1; data <- select step { 2 => 2, 4 => 3, 6 => 4, _ => never() }; let view = select uniq(tab) { t@ `A => fresh t { (uniq(data), count(step)) }, `B => never() }; array::group(view, |i, _| i == 5) }
