// The block's state is new wherever it stands: an arm inside it that slept through
// a start is not the arm of the block's last life. Resetting the block in place
// would count 3 at step 6. Expected: [1, -1, 2, -1, 1, -1, 1].
{ let step = 0; step <- select step { n if n < 8 => n + 1, _ => never() }; let k = select step { 2 => null, 5 => null, 7 => null, _ => never() }; let v = fresh k { select step % 2 { 0 => count(step), _ => -1 } }; array::group(v, |i, _| i == 7) }
