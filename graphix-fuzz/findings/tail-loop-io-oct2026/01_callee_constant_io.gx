// A native tail loop whose callee performs a constant-triggered Io call:
// each newly reached depth performs it, as the node-walk activation does.
let k = 0;
k <- select k < 5 { true => k + 1, false => never() };
let g = |m: i64| -> i64 { dbg(7); m };
let rec f = |n: i64, acc: i64| -> i64 select (n, acc) {
  (0, a) => g(a),
  (n, a) => f(n - 1, a + n)
};
f(k, 0)
