{let x = array::iter([i64:0, i64:2, i64:0, i64:4]); let m = x / i64:3; let f = |k| select i64:-1 {i64:0 if m == i64:0 => i64:1, _ => i64:1}; let m = count(let rec f = |n: i64| -> i64 select n {i64:0 => i64:0, _ => n - f(n - i64:1)}); f(x - i64:1)}
