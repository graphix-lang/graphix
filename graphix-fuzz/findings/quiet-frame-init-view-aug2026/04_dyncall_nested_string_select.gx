// aug20a epoch_refire (ryouko3): the inner scrutinee is a block with a
// nullable-string select feeding `str::len`.
{let x = array::iter([i64:1, i64:40, i64:3, i64:4]); let m = x / i64:3; let rec f = |n| select n {i64:0 => select {let o: [null, string] = "x"; let n = select o {null as _ => "", s => s}; str::len(n)} {i64:0 if m == i64:0 => i64:1, _ => i64:2}, _ => f(n - i64:1)}; f(i64:3)}
