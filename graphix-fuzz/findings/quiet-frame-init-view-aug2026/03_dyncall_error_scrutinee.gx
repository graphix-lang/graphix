// aug20a epoch_refire (ryouko2): the inner scrutinee is a block whose
// lambda call yields an error value; the `_` arm takes it.
{let x = array::iter([i64:1, i64:0, i64:3, i64:4]); let m = x / i64:3; let rec f = |n| select n {i64:0 => select {let f = |n: i64| select n {i64:0 => i64:100, _ => error(f64:0.)}; f(i64:1)} {i64:0 if m == i64:0 => i64:1, _ => i64:2}, _ => f(n - i64:1)}; f(i64:3)}
