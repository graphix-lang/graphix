// aug20a epoch_refire (hz0): the arm body is a block with a shadowing
// inner `let rec` and a `count` over a call — the same first-dispatch
// face through a union-typed result.
{let x = array::iter([i64:1, i64:2, i64:3, i64:4]); let m = x; let rec f = |n| select n {i64:0 => select i64:2 {i64:0 if m == i64:0 => true, _ => {let rec f = |n: i64| -> i64 i64:3; count(f(x))}}, _ => f(i64:0)}; f(i64:3)}
