// The gate must not starve a site the first time it is REACHED.
//
// `a` arrives on a later cycle, so the map's callback runs for the
// first time on a non-init cycle — and its argument is the constant
// "abc", which fired at init and is stale by then. A gate of
// "an argument fired" alone would skip the call and the element would
// bottom, with no cached result to ride.
//
// It does not, because the gate is `any_arg_fired | init_flag()`, and
// `init_flag()` is the EFFECTIVE init: the kernel's init, a
// becoming-selected arm's override, or a callee's first-ever call
// (which forces its init flag). That is what makes a separate
// "have I ever produced" term unnecessary — every first-reach path is
// already an init view.
{
  let a = array::iter([[i64:1, i64:2]]);
  let m = array::map(a, |x| str::len("abc") + x);
  array::len(m)
}
