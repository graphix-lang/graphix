// expect: reject
// A pattern testing a value at a declared variable held rigid (`(null, n)` over
// `('b, i64)`, 'b: Concrete) needs a written test (rigid-pattern-bind-01): with
// none, the test typed nothing and the sibling bind `n` was ⊥ in the instance.
{let step = i64:0; step <- select step {s if s < i64:6 => s + i64:1, _ => never()};
 let g = 'b: Concrete |x: ('b, i64)| select x { (null, n) => n, (_, n) => n + i64:1 };
 let o: [`A(i64), `B(i64), null] = select step % i64:3 { i64:0 => null, i64:1 => `B(step), _ => `A(step) };
 g((o, step))}
