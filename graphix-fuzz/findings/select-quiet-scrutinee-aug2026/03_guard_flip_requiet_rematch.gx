// THE UNIFIED RIDE (Eric's ruling 2026-08-28) — NO re-match, NO flip.
// Historical name: this once tested a guard-flip RE-MATCH against a
// CACHED scrutinee. Under the unified ride a bottom scrutinee HOLDS the
// last selection (arm 1, the `_`, chosen at init when v2 = 0 and g is
// false) and re-runs only THAT arm's guard over bottomed binds — it
// never re-matches the pattern. So when the fold bottoms (v0 = [0] →
// a / a div0) the held `_` arm has no guard, takes unconditionally, and
// its const body fires only at init → quiet. The guard g flipping true
// on in0 = 7 is IRRELEVANT (arm 0 is not the held arm), so there is no
// becoming-selected fire of 100. Trace: [-1]; []; [] in both modes.
// schedule-v1: cap=96 events=768; in0=i64:0; in0=i64:7
{
	let g = false;
	g <- in0 ~ (in0 > 5);
	let v0: Array<i64> = [];
	v0 <- in0 ~ array::push(v0, i64:0);
	let v3: i64 = {
		let v2: u8 = array::fold(v0, u8:0, |a, x| (a / a));
		select v2 { u8:0 if g => i64:100, _ => i64:-1 }
	};
	v3
}
