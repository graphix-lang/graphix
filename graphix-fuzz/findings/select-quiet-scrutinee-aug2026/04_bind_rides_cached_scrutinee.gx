// Pattern binds BOTTOM under THE SELECTION RIDE (Eric's ruling
// 2026-08-27, superseding the aug06ghz0 scrutinee VALUE ride): v2
// delivers 2 once (the fold init on the empty source), selecting
// `n => cast<i64>(n)$ + in0`; every later fold run div0-FIRES-bottoms,
// so the scrutinee is a FRESH bottom while in0 keeps firing. The held
// selection survives, but the scrutinee has no value this cycle, so the
// bind n is a fresh bottom (NOT the cached 2) — `cast(n)` bottoms and
// `$` PROPAGATES the fresh bottom (it rides its resident only on a
// STALE bottom), so the arm bottoms: epochs emit 2, then nothing, then
// nothing. The kernel's `install_arm_binds` derives the scalar bind
// from the real (fresh-bottom) scrutinee disc on the dispatch path — the
// interp bind poison inherits the same fresh/stale, so both agree.
// schedule-v1: cap=96 events=768; in0=i64:0; in0=i64:7
{
	let v0: Array<i64> = [];
	v0 <- in0 ~ array::push(v0, i64:0);
	let v3: i64 = {
		let v2: u8 = array::fold(v0, u8:2, |a, x| (a / (a - a)));
		select v2 { n => (cast<i64>(n)$ + in0) }
	};
	v3
}
