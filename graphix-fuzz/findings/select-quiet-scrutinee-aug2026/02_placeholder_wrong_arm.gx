// SUPERSEDED 2026-08-29 (the bottom-ride deletion): the ride this
// fixture pinned is gone. A bottom scrutinee now BOTTOMS the select on
// both engines (no held-arm ride), so this program agrees by bottoming
// out. The historical description below documents the deleted behavior.
//
// The shape that killed chain-walk gating designs: under a tainted
// scrutinee the PLACEHOLDER (0) matches `u8:0 => -1`, but the
// standing selection is `_` (v2 settled u8:1 via the fold init
// before the div0 epochs). THE UNIFIED RIDE (Eric's ruling
// 2026-08-28) never re-matches at all — it HOLDS the last selection
// by INDEX and jumps straight to the held `_` arm, which emits the
// fresh in0. Any design that walks patterns over the placeholder can't
// reach the right arm here — the hold-index dispatch sidesteps the
// question entirely.
// schedule-v1: cap=96 events=768; in0=i64:0; in0=i64:7
{
	let v0: Array<i64> = [];
	v0 <- in0 ~ array::push(v0, i64:0);
	let v3: i64 = {
		let v2: u8 = array::fold(v0, u8:1, |a, x| (a / (a - a)));
		select v2 { u8:0 => i64:-1, _ => in0 }
	};
	v3
}