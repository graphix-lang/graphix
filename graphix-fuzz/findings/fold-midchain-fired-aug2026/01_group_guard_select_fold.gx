// aug31c divergence_000000 (campaign-minimized): the same class through
// the full pipeline — a guarded select's stream grouped into the fold's
// init. `f(3)` re-emits per consulted-guard fire (1,1,2,2), group emits
// [1,1,2] at cycle 3, the init fire reaches slot 0's `_ => acc` arm
// while the LAST slot (v=MAX, odd) also passes acc... slot 1 (v=2)
// took the constant arm at cycle 0, so on the init re-fire slots 1-3
// re-produce stale and the final carry is stale: interp re-fires the
// standing [0..6] at cycle 3, the kernel swallowed it.
// Interp [0:[0..6] 3:[0..6]]; JIT [0:[0..6]] only.
{let evens: Array<i64> = array::fold([i64:1, i64:2, i64:3, i64:9223372036854775807], {let x = array::iter([i64:1, i64:2, i64:3, i64:4]); let m = x / i64:3; let rec f = |n| select i64:0 {i64:0 if m == i64:0 => i64:1, _ => i64:2}; array::group(f(i64:3), |n, _| n == i64:3)}, |acc, v| select v % i64:2 {i64:0 => [i64:0, i64:1, i64:2, i64:3, i64:4, i64:5, i64:6], _ => acc}); evens}
