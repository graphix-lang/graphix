// Fleet soak dashboard.
//
//   graphix graphix-fuzz/soak-dash.gx        (ctrl-c to quit)
//
// One row per box, then one per work SOURCE under it: how many subjects
// that source has run, what it logged, and the share of the box's CPU it
// drew. That last column is the one the campaign's mix controls, and the
// one worth watching — worker counts are not cores, and three
// equally-provisioned lanes were splitting a box 13/19/66 before anyone
// measured it.
//
// Each box is read by one persistent ssh that tails that box's single
// soak log. There is no collector script any more: the campaign is one
// process writing one log, so there is one thing to read. A box that
// stops answering shows DOWN rather than vanishing, because "no row" and
// "no lanes" are different facts — and a dead ssh is RETRIED, because a
// dropped connection says nothing about the box (a dashboard left open
// overnight showed DOWN forever after one network blip).
//
// The corpus count is a BOX fact, not a lane fact: one deduplicated
// on-disk corpus per campaign, shared by every source. It lives on the
// host row — showing it per lane made one finding light up every lane.
// diverge / crash are per-source and stay on the lane rows.

use tui;
use tui::table;
use tui::block;
use tui::text;

let hosts = ["ryouko", "hz0", "aieka", "katana"];

// Runs on the remote box, fed through `bash -s` on stdin rather than as
// an ssh command line: three of these boxes have fish login shells, and
// a bash script handed to fish dies on syntax rather than on the network
// — which reads as "host unreachable" and costs a night of soaking.
//
// Liveness is reported by the CAMPAIGN, not by this connection. An ssh
// that is up says nothing about a soak that has died: the loop below
// would happily keep re-tailing a log file that stopped growing hours
// ago, and the dashboard showed `up` with frozen counters — the same
// class of lie as the lane count this replaced. So each cycle checks
// the pid the campaign recorded, and the numbers come with a LIVE line
// that contradicts them when the process is gone.
//
// The last counter line of each source is republished every few seconds.
// That reduction belongs here, next to the log, not in the dashboard.
let remote = r#"
while :; do
  # Re-resolve the campaign EVERY cycle. Binding it once at connect time
  # meant a probe kept watching whichever campaign existed when it
  # started: restart the fleet under a new name and the dashboard sat on
  # the old directory reporting DOWN forever, unable to recover without
  # being restarted itself.
  d=$(ls -dt ~/tmp/target/fuzz/*/ 2>/dev/null | head -1)
  if [ -z "$d" ]; then echo "LIVE - no"; sleep 5; continue; fi
  c=$(basename "$d")
  pid=$(cat "$d/state/soak.pid" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then live=yes; else live=no; fi
  echo "LIVE $c $live"
  tail -n 400 "$d/soak.log" 2>/dev/null | awk -v c="$c" '
    / run, / { split($1, a, "…"); last[a[1]] = a[2] " " $3 " " $5 " " $7 " " $10 " " $13 }
    END { for (k in last) print "LANE " c " " k " " last[k] }'
  sleep 5
done
"#;

type Lane = {
  runs: string,
  div: string,
  crash: string,
  corp: string,
  novel: string,
  cpu: string
};

type Box = {
  host: string,
  camp: string,
  lanes: Map<string, Lane>,
  alive: bool
};

// One box: an ssh that reconnects when it dies, and the last line seen
// per source.
let probe = |host: string| -> Box {
  // Respawn the ssh whenever the previous one exits. The exit itself is
  // the trigger, throttled so a fast-failing connection (bad DNS, auth)
  // retries at most every 5s; a host that is genuinely down paces
  // itself on ConnectTimeout anyway.
  let attempt = 0;
  let child = sys::process::spawn(attempt ~ sys::process::options(
    #args: [
      "-o", "BatchMode=yes",
      "-o", "ConnectTimeout=10",
      "-o", "ServerAliveInterval=20",
      "-o", "ServerAliveCountMax=3",
      host, "bash -s"
    ],
    #stdio: sys::process::stdio(#stdin: `Pipe, #stdout: `Pipe, #stderr: `Null),
    #kill_on_drop: true,
    "ssh"
  ))$;
  let sin = select child.stdin { null as _ => never(), s => s };
  let sout = select child.stdout { null as _ => never(), s => s };
  // Close after the write lands, so the remote bash sees EOF and starts.
  let wrote = sys::io::write_exact(sin, buffer::from_string(remote))$;
  sys::io::close(wrote ~ sin)$;
  // `$`, not `?`: one box's stream failing must not take down the
  // dashboard. That box stops producing lines until its ssh exits and
  // the respawn brings a fresh stream.
  let line = sys::io::lines(sout)$;
  let camp = "-";
  let lanes = {};
  let running = false;
  select str::split(#pat: " ", line) {
    [k, c, src, runs, div, crash, corp, novel, cpu] if k == "LANE" => {
      camp <- uniq(c);
      lanes <- map::insert(line ~ lanes, src, {runs, div, crash, corp, novel, cpu});
      null
    },
    [k, c, l] if k == "LIVE" => {
      camp <- uniq(c);
      running <- uniq(l == "yes");
      null
    },
    _ => null
  };
  // The ssh exiting is the connection going away — say DOWN rather than
  // freeze on the last good numbers — and is also the respawn trigger.
  // A fresh child flips it back as soon as the spawn lands.
  // Up means BOTH: this connection is answering AND the campaign it
  // reports on is actually running.
  let connected = false;
  connected <- child ~ true;
  let exited = sys::process::wait(child.proc)$;
  connected <- exited ~ false;
  attempt <- throttle(#rate: duration:5.s, exited ~ (attempt + 1));
  let alive = connected && running;
  { host, camp, lanes, alive }
};

let blank = cell(line(""));

// The box-wide corpus count, read off any lane's republished line (every
// lane carries the same value). "-" until the first lane reports.
let box_corpus = |h: Box| map::fold(h.lanes, "-", |acc, (_, f)| f.corp);

let host_row = |h: Box| {
  let corpus = box_corpus(h);
  row(
    #style: select h.alive {
      false => style(#fg: `Red, #add_modifier: [`Bold]),
      true => select corpus != "0" && corpus != "-" {
        true => style(#fg: `Yellow, #add_modifier: [`Bold]),
        false => style(#fg: `Green)
      }
    },
    [
      cell(line(h.host)),
      cell(line(h.camp)),
      cell(line(select h.alive { true => "up", false => "DOWN" })),
      blank, blank,
      cell(line(corpus)),
      blank
    ]
  )
};

// Colour carries the only thing worth seeing from across the room: a
// source that has logged something of its own.
let lane_row = |src: string, f: Lane| row(
  #style: select f.div != "0" || f.crash != "0" {
    true => style(#fg: `Red, #add_modifier: [`Bold]),
    false => style(#fg: `DarkGray)
  },
  [
    blank,
    cell(line(str::concat("  ", src))),
    cell(line(f.runs)),
    cell(line(f.div)),
    cell(line(f.crash)),
    blank,
    cell(line(f.cpu))
  ]
);

let rows = array::flat_map(array::map(hosts, |h| probe(h)), |h|
  array::push_front(
    map::fold(h.lanes, [], |acc, (src, f)| array::push(acc, lane_row(src, f))),
    host_row(h)
  )
);

let header = row(
  #style: style(#fg: `Black, #bg: `Cyan),
  [
    cell(line("box")),
    cell(line("campaign / source")),
    cell(line("runs")),
    cell(line("diverge")),
    cell(line("crash")),
    cell(line("corpus")),
    cell(line("cpu"))
  ]
);

block(
  #border: &`All,
  #title: &line("graphix soak fleet — ctrl-c to quit"),
  &table(
    #header: &header,
    #widths: &[
      `Length(9), `Length(24), `Length(12),
      `Length(9), `Length(8), `Length(8), `Length(6)
    ],
    &array::map(rows, |r| &r)
  )
)
