// Fleet soak dashboard.
//
//   graphix graphix-fuzz/soak-dash.gx        (ctrl-c to quit)
//
// One row per box, then one per work SOURCE under it: how many subjects
// that source has run, what it logged, and the share of the box's CPU it
// drew. That last column is the one the campaign's mix controls, and the
// one worth watching — worker counts are not cores, and three
// equally-provisioned lanes were splitting a box 13/19/66 before anyone
// measured it.
//
// Each box is read by one persistent ssh that tails that box's single
// soak log. There is no collector script any more: the campaign is one
// process writing one log, so there is one thing to read. A box that
// stops answering shows DOWN rather than vanishing, because "no row" and
// "no lanes" are different facts.

use tui;
use tui::table;
use tui::block;
use tui::text;

let hosts = ["ryouko", "hz0", "hz1", "aieka", "katana"];

// Runs on the remote box, fed through `bash -s` on stdin rather than as
// an ssh command line: three of these boxes have fish login shells, and
// a bash script handed to fish dies on syntax rather than on the network
// — which reads as "host unreachable" and costs a night of soaking.
//
// The last counter line of each source is republished every few seconds.
// That reduction belongs here, next to the log, not in the dashboard.
let remote = r'
d=$(ls -dt ~/tmp/target/fuzz/*/ 2>/dev/null | head -1)
if [ -z "$d" ]; then while :; do echo "LANE - none 0 0 0 0 0 0"; sleep 5; done; fi
c=$(basename "$d")
while :; do
  tail -n 400 "$d/soak.log" 2>/dev/null | awk -v c="$c" \'
    / run, / { split($1, a, "…"); last[a[1]] = a[2] " " $3 " " $5 " " $7 " " $10 " " $13 }
    END { for (k in last) print "LANE " c " " k " " last[k] }\'
  sleep 5
done
';

type Box = {
  host: string,
  camp: string,
  lanes: Map<string, Array<string>>,
  alive: bool
};

// One box: an ssh that stays up, and the last line seen per source.
let probe = |host: string| -> Box {
  let child = sys::process::spawn(sys::process::options(
    #args: [
      "-o", "BatchMode=yes",
      "-o", "ConnectTimeout=10",
      "-o", "ServerAliveInterval=20",
      "-o", "ServerAliveCountMax=3",
      host, "bash -s"
    ],
    #stdio: sys::process::stdio(#stdin: `Pipe, #stdout: `Pipe, #stderr: `Null),
    #kill_on_drop: true,
    "ssh"
  ))$;
  let sin = select child.stdin { null as _ => never(), s => s };
  let sout = select child.stdout { null as _ => never(), s => s };
  // Close after the write lands, so the remote bash sees EOF and starts.
  let wrote = sys::io::write_exact(sin, buffer::from_string(remote))$;
  sys::io::close(wrote ~ sin)$;
  // `$`, not `?`: one box's stream failing must not take down the
  // dashboard. That box stops producing lines, and its ssh exiting
  // flips it to DOWN — which is what the operator needs to see anyway.
  let line = sys::io::lines(sout)$;
  let camp = "-";
  let lanes = {};
  select str::split(#pat: " ", line) {
    [k, c, src, runs, div, crash, corp, novel, cpu] if k == "LANE" => {
      camp <- c;
      lanes <- map::insert(line ~ lanes, src, [runs, div, crash, corp, novel, cpu]);
      null
    },
    _ => null
  };
  // The ssh exiting is the box going away — a dead probe must say so
  // rather than freeze on its last good numbers.
  let alive = true;
  alive <- sys::process::wait(child.proc)$ ~ false;
  { host, camp, lanes, alive }
};

let blank = cell(line(""));

let host_row = |h: Box| row(
  #style: select h.alive {
    true => style(#fg: `Green),
    false => style(#fg: `Red, #add_modifier: [`Bold])
  },
  [
    cell(line(h.host)),
    cell(line(h.camp)),
    cell(line(select h.alive { true => "up", false => "DOWN" })),
    blank, blank, blank, blank
  ]
);

// Colour carries the only thing worth seeing from across the room: a
// source that has logged something.
let lane_row = |src: string, f: Array<string>| row(
  #style: select f[1]$ != "0" || f[2]$ != "0" {
    true => style(#fg: `Red, #add_modifier: [`Bold]),
    false => style(#fg: `DarkGray)
  },
  [
    blank,
    cell(line(str::concat("  ", src))),
    cell(line(f[0]$)),
    cell(line(f[1]$)),
    cell(line(f[2]$)),
    cell(line(f[3]$)),
    cell(line(f[5]$))
  ]
);

let rows = array::flat_map(array::map(hosts, |h| probe(h)), |h|
  array::push_front(
    map::fold(h.lanes, [], |acc, (src, f)| array::push(acc, lane_row(src, f))),
    host_row(h)
  )
);

let header = row(
  #style: style(#fg: `Black, #bg: `Cyan),
  [
    cell(line("box")),
    cell(line("campaign / source")),
    cell(line("runs")),
    cell(line("diverge")),
    cell(line("crash")),
    cell(line("corpus")),
    cell(line("cpu"))
  ]
);

block(
  #border: &`All,
  #title: &line("graphix soak fleet — ctrl-c to quit"),
  &table(
    #header: &header,
    #widths: &[
      `Length(9), `Length(24), `Length(12),
      `Length(9), `Length(8), `Length(8), `Length(6)
    ],
    &array::map(rows, |r| &r)
  )
)
