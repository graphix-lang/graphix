// Title: references under Any sort by cell id, which a forked compile mints in
//   scheduling order: the sorted order differs between serial and parallel
//   runs and from run to run.
// Command:
//   GRAPHIX_PAR=off   graphix --no-cache --no-fusion x-parallel-any-ref-sort-nondeterministic.gx
//   GRAPHIX_PAR=force graphix --no-cache --no-fusion x-parallel-any-ref-sort-nondeterministic.gx
//   GRAPHIX_PAR=auto GRAPHIX_PAR_T=1 graphix --no-cache x-parallel-any-ref-sort-nondeterministic.gx
// Expected: one answer in every mode and every run (serial equivalence).
// Observed: off always [[0], [1], [2], [3], [4], [5], [6], [7]]; force gave
//   [[4], [6], [0], [5], [2], [7], [1], [3]], [[0], [4], [2], [6], [1], [5], [3], [7]], ...
//   (a different order each run); auto with a small threshold gave
//   [[0], [1], [2], [3], [5], [6], [7], [4]] and [[0], [1], [2], [3], [7], [6], [5], [4]]
//   (the first slots probe in order, the rest fork).
sys::exit(sys::time::after_idle(duration:50.ms, 0));
{
  let xs = array::init(8, |i| i);
  let refs: Array<Any> = array::map(xs, |i| { let c = i * 10; &c });
  let sorted = array::sort(refs);
  array::map(sorted, |s| array::filter_map(array::enumerate(refs), |(i, r)| select r == s { true => i, false => null }))
}
