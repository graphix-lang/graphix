// Title: attributes other than #[parallel]/#[serial] silently ignore arguments (c-data-map-04 variant)
// Command: timeout -s KILL 20 graphix --expand x-rerun-2-attr-args-ignored.gx
// Expected: a refusal like "#[pure] takes no arguments", as `#[serial(2)]` gets
//   ("#[serial] takes no arguments here") and `#[parallel(2, 3)]` gets.
// Observed: accepted; --expand and a run print nothing about the stray arguments.
let x = 1;
let f = #[pure(1, 2)] |a| a + 1;
let g = #[sync(fast)] |a| a * 2;
let h = |a| #[native(1)] (a + 1, a + 2);
(f(x), g(x), h(x))
