// Title: #[parallel] over a collection whose slots can never fork (each
//   calls an ordered queuefn wrapper) is accepted; the same calls as tuple
//   fields are refused.
// Command: graphix --expand x-parallel-parallel-assert-ordered-slots.gx
// Expected: refused, "#[parallel] has nothing to run in parallel" (the slots
//   are not independent: update_slots runs them in order, as the fixture
//   lang::functions::ordered_slots_stay_serial pins).
// Observed: exit 0, no error. Replacing the map with
//   `#[parallel] (q(1), q(2), q(3))` is refused as expected.
{
  let clk = sys::time::timer(duration:5.ms, 4);
  let q = queuefn(#trigger: clk, |x: i64| -> i64 x * 2);
  let xs = [1, 2, 3, 4, 5, 6];
  let r = #[parallel] array::map(xs, |x| q(x));
  r
}
