// x-async-io: a not-cancel-safe call kept across a seq abort answers the NEXT
// run's step (CachedArgsAsync has no reborn)
// Run: timeout -s KILL 30 graphix --no-cache x-async-io-seq-abort-kept-reply.gx
// Run 1 (want=100) is aborted at n=2 while its read waits; "one" arrives at 300ms.
// Run 2 (want=1) starts at n=5.
// Expected: run 2 answers at most 1 byte, (1, 1) (or nothing until its own read lands).
// Observed: `n=5 r=(1, 3)` at once: run 2 completes with run 1's 3-byte reply.
use sys::process::{spawn, options, stdio};
use sys::io::Read;
let child = spawn(options(
  #args: ["-c", "sleep 0.3; printf one; sleep 0.4; printf two; sleep 2"],
  #stdio: stdio(#stdout: `Pipe),
  #kill_on_drop: true,
  "sh"
))$;
let out = child.stdout$;
let clk = sys::time::timer(duration:100.ms, 9);
let n = 0;
n <- clk ~ n + 1;
let go = select n { 1 => u64:100, 5 => u64:1, _ => never() };
let stop = select n { 2 => n, _ => never() };
let r = seq let want = go; abort(stop) { let b = Read::read(out, want); (want, buffer::len(b$)) };
println("n=[n] r=[r]");
sys::exit(sys::time::after_idle(duration:300.ms, clk ~ 0));
r
