// seq_steps::entry_reraises_an_earlier_fire cannot fail if the machine's
// catch-up re-raise is removed: an outer variable a step reads is sampled by
// the step's entry snapshot (`any(pc, once((pc, click))) ~! (pc, click)`), so
// `click ~ 7` fires at EVERY entry whether or not click fired. Here click
// fires once, before run 1; run 2 has no fire of click to re-raise, yet it
// still answers 7.
// Run: timeout -s KILL 30 graphix --no-cache tests-seq-entry-reraise-vacuous.gx
// Observed: (1, 7) then (2, 7)  -- the 7 needs no fire of click
let click = never();
click <- sys::time::after_idle(duration:20.ms, 1);
let go = count(sys::time::timer(duration:200.ms, 2)$);
let r = seq go { sys::time::after_idle(duration:60.ms, 0); let r = click ~ 7; (go, r) };
sys::exit(sys::time::after_idle(duration:600.ms, 0));
r
