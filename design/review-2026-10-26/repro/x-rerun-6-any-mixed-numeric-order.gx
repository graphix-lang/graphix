// Title: tests-types-04 variant: under Any, mixed numerics still order by numeric class
// Command: timeout -s KILL 15 graphix --no-cache x-rerun-6-any-mixed-numeric-order.gx
// Expected: [0.5, 1, 2.5, 3] (the numbers in order), or the sort refused as
//   Array<[i64, f64]> now is ("values of two numeric types have no order between them")
// Observed: [1, 3, 0.5, 2.5]: every i64 sorts below every f64. Same with
//   `let a: Any = i64:3; let b: Any = f64:2.5;` where `a < b` is true and min(a, b) is 3.
let xs: Result<Array<Any>, [`JsonErr(string), `InvalidCast(string)]> = json::read(r"[3, 2.5, 1, 0.5]");
sys::exit(sys::time::after_idle(duration:100.ms, 0));
array::sort(xs$)
