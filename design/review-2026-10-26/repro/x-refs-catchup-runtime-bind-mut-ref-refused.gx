// `&mut y` of a local whose initializer is an operator (or any call) is refused
// when its function is bound at run time (a collection callback, a dynamic call):
// "binding the callee failed: ... &mut y: y was made generic by an earlier
// compile". The check passes; a static call of the same function runs.
// CompileCtx::generalized_earlier sees a GENERIC-level cell in y's type (the
// operator's result cell, which the definition's check bound to i64).
// command: timeout -s KILL 10 graphix --no-cache x-refs-catchup-runtime-bind-mut-ref-refused.gx
// expected: [1, 2] then [100, 100]   (as with `let y = i` in place of `i + 1`,
//           or `y <- i ~ 100` in place of the reference)
// observed: two "f(collection_element): binding the callee failed: ... &mut y: y was
//           made generic by an earlier compile, and a writable reference to it would
//           let a write narrow it: write it with <-" lines and no value
//           (jit, --no-fusion, cold and warm image alike; --check passes)
let rs = array::map([0, 1], |i: i64| {
  let y = i + 1;
  let r = &mut y;
  *r <- i ~ 100;
  y
});
sys::exit(sys::time::after_idle(duration:100.ms, 0));
rs
