// c-bind-10: Deref delivers a moved place's new element STALE, so a reader
// of a moving reference that did not fire sees the new element while every
// node downstream of it rides the old one.
//
// command: graphix --no-cache design/review-2026-10-05/repro/c-bind-10.gx
//   (the same output with --no-fusion, with the image cache cold or warm,
//   and with GRAPHIX_PAR=force)
//
// `cur` holds the cell of `&vals[focus]`, sampled at 0.02s. At 0.05s focus
// moves to 2: the ByRef re-registers the cell's place and publishes the
// cell, but `cur` does not fire and no reader is scheduled (the Deref refs
// only the root `vals`, bind.rs:1403). At 0.08s `tick` fires; each `*cur`
// reads through the moved path (Deref::address returns moved=false for a
// path change, bind.rs:1394-1398) and delivers 30 under vals' STALE tag
// (bind.rs:1466-1469), so `*cur * 1` and the select ride the old element.
//
// expected (design/place_references.md: a moving reference re-fires its
// readers when the key moves; R1 in design/dense_delivery.md: Stale implies
// the payload is unchanged). Every line agrees with itself, and the move
// re-fires the readers, as a sampled plain reference does (`once(&x)`
// re-fires `*r` when x changes):
//   (0, 10, 10, "ten")
//   (0, 10, 10, "ten")
//   (0, 30, 30, "other")
//   (1, 30, 30, "other")
// observed (nothing at the move):
//   (0, 10, 10, "ten")
//   (0, 10, 10, "ten")
//   (1, 30, 10, "ten")
//
// The same through once: `let r = once(&a[i]); let r0 = &a[i]` over
// a = [1, 2, 3], i moved 0 -> 2, prints (*r, *r + 0, *r0) = (3, 1, 3).
let vals = [10, 20, 30];
let focus = 0;
let cur = &vals[0];
cur <- sys::time::timer(duration:0.02s, false) ~ &vals[focus];
focus <- sys::time::timer(duration:0.05s, false) ~ 2;
let tick = 0;
tick <- sys::time::timer(duration:0.08s, false) ~ 1;
sys::exit(sys::time::after_idle(duration:300.ms, 0));
(tick, *cur, *cur * 1, select *cur { 10 => "ten", _ => "other" })
