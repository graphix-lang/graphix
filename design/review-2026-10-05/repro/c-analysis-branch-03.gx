// c-analysis-branch-03: fields, arguments, operands and slots fork with no
// independence check.
//
// Only a block's runs consult analysis::plan_block (node/mod.rs:689). gather
// (node/mod.rs:417: struct, tuple, variant, array and list fields, string
// interpolation), update_args (node/callsite.rs:2387), binary operands
// (node/op.rs:179, join2) and MapQ slots (node/collection.rs:867) fork
// whenever the cost model, #[parallel] or GRAPHIX_PAR=force says. A sibling
// that reads through a reference a let an earlier sibling publishes this
// cycle (`*r` after `r <- &v`) reads last cycle's value, and two siblings
// calling one ORDERED queuefn wrapper race for its pop slot.
//
// command: timeout -s KILL 10 graphix --no-cache --no-fusion design/review-2026-10-05/repro/c-analysis-branch-03.gx
//   (default env: Auto, plus the #[parallel] attributes below; it never
//   exits, the timeout ends it)
//   GRAPHIX_PAR=off with the same command prints the expected output.
//   graphix-fuzz check design/review-2026-10-05/repro/c-analysis-branch-03.gx:
//   DIVERGENCE - parallel evaluation bug (forked node-walk != serial node-walk)
//   GRAPHIX_PAR_AUDIT=1 GRAPHIX_PAR=force on the `fields` line alone panics:
//   "a forked branch read BindId(..), which its left sibling published in the
//   same cycle"
//
// expected (GRAPHIX_PAR=off, the serial node-walk):
//   ((0, 0, 0), 0, 0, [0, 0], 0)
//   ((1, 10, 10), 20, 20, [10, 10], 1)
//   ((2, 20, 20), 40, 40, [20, 20], 1)
//   ((3, 30, 30), 60, 60, [30, 30], 1)
// observed (HEAD c722befe, debug build, default env, --no-fusion):
//   ((0, 0, 0), 0, 0, [0, 0], 0)
//   ((1, 10, 0), 10, 10, [10, 0], 2)
//   ((2, 20, 10), 30, 20, [20, 10], 2)
//   ((3, 30, 20), 50, 30, [30, 20], 2)
//   With fusion on the same, except `args` is right (20, 40, 60): the call
//   fuses and a kernel updates its feeders in order.
//
// No attribute is needed in plain Auto once both siblings cost enough to
// fork. This program (default env, fusion on) prints `false` from its third
// cycle on; with GRAPHIX_PAR=off every line is `true`:
//   let tick = sys::time::timer(duration:20.ms, true);
//   let n = 0;
//   n <- tick ~ (n + 1);
//   let zero = 0;
//   let zr = &zero;
//   let big = array::init(4000, |i| i);
//   let heavy = |x: i64| array::fold(big, x, |a, e| a + e - e + *zr);
//   let holder = 0;
//   let r = &holder;
//   let out = ({ let v = heavy(n) * 10; r <- &v; v }, heavy(n) + *r);
//   sys::exit(select n == 30 { true => 0, false => never() });
//   select out { (a, b) => (n, a, b, b == a + n) }
let n = 0;
n <- select n < 3 { true => n + 1, false => never() };
let h = 0;
let r1 = &h;
let r2 = &h;
let r3 = &h;
let r4 = &h;
let add = |a: i64, b: i64| a + b;
let fields = #[parallel] (n, { let v = n * 10; r1 <- &v; v }, *r1);
let operands = #[parallel] ({ let v = n * 10; r2 <- &v; v } + *r2);
let args = #[parallel] add({ let v = n * 10; r3 <- &v; v }, *r3);
let slots = #[parallel] array::map([0, 1], |i: i64| select i {
  0 => { let v = n * 10; r4 <- &v; v },
  _ => *r4
});
let qf = queuefn(#trigger: never(), |x: i64| -> i64 x);
let slow = |x: i64| array::fold(array::init(3000, |i| i), x, |a, e| a + e - e);
let q = 0;
let queued = #[parallel] ({ q <- qf(slow(1)); 1 }, { q <- qf(2); 2 });
(fields, operands, args, slots, q)
