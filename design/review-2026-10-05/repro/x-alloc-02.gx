// x-alloc-02: under Auto, a wide run of quiet statements forks on every
// cycle and burns several times the CPU of the serial walk.
//
// Block::update_forking (graphix-compiler/src/node/mod.rs:687) gives each
// run of independent statements a ForkSite. Meter::time (cost.rs:297) times
// every measured update whether or not anything fired, so a run whose quiet
// walk (every statement riding) reaches 2T turns Measured, and plan_auto
// (cost.rs:248) then forks every update that is not a sample. Once
// Measured, a run of 256 or more statements cannot turn Serial again: each
// child's estimate is at least floor(0) = 2^shift (T/128 to T/64), so the
// sum reaches 2T and `pays` (cost.rs:338) holds whatever they cost.
//
// The 1000 `let a<i>` statements below form one run; none of them fires
// after the first cycle (`b` is never written). A 100us timer drives about
// 3000 cycles.
//
// command (from the repo root; compare user+sys, e.g. with /usr/bin/time):
//   GRAPHIX_PAR=off graphix --no-cache design/review-2026-10-05/repro/x-alloc-02.gx
//   GRAPHIX_DBG_PAR=1 graphix --no-cache design/review-2026-10-05/repro/x-alloc-02.gx
//
// expected: Auto costs about what off does; there is nothing to fork.
//
// observed (HEAD c722befe, debug build, 16 cores; both print 2999 and exit):
//   off:  wall 4.0 s, user+sys 2.7-2.8 s (startup alone, 10 cycles: 1.4 s)
//   Auto: wall 4.0 s, user+sys 14.0-14.3 s (T = 150152, 264192)
//   about 0.45 ms of CPU per cycle serial against 4.2 ms under Auto.
let clock = sys::time::timer(duration:100.us, true);
let n = 0;
n <- clock ~ n + 1;
let b = "a";
b <- select n { k if k < 0 => "[k]", _ => never() };
let a0 = str::len(str::concat(b, "0"));
let a1 = str::len(str::concat(b, "1"));
let a2 = str::len(str::concat(b, "2"));
let a3 = str::len(str::concat(b, "3"));
let a4 = str::len(str::concat(b, "4"));
let a5 = str::len(str::concat(b, "5"));
let a6 = str::len(str::concat(b, "6"));
let a7 = str::len(str::concat(b, "7"));
let a8 = str::len(str::concat(b, "8"));
