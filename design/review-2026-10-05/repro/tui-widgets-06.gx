// tui-widgets-06: calendar: dates at time's range edge panic in ratatui;
// out-of-range years silently become 1970.
//
// command (a terminal is needed; this one gives it a pty of known size):
//   script -qec "stty rows 12 cols 40; timeout -s KILL 10 graphix --no-cache \
//     design/review-2026-10-05/repro/tui-widgets-06.gx" /dev/null
// or run `graphix --no-cache design/review-2026-10-05/repro/tui-widgets-06.gx`
// in a terminal and watch.
//
// expected: a June 20000 calendar, or a clamped date with a "coerced" warning
// (as date(2024, 13, 15) gets); then a December 9999 calendar.
//
// observed (HEAD c722befe, debug build): the header reads "January 1970" and
// nothing is logged (RUST_LOG=warn --log-dir writes no file). Three seconds
// later the display task panics:
//   ratatui-widgets-0.3.0/src/calendar.rs:223:17: overflow adding duration to date
// The process stays alive with no display and Ctrl-C does not end it, since
// the stop signal is never fired. date(-9999, 1, 15) panics the same way at
// calendar.rs:208:28 ("overflow subtracting duration from date").
use tui::{style, calendar::{calendar, date}};

let d = date(20000, 6, 15);

d <- sys::time::timer(duration:3.s, false) ~ date(9999, 12, 15);

calendar(#show_month: &style(#fg: `Yellow), &d)
