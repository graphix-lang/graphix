// gx-ui-14: tui browser: back from an empty listing, a table keeps the old
// listing's column for up to a second, and #selected_path names a path that
// does not exist.
//
// browser.gx:56 is `get_width = |i| { catch(e) never(e); any(content_widths[i]?, i ~ 0) }`.
// When content_widths fires without i, and i is past its end, the `?` raises
// (a fresh bottom) and `i ~ 0` is silent, so the any is bottom. An empty
// listing (here: the leaf /t/r1/c1) makes content_widths [] (line 112), so
// get_width(0) and name_width (line 59) go bottom and the column fold
// (lines 61-78) keeps the leaf's columns (["Value"]). Back on /t the mode is
// `Table at once, but the fold stays bottom until the 1 s throttle on
// content_widths (line 112) passes widths with an entry at index 0: the
// header shows Value and line 84 writes "/t/r1/Value".
// Line 67 (`any(content_widths ~ candidates, candidates)`) exists to make
// `i ~ 0` fire in the fold's slots; it does not reach get_width(0).
//
// command: env -u WAYLAND_DISPLAY -u DISPLAY graphix --no-cache design/review-2026-10-05/repro/gx-ui-14.gx
//          (the same with --no-fusion)
//
// expected: at t=2100ms header ["Name", "c1", "c2"] and selected_path
//   /t/r1/c1 (what a local copy of browser.gx prints with
//   `get_width = |i| select content_widths[i] { error as _ => 0, w => w }`,
//   with or without line 67)
// observed (HEAD c722befe, debug build, both engines):
//   t=2100ms path /t
//   t=2100ms   header ["Name", "Value"]
//   t=2100ms   selected_path /t/r1/Value
//   t=2100ms   selected_path /t/r1/Value
//   t=2900ms   header ["Name", "c1", "c2"]
//   t=2900ms   selected_path /t/r1/c1
use tui::{Tui, browser::browser};
use sys::net;
let pubs = array::map([1, 2, 3], |r| array::map([1, 2], |c| net::publish("/t/r[r]/c[c]", r * 10 + c)));
let path = "/t";
let sp: string = never();
let sr: string = never();
let ui: Tui = browser(#size: {width: 80, height: 10}, #selected_path: &sp, #selected_row: &sr, path);
let hdr = select ui { `Table(t) => array::map((*t.header)$.cells, |c| c.content.spans), _ => never() };
let i = 0;
i <- sys::time::timer(duration: 100.ms, 40) ~ i + 1;
path <- select i { 10 => "/t/r1/c1", 21 => "/t", _ => never() };
println("t=[path ~ i]00ms path [path]");
println("t=[hdr ~ i]00ms   header [hdr]");
println("t=[sp ~ i]00ms   selected_path [sp]");
sys::exit(sys::time::timer(duration: 3.5s, false) ~ 0)
