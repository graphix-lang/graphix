// small-pkgs-05: JSON/TOML writers silently merge map keys that print the same
// run: graphix --no-cache design/review-2026-10-12/repro/small-pkgs-05.gx
// expected: an error from each writer (or two distinct keys); map::len is 2
// observed: ("{\"1\":20}", "1 = 20\n", "{\"1\":4}", 2, 2)
let m: Map<[i64, string], i64> = {1 => 10, "1" => 20};
let n: Map<[i64, f64], i64> = {1 => 3, 1.0 => 4};
sys::exit(sys::time::after_idle(duration:100.ms, 0));
(json::write_str(m), toml::write_str(m), json::write_str(n), map::len(m), map::len(n))
