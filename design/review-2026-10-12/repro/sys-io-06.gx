// sys-io-06: tls::connect behind a Lines reader on the same TCP stream never starts
// (STARTTLS after reading the greeting with Lines::lines is impossible).
// command: timeout -s KILL 30 graphix --no-cache design/review-2026-10-12/repro/sys-io-06.gx
// expected: "client line: STARTTLS", then "server saw N handshake bytes" (the ClientHello)
//   and "tls answered", as when `Lines::lines(client)` is replaced by `Read::read(client, u64:9)`
//   (that variant prints "server saw 1460 handshake bytes").
// observed: only "client line: STARTTLS". `Halves::take` waits forever for the read half the
//   line reader holds across its pending read. With the exit timer at 150.s (past the 120 s
//   TLS_HANDSHAKE_TIMEOUT) the output is the same: the wait is outside the handshake timeout.
use sys::io::{Read, Write, Lines};
let listener = sys::tcp::listen("127.0.0.1:0")$;
let addr = sys::tcp::listener_addr(listener)$;
let client = sys::tcp::connect(listener ~ addr)$;
let server = sys::tcp::accept(listener, client)$;
let greeted = Write::write_exact(server, buffer::from_string("STARTTLS\n"))$;
let line = Lines::lines(client)$;
println("client line: [line]");
let tls = sys::tls::connect(#ca_cert: null, "localhost", line ~ client);
println(tls ~ "tls answered");
let hello = Read::read(greeted ~ server, u64:4096)$;
let r = select hello { b => "server saw [buffer::len(b)] handshake bytes" };
sys::exit(sys::time::timer(duration:3.s, false) ~ 0);
r
