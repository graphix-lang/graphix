// tests-lang-rest-b-05: a fused loop whose result is bottom (one slot is
// bottom) is re-invoked, and re-runs every slot, on every cycle of the
// program, though none of its inputs fired (fusion/kernel.rs: the wrapper
// invokes whenever its resident is bottom). Here an unrelated counter
// ticks 100 times: ~3.3 s in the debug build, vs ~0.2 s for the same
// loop with `|x| x * 10` (a non-bottom result is not re-invoked). GRAPHIX_DBG_INVOKE=1 shows the
// loop's region invoked 100 times with fired=[false].
// Run: GRAPHIX_PAR=off graphix --no-cache tests-lang-rest-b-05.gx
let n = 0;
let src = array::init(300000, |i| i);
n <- select n { k if k < 100 => k + 1, _ => never() };
let out = array::map(src, |x| {
    let r: [i64, Error<`Bad(i64)>] = select x % 3 { 0 => error(`Bad(x)), _ => x };
    r$ * 10
});
sys::exit(select n { 100 => 0, _ => never() });
array::len(out)
