// design/activation_state.md Ruling 1: bottom in, bottom out; only `hold`
// rides over a bottom. At c = 2 x is bottom: `x + 0`, `uniq(x)` and every
// CachedArgs builtin print nothing for that cycle, but take/skip/count/
// once/filter/filter_err/throttle/queue re-surface their old value and
// the tuple prints (2, ..).
// run: graphix --no-cache prog.gx   (swap `r` for each builtin below)
// expect: (0, 0) (1, 1) (3, 3) (4, 4)   got: (0, 0) (1, 1) (2, 1) (3, 3) (4, 4)
let c = 0;
c <- select c { n if n < 4 => n + 1, _ => never() };
let x = select c { 2 => never(), n => n };
let r = take(#n: 5, x);
let r_skip = skip(#n: 0, x);
let r_count = count(x);
let r_filter = filter(x, |v| v >= 0);
let r_uniq = uniq(x);
sys::exit(sys::time::after_idle(duration:200.ms, 0));
(c, r)
