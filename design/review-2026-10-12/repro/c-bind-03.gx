let clock = sys::time::timer(duration:50.ms, true);
let n = 0;
n <- clock ~ n + 1;
let src: [Array<i64>, null] = [1, 2];
src <- select n { 3 => null, 5 => [1, 2], _ => never() };
sys::exit(select n { 8 => 0, _ => never() });
let out = array::map(src$, |x| {
  let k = 0;
  k <- clock ~ k + x;
  k
});
(n, out)
