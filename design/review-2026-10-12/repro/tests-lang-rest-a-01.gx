// tests-lang-rest-a-01: a struct with ErrChain's field names is typed as
// a chain (field types kept) but delivered rewritten (cause/ori/pos replaced).
// cmd: graphix --check tests-lang-rest-a-01.gx  -> exit 0 (accepted)
// cmd: graphix --no-cache tests-lang-rest-a-01.gx
// expected: refused, or r = 7 (pos 4 read as the user's i64 field)
// observed: panic at fusion/kernel.rs "kernel param `x`: runtime
//   Array([[column, 5], [line, 5]]) does not match the compiled Scalar(I64)
//   slot", then "Error: runtime did not respond"
// --no-fusion: the i64 binding r holds an array of error values
let f = |x: i64| x * 2 + 1;
let r: i64 = never();
let shape = {
    catch(e) r <- f((e.0).pos) + f((e.0).cause);
    error({cause: 1, error: 20, ori: 3, pos: 4})?
};
sys::exit(sys::time::after_idle(duration:200.ms, 0));
r
