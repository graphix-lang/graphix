// x-parallel-02: `*r <- v` through a held moving reference writes the old place
// while `*r` reads the new one.
// command: graphix --no-cache design/review-2026-10-12/repro/x-parallel-02.gx
//   (same with --no-fusion; graphix-fuzz check says EXCLUDED, both engines agree)
// expected last line: (2, 99, [10, 20, 99, 40])
// observed: (0, 10, [10, 20, 30, 40]) (2, 30, [10, 20, 30, 40]) (2, 30, [99, 20, 30, 40])
let a = [10, 20, 30, 40];
let i = 0;
let step = array::iter([1, 2, 3, 4]);
i <- select step { 2 => 2, _ => never() };
let held = once(&mut a[i]);
*held <- select step { 4 => 99, _ => never() };
sys::exit(sys::time::after_idle(duration:100.ms, 0));
(i, *held, a)
