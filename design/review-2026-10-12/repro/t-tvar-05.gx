let f = |h: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: fn(x: i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64) -> i64| 0;
f
