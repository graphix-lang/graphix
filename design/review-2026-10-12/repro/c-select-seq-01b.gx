// c-select-seq-01b: the guard below a `0 =>` arm divides by the value that arm claimed.
// The node-walk logs "attempt to divide by zero" every time x == 0. Expected: no log.
// Run: graphix --no-cache --no-fusion c-select-seq-01b.gx
let step = 0;
step <- select step { n if n < 4 => n + 1, _ => never() };
let x = step % 2;
let f = |x: i64| select x { 0 => "zero", n if 10 / n > 5 => "small", _ => "big" };
sys::exit(sys::time::after_idle(duration:100.ms, select step { 4 => 0, _ => never() }));
(x, f(x), select x { 0 => "zero", n if 10 / n > 5 => "small", _ => "big" })
