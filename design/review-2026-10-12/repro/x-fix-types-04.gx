// x-fix-types-04: a writer in a lambda with an unannotated parameter escapes the value restriction
// command: graphix --check x-fix-types-04.gx; graphix --no-cache x-fix-types-04.gx; graphix-fuzz run (comments stripped)
// expected: refused at the check: f is a <- target, so f("s") fixes its one instance at
// fn(x: string) -> string and set(|x: i64| x + 1) cannot write it
// observed: --check exit 0; the run prints 1 and nothing else; graphix-fuzz run logs, in every mode,
// ERROR callsite f("s"): binding the callee failed: a run-time bind at f("s") did not type:
// an instance at fn(x: string) -> string of a definition typed fn(x: i64) -> '_N
// (set declared before the use of f escapes the same way; with g annotated fn(x: i64) -> i64 the
// write is refused as "made generic by an earlier compile", while the top-level
// f <- |x: i64| x + 1 before f(1) is accepted)
let f = |x| x;
let a = f("s");
let set = |g| f <- g;
set(|x: i64| x + 1);
sys::exit(sys::time::after_idle(duration:100.ms, 0));
str::len(a)
