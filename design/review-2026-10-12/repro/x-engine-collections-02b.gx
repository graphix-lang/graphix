// schedule-v1: cap=64 events=512; in0=i64:3; in0=i64:-1; in1=i64:7; in0=i64:4; in0=i64:-1; in0=i64:2; in1=i64:1
let unused = 0;
// x-engine-collections-02 control: the select arm catches in1's fire up at
// its wake: epoch 4 = [4] on both engines.
select in0 { n if n >= 0 => [in1 ~ n], _ => never() }
