// f-jit-02: one fuse_each joins all 400 regions into a single link batch;
// when that batch exceeds the arena, the retry in a fresh generation fails too
// and the link panics. See f-jit-02.sh.
let x = sys::time::after_idle(duration:1.ms, 3);
let rec fact = |n: i64| select n { 0 => 1, n => n * fact(n - 1) };
let sq = |a: Array<i64>| array::map(a, |v| fact(v) + 1);
