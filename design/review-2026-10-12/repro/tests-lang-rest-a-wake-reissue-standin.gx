let path = "/etc/hostname";
let on = true;
let r = select on { true => path, false => never() };
let n = 0;
n <- r ~ n + 1;
let t = 0;
t <- select on {
    false => select t { x if x < 3 => x + 1, _ => never() },
    true => never()
};
on <- select n { 1 => false, _ => never() };
on <- select t { 3 => true, _ => never() };
sys::exit(sys::time::after_idle(duration:300.ms, 0));
n
