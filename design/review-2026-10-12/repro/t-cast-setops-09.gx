// t-cast-setops-09: decide_once drops provisional verdicts, so a cycle of typedefs
// that each name the next twice costs 2^n in every walk that uses it (here holds_abstract
// under string interpolation)
// command: graphix --no-cache t-cast-setops-09.gx
// expected: prints v=null at once, as it does when each typedef names the next once
// observed (debug build): n=12 0.19 s, n=16 0.32 s, n=20 1.9 s, n=22 8.6 s; the
// one-reference control at n=20 takes 0.19 s
type T0 = [null, (T1, T1)];
type T1 = [null, (T2, T2)];
type T2 = [null, (T3, T3)];
type T3 = [null, (T4, T4)];
type T4 = [null, (T5, T5)];
type T5 = [null, (T6, T6)];
type T6 = [null, (T7, T7)];
type T7 = [null, (T8, T8)];
type T8 = [null, (T9, T9)];
type T9 = [null, (T10, T10)];
type T10 = [null, (T11, T11)];
type T11 = [null, (T12, T12)];
type T12 = [null, (T13, T13)];
type T13 = [null, (T14, T14)];
type T14 = [null, (T15, T15)];
type T15 = [null, (T16, T16)];
type T16 = [null, (T17, T17)];
type T17 = [null, (T18, T18)];
type T18 = [null, (T19, T19)];
type T19 = [null, (T0, T0)];
let v: T0 = null;
sys::exit(sys::time::after_idle(duration:10.ms, 0));
println("v=[v]");
0
