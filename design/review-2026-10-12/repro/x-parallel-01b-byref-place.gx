// x-parallel-01b: the place form, under the default mode with #[parallel]:
//   GRAPHIX_PAR=off  -> -1 20 30 40 10 ...   GRAPHIX_PAR=auto -> -1 10 20 30 40 ... (old path)
let a = [10, 20, 30, 40];
let i = array::iter([0, 1, 2, 3, 0, 1, 2, 3]);
let held: [&i64, null] = null;
let t = #[parallel] (&a[i], select held { null as _ => -1, r => *r });
held <- t.0;
t.1
