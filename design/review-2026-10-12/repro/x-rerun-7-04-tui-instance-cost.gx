// x-rerun-7-04: each instance of a tui package function (barchart::bar,
// table::cell) costs ~1-2 ms of InstanceCheck in a debug build, ~20x a
// copy of the same function in a user module (x-rerun-7-04-local/), and
// GRAPHIX_PAR=auto is ~2.5x slower than off on it.
// command: time GRAPHIX_PAR=off graphix --no-cache <this file>   (~1.5 s; local copy ~0.3 s)
//          GRAPHIX_PROFILE=1 ... | grep phase=InstanceCheck
// tui-widgets-05's 32768-bar program no longer draws within its 10 s.
use tui::barchart::bar;
let a = array::init(1024, |i| bar(&(i % 10)));
sys::exit(sys::time::after_idle(duration:10.ms, a ~ 0));
0
