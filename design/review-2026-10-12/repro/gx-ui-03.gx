// gx-ui-03: browser's selected_row/selected_path report rows of the previous path,
// and an empty listing never clears them.
// run: timeout -s KILL 60 graphix --no-cache gx-ui-03.gx   (same output with --no-fusion)
// expected: after the move to /gxuiB at n=7, sel goes from /gxuiA/a2 straight to
//   /gxuiB/b0; after the move to the leaf /gxuiA/a3 at n=10 (an empty listing),
//   sel no longer names a row of /gxuiB.
// observed: "n=7 path=/gxuiB sel=/gxuiA/a0" (row 0 of the OLD listing, a row never
//   chosen) before "sel=/gxuiB/b0"; then "path=/gxuiA/a3 sel=/gxuiB/b0" through n=13.
use tui::browser::{MoveCursor, browser};
let pa = array::map([0, 1, 2, 3], |i| sys::net::publish("/gxuiA/a[i]", i));
let pb = array::map([0, 1, 2, 3], |i| sys::net::publish("/gxuiB/b[i]", i));
let clock = sys::time::timer(duration:400.ms, true);
let n = 0;
n <- clock ~ n + 1;
let cursor: MoveCursor = never();
cursor <- select n { k if k > 2 && k < 5 => n ~ `Down(1), _ => never() };
let path = "/gxuiA";
path <- select n { 7 => n ~ "/gxuiB", 10 => n ~ "/gxuiA/a3", _ => never() };
let sel: string = "";
let w = browser(#cursor: cursor, #selected_row: &mut sel, #size: {width: 80, height: 8}, path);
sys::exit(select n { k if k > 13 => n ~ 0, _ => never() });
"n=[n] path=[path] sel=[sel]"
