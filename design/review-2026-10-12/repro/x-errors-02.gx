// x-errors-02: an undefined trait bound in a definition is reported at its first call
// command: graphix --check design/review-2026-10-12/repro/x-errors-02.gx
// expected: the error sited at the definition, as without the call
// (0: at: line: 11, column: 9 .. in: 'a: Nosuch |x: 'a| x)
// observed: 0: at: line: 12, column: 1 .. in: f(1)
// 1: undefined type Nosuch at line: 11, column: 13
// Across modules (helper.gx: let f = 'a: Nosuch |x: 'a| x; main.gx: mod helper;
// let a = 1; helper::f(a)) `graphix lsp` publishes the error on main.gx 2:0-2:12
// (the call) and nothing on helper.gx; a plain `|x: Nosuch|` is sited at the def.
let q = 1;
let f = 'a: Nosuch |x: 'a| x;
f(1)
