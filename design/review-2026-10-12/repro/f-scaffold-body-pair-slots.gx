// GRAPHIX_DUMP_CLIF=1 graphix --no-cache f-scaffold-body-pair-slots.gx | grep -c explicit_slot
// prints 38: every helper call with a pair argument or a pair return carves its own
// 16-byte stack slot (lower.rs HelperRefs::call), so the self-recursive kernel `f`
// carries ~600 bytes of single-use slots in every activation's frame.
sys::exit(sys::time::after_idle(duration:100.ms, 0));
let rec f = |n: i64, a: Array<i64>| -> i64 select n { 0 => 0, n => {
  let b = [a[0]$, a[1]$, a[2]$, a[3]$, a[4]$, a[5]$, a[6]$, a[7]$];
  let c = [a[0]$, a[1]$, a[2]$, a[3]$, a[4]$, a[5]$, a[6]$, a[7]$];
  f(n - 1, a) + b[0]$ + c[1]$ + 1 } };
f(array::iter([3, 4]), [1, 2, 3, 4, 5, 6, 7, 8])
