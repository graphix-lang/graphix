// f-mod-lowering-02: unfolds_past, fusion's size guard, is exponential over a
// shared variant payload. norm_key has no key for Type::Variant (nor TVar,
// Ref), so unfolds_past's memo never hits and each level walks its shared
// payload twice; TypeMemo::cached runs it before its memo lookup, and
// freeze_region_return runs it for every region root.
//
// command: graphix --no-cache design/review-2026-10-12/repro/f-mod-lowering-02.gx
// expected: prints 1 in well under a second, as --no-fusion does (~0.3 s).
// observed (HEAD 7324207f, debug build): 22 levels 0.54 s, 24 levels 1.26 s,
//   26 levels 2.2 s, 28 levels (this file) 9-14 s, 30 levels 44 s; with
//   --no-fusion 0.3 s at every size. GRAPHIX_PROFILE=1 puts the time in
//   Phase::ReturnType. The same chain over tuples `(x, x)` takes 0.3 s at 30.
let x0 = 1;
let x1 = `A(x0, x0);
let x2 = `A(x1, x1);
let x3 = `A(x2, x2);
let x4 = `A(x3, x3);
let x5 = `A(x4, x4);
let x6 = `A(x5, x5);
let x7 = `A(x6, x6);
let x8 = `A(x7, x7);
let x9 = `A(x8, x8);
let x10 = `A(x9, x9);
let x11 = `A(x10, x10);
let x12 = `A(x11, x11);
let x13 = `A(x12, x12);
let x14 = `A(x13, x13);
let x15 = `A(x14, x14);
let x16 = `A(x15, x15);
let x17 = `A(x16, x16);
let x18 = `A(x17, x17);
let x19 = `A(x18, x18);
let x20 = `A(x19, x19);
let x21 = `A(x20, x20);
let x22 = `A(x21, x21);
let x23 = `A(x22, x22);
let x24 = `A(x23, x23);
let x25 = `A(x24, x24);
let x26 = `A(x25, x25);
let x27 = `A(x26, x26);
let x28 = `A(x27, x27);
sys::exit(sys::time::after_idle(duration:100.ms, 0));
1
