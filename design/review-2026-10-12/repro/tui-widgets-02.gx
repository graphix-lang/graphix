use tui::{line, chart::{axis, chart, dataset}};

// tui-widgets-02: a chart y-axis with many labels overflows u16 inside ratatui
// run: GRAPHIX=<debug graphix> sh tui-widgets-run.sh tui-widgets-02-chart-ylabels-overflow.gx 80 50
// expected: the chart draws (labels sampled to the rows available), exit after 1s
// observed (debug): panicked at ratatui-widgets-0.3.2/src/chart.rs:980:22
// "attempt to multiply with overflow", "the display failed", exit=1
// control: 100 labels in the same terminal draws and exits 0
tui::exit(sys::time::timer(duration:1.s, false));
let data: Array<(f64, f64)> = [(0.0, 0.0), (1.0, 1.0)];
let ds = dataset(&data);
let lbls = array::init(2000, |i| line("[i]"));
chart(
    #x_axis: &axis({min: 0.0, max: 1.0}),
    #y_axis: &axis(#labels: lbls, {min: 0.0, max: 1.0}),
    &[ds]
)
