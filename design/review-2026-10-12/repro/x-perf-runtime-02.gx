let size = 16000;
let k = 1010;
let src = [];
src <- array::init(size, |i| i);
let z = never<i64>();
let f = |a, y| array::fold(array::map(a, |x| x + 1), 0, |acc, x| acc + x) + y;
let big = f(src, z);
let n = 0;
n <- n + 1;
let t0 = sys::time::now(select n { 10 => n, _ => never() });
let t1 = sys::time::now(select n { c if c == k => n, _ => never() });
sys::exit(sys::time::after_idle(duration:50.ms, t1 ~ 0));
sys::time::diff(t1, t0)
