// c-error-op-04: `?` over Any, or over a union with an open member, is
// refused with "expected error not []".
// command: graphix --no-cache --check design/review-2026-10-12/repro/c-error-op-04.gx
// expected: accepted; `x?` over the annotated nullable raises NullError (as
//   `|x: [Array<'a>, null]| x?` does), or at worst refused with Strip::of's
//   "annotate it" diagnostic.
// observed: exit 1, "3: expected error not []" at `x?` (also for
//   `|x: [i64, 'a]| x?`).
// Same refusal, separate program, `?` over Any under a catch:
//   let out = "none";
//   let x: Any = error(`Z);
//   let r = { catch(e) out <- "caught [e]"; x? };
//   out
// Related, separate program: with `$` the definition strips the error
// (null stays in its result type) while the i64 instance strips the null:
//   let f = |x: ['a, null]| x$;
//   let a: [i64, null] = null;
//   let s: i64 = f(a);
//   s
// is refused: "type mismatch i64 does not contain [null, 'a: i64]".
let f = |x: ['a, null]| x?;
f(3)
