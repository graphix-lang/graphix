// curl http://127.0.0.1:38951/x answers 500 with the whole ErrChain: the OS
// error, the path read, the server's source file path, line and column.
let s = http::serve(
    #addr: "127.0.0.1:38951",
    #handler: |req: http::Request| {
        let body = sys::fs::read_all("/etc/graphix-secret-dir/[req.path]")?;
        { body, headers: [], status: u16:200, url: "" }
    }
);
s
