// x-perf-compile-01: kernel frames grow quadratically (one stack_record per
// outlined loop holding every local in scope) and Cranelift runs without
// stack probes, so a big enough kernel overflows the runtime thread's stack.
// command: graphix --no-cache x-perf-compile-01.gx
// expected: [124752, 124753, 124754] (what --no-fusion and GRAPHIX_NO_OUTLINE=1 print)
// observed: "fatal runtime error: stack overflow, aborting", rc 134 (n=500);
// at n=800 (x-perf-compile-01-kernel-frame-overflow.gx) a plain SIGSEGV, rc 139:
// the frame jumps past the guard page. Explicit stack-slot bytes per GRAPHIX_DUMP_CLIF:
// 90400 at n=100, 340800 at n=200.
let f = |a: Array<i64>| {
  let b0 = array::map(a, |x| x + 1);
  let b1 = array::map(b0, |x| x + 1);
  let b2 = array::map(b1, |x| x + 2);
  let b3 = array::map(b2, |x| x + 3);
  let b4 = array::map(b3, |x| x + 4);
  let b5 = array::map(b4, |x| x + 5);
