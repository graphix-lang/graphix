// browser_commands.gx:69 runs run_command(command, x ~ selected_path). Enter
// pressed while the browser has no selected row yet (listing not arrived, empty
// directory) BANKS the trigger; the command then runs, unasked, against whatever
// row is selected when the listing lands. This model drives the example's key
// logic with simulated key presses; selected_path arrives 300 ms after Enter.
// HEAD prints "RUN a at /rows/first". Expected: nothing (x ~! selected_path).
use tui::input_handler::{Event, KeyCode, on_press};

let command_mode = false;
let command = "";
let selected_path: string = never();

let run_command = |c: string, path: string| println("RUN [c] at [path]");

let handle_normal_mode_key = |e: KeyCode| -> [`Stop, `Continue] select e {
    `Char(":") => { command <- ""; command_mode <- true; `Stop },
    _ => `Continue
};

let handle_command_mode_key = |e: KeyCode| -> [`Stop, `Continue] select e {
    `Char(c) => { command <- c ~ "[command][c]"; `Stop },
    x@ `Enter => {
        command_mode <- false;
        run_command(command, x ~ selected_path);
        `Stop
    },
    _ => `Continue
};

let handle_event = |e: Event| on_press(e, |k| select k ~ command_mode {
    true => handle_command_mode_key(k.code),
    false => handle_normal_mode_key(k.code)
});

let keys: Array<KeyCode> = [`Char(":"), `Char("a"), `Enter];
let i = count(sys::time::timer(duration:30.ms, 3)) - 1;
let ev: Event = `Key({code: keys[i]$, kind: `Press, modifiers: [], state: []});
let r = handle_event(ev);
println(i ~ "key [i] mode=[command_mode] command=[command]");
selected_path <- sys::time::after_idle(duration:300.ms, i ~ "/rows/first");
println("selected_path=[selected_path]");
sys::exit(sys::time::after_idle(duration:600.ms, selected_path ~ 0));
r
