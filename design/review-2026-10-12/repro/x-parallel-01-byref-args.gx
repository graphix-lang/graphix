// x-parallel-01: analysis::independent leaves the ByRef cells a sibling publishes out of
// `published` (plan_runs adds them), so a call-argument / constructor fork point forks a
// `&expr` beside a `*r` that reads its cell. `graphix-fuzz check` reports DIVERGENCE:
//   GRAPHIX_PAR=off   -> -1 10 20 30 40 50 60
//   GRAPHIX_PAR=force -> -1 (then nothing)
let i = array::iter([1, 2, 3, 4, 5, 6]);
let held: [&i64, null] = null;
let pair = |r: &i64, v: i64| (r, v);
let t = pair(&(i * 10), select held { null as _ => -1, r => *r });
held <- once(t.0);
t.1
