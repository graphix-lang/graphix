// x-builtin-effects-05: all() compares references by id, so all(r1, r2) never fires where r1 == r2
// run: graphix --no-cache design/review-2026-10-12/repro/x-builtin-effects-05.gx
// expected: two lines, "r1 == r2: true" and "all(r1, r2) produced: &ref"
// observed: only "r1 == r2: true"; all(r1, r2) never produces
let a = 1;
let r1 = &a;
let r2 = &a;
println("r1 == r2: [r1 == r2]");
println("all(r1, r2) produced: [all(r1, r2)]");
sys::exit(sys::time::after_idle(duration:100.ms, a) ~ 0);
r1 == r2
