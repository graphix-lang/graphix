let ep = 0;
ep <- select ep { n if n < 6 => n + 1, _ => never() };
let a = [1, 2, 3];
let i = 0;
let ra = &mut a[i];
let x = 1;
let y = 2;
let c = false;
let rx = select c { false => &mut x, true => &mut y };
let v = never();
v <- select ep { 1 => 99, _ => never() };
*ra <- v;
*rx <- v;
i <- select ep { 3 => 2, _ => never() };
c <- select ep { 3 => true, _ => never() };
sys::exit(sys::time::after_idle(duration:200.ms, 0));
(ep, a, x, y)
