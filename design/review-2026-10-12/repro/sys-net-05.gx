// sys-net-05: stream handles order and hash by heap address
// (Ord/Hash for Stream<K> in graphix-package-sys/src/lib.rs compare
// Arc::as_ptr), so a map keyed by handles iterates, and a sort of handles
// orders, differently from run to run.
//   for i in 1 2 3 4 5 6; do timeout -s KILL 30 graphix --no-cache design/review-2026-10-12/repro/sys-net-05.gx; done
// Expected: one line, the same every run.
// Observed: ([2, 1, 3], [2, 1, 3]), ([3, 1, 2], [3, 1, 2]), ([3, 2, 1], [3, 2, 1]),
//   ([1, 2, 3], [1, 2, 3]), ([3, 2, 1], [3, 2, 1]), ([2, 3, 1], [2, 3, 1]) across six runs.
let a = sys::io::stdout(null);
let b = sys::io::stderr(null);
let c = sys::io::stdin(null);
let m = {a => 1, b => 2, c => 3};
let byk = map::fold(m, [], |acc, (_, v)| array::push(acc, v));
let sorted = array::map(array::sort([a, b, c]), |h| m{h}$);
let r = (byk, sorted);
sys::exit(sys::time::after_idle(duration:50.ms, r) ~ 0);
r
