// x-builtin-effects-01: fstat/seek/truncate take the stream out of Halves,
// so a concurrent read or line reader sees it as closed.
// run: timeout -s KILL 60 graphix --no-cache design/review-2026-10-12/repro/x-builtin-effects-01.gx
// expected: lines read 200000 of 200000 (what the same program prints without the fstat line)
// observed: lines read 0 of 200000 / lines read 6664 of 200000 — the line reader
//   finds the read half None while fstat holds the stream, and ends with no error.
// See also x-builtin-effects-01-fstat-read-race.gx: Read::read beside fstat
//   returns error:["IOError", "stream unavailable"] (6 of 6 runs).
use sys::fs::{fstat, open, write_all};
use sys::io::Lines;
let temp = sys::fs::tempdir::create(null)$;
let path = sys::join_path(sys::fs::tempdir::path(temp), "data.txt");
let body = str::join(#sep: "\n", array::init(200000, |i| "line [i]"));
let wrote = write_all(#path: path, body)$;
let f = open(`Read, wrote ~ path)$;
let ls = Lines::lines_batched(f);
let n = 0;
n <- select ls { error as _ => never(), a => a ~ n + array::len(a) };
let tick = sys::time::timer(duration:1.ms, true);
let st = fstat(tick ~ f);
sys::exit(sys::time::after_idle(duration:500.ms, n) ~ 0);
println(sys::time::after_idle(duration:400.ms, n) ~ "lines read [n] of 200000")
