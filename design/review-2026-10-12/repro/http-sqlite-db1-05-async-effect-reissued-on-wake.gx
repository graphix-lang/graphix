let c = sqlite::open(":memory:")$;
let s = sqlite::exec_batch(c, "CREATE TABLE t(id INTEGER)")$;
let mode: [`A, `B] = `A;
let clock = sys::time::timer(duration:50.ms, true);
let n = 0;
n <- clock ~ n + 1;
mode <- select n {
    1 => `B,
    2 => `A,
    3 => `B,
    4 => `A,
    _ => never()
};
let r = select mode {
    `A => sqlite::exec(s ~ c, "INSERT INTO t VALUES (1)", [])$,
    `B => u64:0
};
let rows: Array<{cnt: i64}> = sqlite::query(n ~ c, "SELECT count(*) AS cnt FROM t", [])$;
sys::exit(select n { 8 => 0, _ => never() });
rows
