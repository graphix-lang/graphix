// c-analysis-branch-05: #[parallel] accepts any collection even when its slots can never fork
// command: graphix --no-cache --expand c-analysis-branch-05.gx
// expected: refused, "#[parallel] has nothing to run in parallel", as the tuple
// twin `#[parallel] (q(1), q(2))` is (the slots reach an ordered queuefn wrapper,
// so SlotSite::decide_siblings fixes them Dependent and they never fork)
// observed: accepted, exit 0
let clock = sys::time::timer(duration:1.ms, true);
let q = queuefn(#trigger: clock, |x: i64| -> i64 x);
let xs = [1, 2, 3, 4];
#[parallel]
array::map(xs, |x| q(x))
