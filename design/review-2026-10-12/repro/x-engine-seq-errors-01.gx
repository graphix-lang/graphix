// x-engine-seq-errors-01: a raised struct with ErrChain's field names
// (cause, error, ori, pos) is extended as a chain at delivery (wrap_error ->
// chain_error, by names alone) but the check keeps the struct's own field
// types (fix_echain_typ: is_echain_shape -> etyp unchanged). The handler's
// (e.0).cause is typed i64 and holds the whole raised struct; .ori/.pos are
// typed i64 and hold the real Ori/Pos.
// command: graphix --no-cache x-engine-seq-errors-01.gx   (--check accepts it)
// expected: the check types the handler's bind as the value delivered, or refuses
// observed (JIT): panic at graphix-compiler/src/fusion/kernel.rs (Kernel::stage)
//   "kernel param `x`: runtime Array(..) does not match the compiled Scalar(I64) slot",
//   then "Error: runtime did not respond", exit 1
// observed (--no-fusion): cause [[error:"can't add error types", 1], ...] ori [["parent", null], ...]
let f = |x: i64| x * 2 + 1;
let r = {
  catch(e) println("cause [f((e.0).cause)] ori [(e.0).ori]");
  error({cause: 1, error: 20, ori: 3, pos: 4})?
};
sys::exit(sys::time::after_idle(duration:100.ms, 0));
r
