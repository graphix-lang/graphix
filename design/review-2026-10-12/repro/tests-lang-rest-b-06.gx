// tests-lang-rest-b-06: a write through a moving reference that fires
// while the reference has no address (sel is null) is held and lands, at
// the RHS's then-current value, on whatever row is selected next, with no
// event at the landing (ConnectDeref::pending, node/mod.rs). A key pressed
// with nothing selected overwrites row 2 five cycles later:
// prints ["alpha", "beta", "typed while nothing was selected"].
// The rule is pinned (lang::byref::place_bottom_key) but stated nowhere in
// CLAUDE.md or design/place_references.md.
let step = 0;
step <- select step { s if s < 20 => s + 1, _ => never() };
let rows = ["alpha", "beta", "gamma"];
let sel: [i64, null] = null;
let cur = &mut rows[sel$];
let text = "typed while nothing was selected";
let key = select step { 5 => null, _ => never() };
sel <- select step { 10 => 2, _ => never() };
*cur <- key ~ text;
sys::exit(sys::time::after_idle(duration:200.ms, 0));
select step { 15 => rows, _ => never() }
