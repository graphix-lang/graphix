// gx-ui-07: line_edit::view puts the cursor in the wrong place with a multi-character #mask.
// command: graphix --no-cache gx-ui-07-line-edit-mask-cursor.gx
// expected: ["**", "**", "**"] (cursor cell is the second character's mask)
// observed: ["*", "*", "****"] (cursor indexes the masked string per glyph, not per character)
use tui::line_edit;
let st = { value: "abc", cursor: 1 };
let l = line_edit::view(#mask: "**", &st);
let parts = select l.spans { string as s => [s], a => array::map(a, |s| s.content) };
sys::exit(sys::time::after_idle(duration:200.ms, parts) ~ 0);
parts
