// remove /tmp/db2-freeze.db first; run 6 s: the ticks stop at 2 s when sub2 registers (the runtime thread blocks)
let db = db::open("/tmp/db2-freeze.db")$;
let t: db::Tree<i64, i64> = db::tree(db, "x")$;
let sub = db::subscription::new(t);
let ins = db::subscription::on_insert(sub)$;
let got = 0;
got <- ins ~ got + array::len(ins);
let go = sub;
let k = 0;
let b = db::insert(t, go ~ 0, 1)$;
k <- b ~ k + 1;
go <- b ~ sub;
let late: [i64, null] = sys::time::timer(duration:2.s, false) ~ 5;
let sub2 = db::subscription::new(#prefix: late, t);
println(sub2 ~ "sub2 made");
let tick = sys::time::timer(duration:500.ms, true);
println(tick ~ "inserts [k] events [got] [sys::time::now(tick)]")
