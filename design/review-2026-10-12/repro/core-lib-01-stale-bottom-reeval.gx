// CachedArgs re-runs eval at every stale update while its last result is bottom.
// divide(10, b) is a standing div0: its args fire once (init), yet it logs once
// per cycle the statement updates; `10 / b` logs once.
// run: RUST_LOG=error graphix --no-cache --no-fusion --log-dir /tmp/x prog.gx
// expect 1 `divide: "arithmetic error"` line on stderr; got 7.
let b = 0;
let ep = 0;
ep <- select ep { n if n < 5 => n + 1, _ => never() };
let t = (ep, divide(10, b));
sys::exit(sys::time::after_idle(duration:200.ms, 0));
ep
