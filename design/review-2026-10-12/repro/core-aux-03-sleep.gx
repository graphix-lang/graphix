// core-aux-03: queuefn: a sleeping wrapper site keeps its queued calls and
// they use up trigger releases (WrapperApply::sleep forwards to pred only;
// WrapperApply::delete drops the site's entries, QueueFn::sleep clears all).
// Site A queues 2 and 3 (c=1, c=2); its arm sleeps at c=3, where site B
// queues 10; triggers fire at c=4, 5, 6; the A arm wakes at c=8.
// command: graphix --no-cache core-aux-03-sleep.gx (same with --no-fusion)
// Expected (A's calls dropped at sleep, as at delete): ran 1, then ran 10
//   at c=5 from the first release, and nothing more from A.
// Observed: ran 1; the releases at c=4 and c=5 go to the sleeping site and
//   run nothing; ran 10 at c=7; ran 3 at the wake (c=8); ran 2 never.
let c = 0;
c <- select c { n if n < 10 => n + 1, _ => never() };
let trig: Any = select c { 4 => null, 5 => null, 6 => null, _ => never() };
let q = queuefn(#trigger: trig, |x: i64| -> i64 { println("ran [x]"); x });
let mode = select c { n if n < 3 => `A, n if n < 8 => `B, _ => `A };
let xa = select c { 0 => 1, 1 => 2, 2 => 3, _ => never() };
let xb = select c { 3 => 10, _ => never() };
let r = select mode { `A => q(xa), `B => q(xb) };
println(r ~ "c=[c] r=[r]");
sys::exit(sys::time::after_idle(duration:100.ms, 0));
null
