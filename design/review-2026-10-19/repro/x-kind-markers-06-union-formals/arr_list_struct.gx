{ let g = |q: [Array<i64>, List<i64>, {a: i64}]| -> i64 select q { Array<i64> as a => str::len("[a]"), List<i64> as a => str::len("[a]"), {a: i64} as a => str::len("[a]") }; let w: [Array<i64>, List<i64>, {a: i64}] = [i64:1]; let r = #[native] g(w); println("[r]"); sys::exit(sys::time::after_idle(duration:50.ms, 0)) }
