// Title: a fork site whose verdict rests on a call that never binds re-runs
// analysis::independent at every update, forever.
// Command (debug build; compare the two modes; the twin with the dynamic call replaced by
// `x * 2` runs the same in both):
//   GRAPHIX_PAR=off  graphix --no-cache --no-fusion design/review-2026-10-19/repro/x-parallel-undecided-reanalyzed-every-cycle.gx
//   GRAPHIX_PAR=auto graphix --no-cache --no-fusion design/review-2026-10-19/repro/x-parallel-undecided-reanalyzed-every-cycle.gx
// Expected: auto costs about what off costs once the site has decided (the twin: 0.92 s off,
//   0.79-0.99 s auto for 3000 cycles).
// Observed: 0.86-0.89 s off, 1.74-1.92 s auto: the untaken arm's call `(fs[0]$)(x)` never
//   binds, so SlotSite::decide_siblings gets None (Summary::unbound) every cycle and runs
//   collect_static_graph_of + instance_summaries over the callback again; the extra cost
//   grows with the callback (60 terms: ~36 us/cycle, 300 terms: ~300 us/cycle).
let n = 0;
n <- select n { k if k < 3000 => k + 1, _ => never() };
let fs = [|x: i64| x * 2];
let xs = array::init(4, |i| i + n);
let ys = array::map(xs, |x| select x { -1 => (fs[0]$)(x), x => (x * 1 + 1) % 7 + (x * 2 + 2) % 7 + (x * 3 + 3) % 7 + (x * 4 + 4) % 7 + (x * 5 + 5) % 7 + (x * 6 + 6) % 7 + (x * 7 + 7) % 7 + (x * 8 + 8) % 7 + (x * 9 + 9) % 7 + (x * 10 + 10) % 7 + (x * 11 + 11) % 7 + (x * 12 + 12) % 7 + (x * 13 + 13) % 7 + (x * 14 + 14) % 7 + (x * 15 + 15) % 7 + (x * 16 + 16) % 7 + (x * 17 + 17) % 7 + (x * 18 + 18) % 7 + (x * 19 + 19) % 7 + (x * 20 + 20) % 7 + (x * 21 + 21) % 7 + (x * 22 + 22) % 7 + (x * 23 + 23) % 7 + (x * 24 + 24) % 7 + (x * 25 + 25) % 7 + (x * 26 + 26) % 7 + (x * 27 + 27) % 7 + (x * 28 + 28) % 7 + (x * 29 + 29) % 7 + (x * 30 + 30) % 7 + (x * 31 + 31) % 7 + (x * 32 + 32) % 7 + (x * 33 + 33) % 7 + (x * 34 + 34) % 7 + (x * 35 + 35) % 7 + (x * 36 + 36) % 7 + (x * 37 + 37) % 7 + (x * 38 + 38) % 7 + (x * 39 + 39) % 7 + (x * 40 + 40) % 7 + (x * 41 + 41) % 7 + (x * 42 + 42) % 7 + (x * 43 + 43) % 7 + (x * 44 + 44) % 7 + (x * 45 + 45) % 7 + (x * 46 + 46) % 7 + (x * 47 + 47) % 7 + (x * 48 + 48) % 7 + (x * 49 + 49) % 7 + (x * 50 + 50) % 7 + (x * 51 + 51) % 7 + (x * 52 + 52) % 7 + (x * 53 + 53) % 7 + (x * 54 + 54) % 7 + (x * 55 + 55) % 7 + (x * 56 + 56) % 7 + (x * 57 + 57) % 7 + (x * 58 + 58) % 7 + (x * 59 + 59) % 7 + (x * 60 + 60) % 7 + (x * 61 + 61) % 7 + (x * 62 + 62) % 7 + (x * 63 + 63) % 7 + (x * 64 + 64) % 7 + (x * 65 + 65) % 7 + (x * 66 + 66) % 7 + (x * 67 + 67) % 7 + (x * 68 + 68) % 7 + (x * 69 + 69) % 7 + (x * 70 + 70) % 7 + (x * 71 + 71) % 7 + (x * 72 + 72) % 7 + (x * 73 + 73) % 7 + (x * 74 + 74) % 7 + (x * 75 + 75) % 7 + (x * 76 + 76) % 7 + (x * 77 + 77) % 7 + (x * 78 + 78) % 7 + (x * 79 + 79) % 7 + (x * 80 + 80) % 7 + (x * 81 + 81) % 7 + (x * 82 + 82) % 7 + (x * 83 + 83) % 7 + (x * 84 + 84) % 7 + (x * 85 + 85) % 7 + (x * 86 + 86) % 7 + (x * 87 + 87) % 7 + (x * 88 + 88) % 7 + (x * 89 + 89) % 7 + (x * 90 + 90) % 7 + (x * 91 + 91) % 7 + (x * 92 + 92) % 7 + (x * 93 + 93) % 7 + (x * 94 + 94) % 7 + (x * 95 + 95) % 7 + (x * 96 + 96) % 7 + (x * 97 + 97) % 7 + (x * 98 + 98) %