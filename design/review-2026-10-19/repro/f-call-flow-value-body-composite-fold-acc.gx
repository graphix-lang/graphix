// Title: a value-shaped fold body under a composite accumulator aborts the process
// Command: graphix --no-cache f-call-flow-value-body-composite-fold-acc.gx
// Expected (as --no-fusion prints): 1, 2, then nothing (k = 2 takes the never() arm) and exit 0
// Observed: 1, 2, then "graphix: zero ValArray bits — JIT codegen bug" from
//   graphix_valarray_drop and abort: loops.rs emit_fold_kind carries the bottom
//   select's (Null|TAINT, 0) placeholder as the Array accumulator.
let n = 0;
let t = sys::time::timer(duration:50.ms, 3);
n <- t ~ n + 1;
let g = |k: i64| {
  let init: Array<[i64, string]> = [];
  array::len(array::fold([k, k], init, |acc, x| select x { 0 => [1], 1 => ["x", "y"], _ => never() }))
};
sys::exit(sys::time::after_idle(duration:300.ms, 0));
g(n)
