// Title: a stolen compile job sees the waiting job's DEFAULTS_IN_CHECK: an omitted-default
// call site stays dynamic at random, so #[native] fails at random.
// Command (repeat ~12 times):
//   graphix --no-cache --expand design/review-2026-10-19/repro/x-parallel-default-in-check-tls.gx
// Expected: every run builds (every f(i) resolves statically and fuses).
// Observed: about 5 runs in 12 fail with
//   "#[native] expression did not fully fuse to native code: ... call site `f(51)` not discovered".
//   Passing #k explicitly (no omitted default), a one-expression body for f (no nested
//   check_in_tasks join), or RAYON_NUM_THREADS=1 never fails.
let f = |#k = 1, x: i64| -> i64 { let a = x + k; let c = a * 3; let b = c * 2; b };
let r0 = #[native] f(0);
let r1 = #[native] f(1);
