// queuefn drops its queued calls and its credits when its arm sleeps
// (QueueFn::sleep and WrapperApply::sleep), where a wake is a resume.
// Run: timeout -s KILL 30 graphix --no-cache x-node-contract-queuefn-sleep-reset.gx
// Expected (sleep is pause; `queue` keeps its contents across a sleep): 10, 10, 20
//   (the second 10 is the arm's re-entry; 20 answers the call queued at step 2,
//   released by the trigger at step 5)
// Observed: 10, 10 -- the call queued before the sleep is never answered.
// Moving the sleep out (steps 30/40 instead of 3/4) prints 10, 20.
let clock = sys::time::timer(duration:30.ms, true);
let step = 0;
step <- clock ~ step + 1;
let on = true;
let x: i64 = never();
let t: bool = never();
x <- select step { 1 => 1, 2 => 2, _ => never() };
on <- select step { 3 => false, 4 => true, _ => never() };
t <- select step { 5 => true, _ => never() };
let r = select on {
  true => {
    let q = queuefn(#trigger: t, |v: i64| v * 10);
    q(x)
  },
  false => never()
};
sys::exit(select step { 7 => 0, _ => never() });
r
