// schedule-v1: cap=64 events=512; in0=i64:10
// x-engine-firing: array::iter keeps its output across a sleep, so the re-entry emits the last
// element again; here that element puts the arm back to sleep, and the program
// flips forever.
// Command: graphix-fuzz run x-engine-firing-reentry-reraise.gx
// Expected (design/async_sleep_outputs.md lists iter/range deliveries as an event
// source, "its output is the last event, which does not survive the sleep"): epoch 1
// is 10, 11, -1 and then nothing (the woken arm has no event to emit).
// Observed, both engines, every session: [1:10 2:11 3:-1 4:11 5:-1 6:11 ...] up to the
// trace cap: each re-entry re-delivers 11.
// The CLI form (literal [10, 11, 12, 13] for the in0 array) spins: 489827 lines in 3 s.
{
let on = true;
let out = select on { true => array::iter([in0, in0 + 1, in0 + 2, in0 + 3]), false => -1 };
on <- select out { 11 => false, -1 => true, _ => never() };
out
}
