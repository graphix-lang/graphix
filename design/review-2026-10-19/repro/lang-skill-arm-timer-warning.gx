// lang-skill: the repeating timer in an arm resumes at the wake (ticks 6 -> 9 asleep, then 12, 15,
// 18), yet the check warns "this call reads no variable, so it acts only at this arm's first entry"
// (node/select.rs warn_birth_only warns on every Effect::Async builtin with constant arguments).
// SKILL.md's sys::time line also says "the arm sleeping stops it".
// Command: timeout -s KILL 10 /home/eric/tmp/review-2026-10-19/bin/graphix --no-cache lang-skill-arm-timer-warning.gx
// Expected: no warning for an event source that keeps producing across wakes.
// Observed: the WARNING above, and ticks resumes after the arm's sleep.
let clock = sys::time::timer(duration:100.ms, true);
let n = 0;
n <- clock ~ n + 1;
let on: [`On, `Off] = select n { 3 => `Off, 4 => `Off, 5 => `Off, _ => `On };
let ticks = 0;
select on { `On => ticks <- sys::time::timer(duration:30.ms, true) ~ ticks + 1, `Off => never() };
sys::exit(select n { 9 => 0, _ => never() });
[select n { 9 => 0, _ => never() }, dbg(n ~ (on, ticks))]
