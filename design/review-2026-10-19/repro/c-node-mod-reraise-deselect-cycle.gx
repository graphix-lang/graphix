// Title: a write queued in an arm's last awake cycle lands in the cycle the
// arm is deselected and is never re-raised at the wake.
// Command:
//   timeout -s KILL 10 graphix --no-cache design/review-2026-10-19/repro/c-node-mod-reraise-deselect-cycle.gx
// The write `k <- 7` is issued at n=2 (arm `A awake) and lands at n=3, the
// cycle `mode` turns `B and the select puts the arm to sleep. No reader in
// the arm saw it. design/wake_catchup.md ("a write queued in its last awake
// cycle ... its let re-raises it, fired, at its wake") says count(k) is 2
// once the arm wakes at n=6.
// Expected: (0, 100, 1) (1, 100, 1) (2, 100, 1) (3, -1, -1) (4, -1, -1)
//           (5, -1, -1) (6, 7, 2) (7, 7, 2) ...
// Observed: ... (6, 7, 1) (7, 7, 1) ...   (both engines; graphix-fuzz check: AGREE)
// With the write one cycle earlier (`1 => 7`, landing at n=2 while awake)
// the count is 2, as it is for any landing after the deselect cycle.
let n = 0;
n <- select n { x if x < 9 => x + 1, _ => never() };
let mode = select n { x if x < 3 => `A, x if x < 6 => `B, _ => `A };
let r = select mode {
  `A => {
    let k = 100;
    k <- select n { 2 => 7, _ => never() };
    (n, k, count(k))
  },
  `B => (n, -1, -1)
};
r
