// A fork site whose sibling holds a call that is never bound re-runs
// analysis::independent at every update (Siblings::of(None) stays Undecided).
// Run (time each):
//   GRAPHIX_PAR=off  graphix --no-cache --no-fusion c-analysis-branch-unbound-sibling-redecides.gx
//   GRAPHIX_PAR=auto graphix --no-cache --no-fusion c-analysis-branch-unbound-sibling-redecides.gx
// Expected: auto costs about what off does (it does when `g` is bound: 0.77 s vs 0.73 s).
// Observed (debug build, 3000 cycles): off 0.69 s, auto 1.78 s; with the chain at 600
// functions instead of 150: off 1.76 s, auto 9.0 s. The extra time per cycle grows with
// everything the sibling `f150(n)` reaches, re-walked by collect_static_graph_of each cycle.
let f0 = |x: i64| -> i64 x + 1;
let f1 = |x: i64| -> i64 f0(x) + f0(x + 1);
