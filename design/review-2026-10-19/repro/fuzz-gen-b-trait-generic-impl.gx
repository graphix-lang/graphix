// Title: trait shapes modules.rs never draws: a generic impl over a
//   constructor (`impl<'a: Tr> Tr for Array<'a>`), impls for a primitive
//   and a structural type, a default overridden on a structural type
// Command: graphix-fuzz check fuzz-gen-b-trait-generic-impl.gx
// Expected: well-formed, every comparison holds.
// Observed: AGREE (trace), values as hand-computed (epoch in0=1:
//   (3, 7, 7, 100, 4)). gen_module only implements Tr for its abstract T/T2.
// schedule-v1: cap=64 events=512; in0=i64:1; in0=i64:2; in0=i64:-3
{
  trait Tr { val tv: fn(self) -> i64; val tw: fn(self) -> i64 = |s| tv(s) + i64:1 };
  impl Tr for i64 { let tv = |x| x * i64:2 };
  impl<'a: Tr> Tr for Array<'a> { let tv = |xs| array::fold(xs, i64:0, |acc, x| acc + Tr::tv(x)) };
  impl Tr for {a: i64, b: string} { let tv = |s| s.a + str::len(s.b); let tw = |s| i64:100 };
  let via = 'a: Tr |x: 'a| Tr::tw(x);
  let r0 = via(in0);
  let r1 = via([in0, in0 + i64:1]);
  let r2 = via([[in0], [in0, in0]]);
  let r3 = via({a: in0, b: "xy"});
  let r4 = Tr::tv({a: in0, b: "xyz"});
  (r0, r1, r2, r3, r4)
}
