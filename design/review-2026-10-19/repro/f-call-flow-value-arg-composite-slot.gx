// Title: a value-shaped argument into a composite kernel slot aborts the process
// Command: graphix --no-cache f-call-flow-value-arg-composite-slot.gx
// Expected (as --no-fusion prints): 1, 2, then nothing (k = 2 takes the never() arm) and exit 0
// Observed: 1, 2, then "graphix: zero ValArray bits — JIT codegen bug" from
//   graphix_valarray_clone (the callee's entry clone of its Array param) and abort.
// The select's type is [Array<i64>, Array<string>] (a two-word Value); its bottom
// placeholder (Null|TAINT, 0) is passed as-is into f's Array slot by call.rs marshal_args.
let n = 0;
let t = sys::time::timer(duration:50.ms, 3);
n <- t ~ n + 1;
let f = |a: Array<[i64, string]>| -> i64 array::len(a);
let g = |k: i64| f(select k { 0 => [1], 1 => ["x", "y"], _ => never() });
sys::exit(sys::time::after_idle(duration:300.ms, 0));
g(n)
