// The stall form of x-seq-sampling-derived-read-misses-own-write.gx: an
// `until` over a binding derived from the variable the step before wrote is
// entered in the cycle of the write, snapshots the old value and never completes.
//
// command:  timeout -s KILL 4 graphix --no-cache x-seq-sampling-until-derived-stalls.gx
// expected: (.., false, true, 1, 2)   both seqs complete
// observed: (.., false, true, 1, 0)   `seq go { busy <- false; until idle; 2 }`
//           never completes though `idle` has been true since the cycle after
//           the write; `until !busy` over the same variable does.
let step = 0;
step <- select step { n if n < 10 => n + 1, _ => never() };
let go = select step { 2 => step, _ => never() };
let busy = true;
let idle = !busy;
let a = seq go { busy <- false; until !busy; 1 };
let b = seq go { busy <- false; until idle; 2 };
let av = 0; av <- a;
let bv = 0; bv <- b;
(step, busy, idle, av, bv)
