// t-seq: a seqq capture holds its last value through bottom; a seq step waits
// Run: timeout -s KILL 30 /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache design/review-2026-11-16/repro/t-seqq-capture-holds-through-bottom.gx
// `role` is bottom from step 3 to step 29 (its scrutinee `run` is bottom).
// seq (design/seq_blocks.md §5, "an absent input delays reading"): the run
// triggered at go=4 waits and reads role=8 at step 30.
// seqq, by the same rule ("when the request is queued under seqq, or once
// all named inputs are present"), should read 8 for both requests.
// Observed: "seqq go=4 role=5", "seqq go=20 role=5", "seq go=4 role=8":
// the request reads 5, a value role has not held since step 2, through the
// `hold` the lowering puts on every capture (book/src/core/seq.md documents
// this; design/seq_blocks.md and the graphix-lang skill do not).
let step = 0;
step <- select step { n if n < 40 => n + 1, _ => never() };
let run = select step { 2 => `Install(5), 15 => `Other, 30 => `Install(8), _ => never() };
let role = select run { `Install(r) => r, _ => never() };
let go = select step { 4 | 20 => step, _ => never() };
let a = seq go { let v = role; println("seq go=[go] role=[v]"); v };
let b = seqq go { let v = role; println("seqq go=[go] role=[v]"); v };
sys::exit(sys::time::after_idle(duration:200.ms, 0));
(a, b)
