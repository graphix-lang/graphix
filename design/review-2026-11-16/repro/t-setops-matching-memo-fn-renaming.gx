// Title: matching_type's memo answers one function part with another's type
//        (two function types that differ by a renaming of their cells share
//        a RefHist::ref_id), so the check accepts q(x) with q: fn('b) -> 'b
//        and x: 'a.
// Command: timeout -s KILL 30 /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache \
//          design/review-2026-11-16/repro/t-setops-matching-memo-fn-renaming.gx
//          (and the same with --check: exit 0)
// Expected: the check refuses q(x), "type mismatch 'b: unbound does not
//           contain 'a: unbound", as it does when the scrutinee is written
//           (g, f, n) and the pattern (q, _, _), or with the inferred
//           pattern (p, q, _).
// Observed: --check exits 0; the run logs
//           "q(x): binding the callee failed: a run-time bind at q(x) did not
//            type: an instance at fn(x: i64) -> i64 of a definition typed
//            fn(s: string) -> string" and r never has a value.
let h = |f: fn(x: 'a) -> 'a, g: fn(x: 'b) -> 'b, n: [i64, null], x: 'a| -> 'a
  select (f, g, n) { (Any, Any, i64) as (_, q, _) => q(x), _ => x };
let r = h(|x: i64| x + 1, |s: string| "[s]!", 1, 5) + 1;
sys::exit(sys::time::after_idle(duration:300.ms, 0));
r
