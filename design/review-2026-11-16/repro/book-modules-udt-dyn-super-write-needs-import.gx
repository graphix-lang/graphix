// Title: book/src/modules/dynamic.md "Signature Checking": the fixed example
// (`let y: i64 = never()`, `val h: fn(x: i64) -> i64`, body `let h = |x| { super::y <- x; x }`)
// does not load: the sig imports nothing, so the sandboxed body cannot name super::y.
// Command: timeout -s KILL 10 /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache book-modules-udt-dyn-super-write-needs-import.gx
// Expected per the book: null (the load succeeds once y is annotated).
// Observed: error:`DynamicLoadError("... super::y <- x\n    2: super::y is undefined").
// With `use super::y;` added to the sig it loads, and the unannotated variant then
// fails as the book says ("it holds the type of `y` ... declare y's type").
let y: i64 = never();
let status = mod foo dynamic {
    sig { val h: fn(x: i64) -> i64 };
    source "let h = |x| { super::y <- x; x }"
};
sys::exit(sys::time::after_idle(duration:200.ms, 0));
status
