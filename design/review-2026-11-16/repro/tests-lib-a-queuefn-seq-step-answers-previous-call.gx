// queuefn: a seq step's call through a wrapper answers the PREVIOUS run's result
//
// run:      graphix --no-cache tests-lib-a-queuefn-seq-step-answers-previous-call.gx
//           (same with --no-fusion; graphix-fuzz check AGREEs on the wrong answer)
// expected: [0, 10, 20, 30, 40, 50, 60]   -- what `let r = qf(t)` at the top level gives,
//           and what `seqq t { f(t) }` gives for a plain `f`
// observed: [0, 0, 10, 20, 30, 40, 50]   -- run 2 answers qf(0)'s 0, run k answers run k-1
//
// With `#trigger: never()` (one credit only) the second run's call is queued and
// should stall the seqq (log [0]); instead every run answers 0 at once: [0, 0, 0, 0].
//
// Cause: WrapperApply::reborn (stdlib/graphix-package-core/src/queuefn.rs) drops the
// site's queued calls but keeps the site's argument bindings and `out`; the step's run
// is a birth, so the wrapped call over the standing bindings fires f(previous args).
let t = 0;
t <- select t { n if n < 6 => n + 1, _ => never() };
let qf = queuefn(#trigger: t, |x: i64| -> i64 x * 10);
let r = seqq t { qf(t) };
let log: Array<i64> = [];
log <- r ~ array::push(log, r);
sys::exit(sys::time::after_idle(duration:200.ms, 0));
log
