// Title: a constant raise or a constant-argument effect in a collection
//   callback acts only in the slots that exist in the program's first cycle,
//   and the check warns of neither (x-engine-seq-errors-02 variant: the same
//   raise in a select arm warns "this raise reads no variable ...")
// Command: timeout -s KILL 30 graphix --check x-rerun-4-slot-constant-no-warning.gx
//          timeout -s KILL 30 graphix --no-cache x-rerun-4-slot-constant-no-warning.gx
// Expected: --check warns of the raise and of the println, as it does when
//   the same body is a select arm entered after the first cycle; the run
//   (by bind-driven bodies) raises and prints once, for slot 0 only.
// Observed: --check prints nothing (exit 0); the run prints "slot" once and
//   (0, 1, 0) (1, 2, 1) (2, 3, 1) (3, 4, 1): slots 1..3 raise nothing.
let n = 0;
n <- select n { k if k < 3 => k + 1, _ => never() };
let xs = array::init(n + 1, |i| i);
let raised = 0;
let ys = array::map(xs, |x| {
  catch(e) raised <- e ~ raised + 1;
  error(`Bad)?
});
let printed = array::map(xs, |x| println("slot"));
sys::exit(sys::time::after_idle(duration:100.ms, 0));
(n, array::len(xs), raised)
