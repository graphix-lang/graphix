// t-seq: under seqq a reference's index reads the live variable, not the request's capture
// Run: timeout -s KILL 30 /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache design/review-2026-11-16/repro/t-seq-ref-index-seqq.gx
// Two requests are queued while sel is 0 and then 1; each run's println shows
// the request's capture of sel (0, then 1).
// Expected: each run writes the row its request selected: rows [2, 4, 0].
// Observed: rows [0, 0, 4]: both writes land at rows[2], the live sel when
// the runs execute, because `&mut rows[sel]` keeps no capture or snapshot
// redirect anywhere inside the `&`.
let step = 0;
step <- select step { n if n < 30 => n + 1, _ => never() };
let rows = [0, 0, 0];
let sel = 0;
sel <- select step { 3 => 1, 5 => 2, _ => never() };
let go = select step { 2 | 4 => step, _ => never() };
let ready = false;
ready <- select step { 10 => true, _ => never() };
let a = seqq go {
  until live(ready);
  let r = &mut rows[sel];
  *r <- go;
  println("go=[go] sel=[sel]");
  go
};
sys::exit(sys::time::after_idle(duration:200.ms, 0));
rows
