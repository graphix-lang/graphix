// A fold whose callback reads its accumulator fires at the entry of an arm
// taken after the program's first cycle, over a constant source and init.
// Command:
//   timeout -s KILL 30 graphix --no-cache --no-fusion tests-select-a-fold-acc-fires-at-entry.gx
// Expected (CLAUDE.md "Bodies are bind-driven"; design/bind_driven_bodies.md
// section 1: a fold's accumulator fires when the init fires): nothing printed,
// as with `|acc, e| e` or `array::map` in the same place.
// Observed (node-walk and default): 1 1 1. With `let s = 0; s <- array::fold(..); s`
// in the arm the write lands (0 5 5) although the check warns that it
// "acts only if this arm is taken in the program's first cycle".
let x = array::iter([1, 3, 5]);
let m = x % 2;
let sel = select m {
  0 => 100,
  _ => count(array::fold([1, 2, 3], 5, |acc, e| acc))
};
sys::exit(sys::time::after_idle(duration:100.ms, 0));
sel
