// A core-trait impl whose head is one instantiation of an abstract type
// answers "implemented" for every instantiation in the check.
//
// Command:
//   /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache t-cast-specialized-impl-head.gx
//
// Expected: the check refuses lines (1)-(4), as it does when the two impls
// are deleted ("Box<[i64, f64]> has no Ord implementation, so its values
// compare by its representation ...", "Box has no Cast implementation, so
// no read, cast or writer reaches it").
//
// Observed: the check accepts all four; the run prints
//   ord: true        (i64:3 < f64:3.0: no impl is consulted, the representation orders by numeric type)
//   cast: error:`InvalidCast("can't cast \"x\" to Box<string>: it has no Cast implementation")
//   write: error:`JsonErr("Box has no Cast implementation")
//   read: error:`InvalidCast("can't cast \"x\" to Box<string>: it has no Cast implementation")
type Box<'a> = Abstract<'a>;
impl Ord for Box<i64> { let cmp = |a, b| `Equal };
impl Cast for Box<i64> {};
let a: Box<[i64, f64]> = Box(i64:3);
let b: Box<[i64, f64]> = Box(f64:3.0);
// (1) an order over two numeric types
let s = a < b;
println("ord: [s]");
let v: Any = "x";
// (2) a cast to an instantiation with no impl
println("cast: [cast<Box<string>>(v)]");
// (3) a write of one
println("write: [json::write_str(Box("x"))]");
// (4) a read of one
let r: Result<Box<string>, [`JsonErr(string), `InvalidCast(string)]> = json::read("{\"Box\": \"x\"}");
println("read: [r]");
sys::exit(sys::time::after_idle(duration:200.ms, 0));
0
