// x-async-io: a line reader frames the bytes an unanswered read gave back as part of one line
//
// command: timeout -s KILL 30 /home/eric/tmp/review-2026-11-16/bin/graphix --no-cache design/review-2026-11-16/repro/x-async-io-lines-after-unread.gx
//
// The read is in flight when its arm sleeps; it finishes unanswered and its
// bytes ("l1\nl2\n") go back to the stream. The line reader started after
// that must frame them as the lines they are.
//
// expected (what the same program prints with the select arm removed):
//   line: l1
//   line: l2
//   line: l3
// observed: one line, and only once "l3\n" arrives 600 ms later:
//   line: l1
//   l2
//   l3
use sys::io::{Read, Lines};
let opts = sys::process::options(
  #stdio: sys::process::stdio(#stdout: `Pipe),
  #args: ["-c", "sleep 0.4; printf 'l1\\nl2\\n'; sleep 0.6; printf 'l3\\n'; sleep 0.3"],
  "sh");
let out = sys::process::spawn(opts)$.stdout$;
let is_on = true;
is_on <- sys::time::after_idle(duration:150.ms, out ~ false);
// the read is in flight when its arm sleeps; its bytes go back to the stream
let got = select is_on { true => Read::read(out, u64:100)$, false => never() };
println("read answered: [buffer::to_string_lossy(got)]");
let later = sys::time::after_idle(duration:700.ms, out);
let l = Lines::lines(later)$;
println("line: [l]");
sys::exit(sys::time::after_idle(duration:2500.ms, out ~ 0));
l
