// A queuefn wrapper called from a seq step answers the PREVIOUS run's call
// from the second run on.
//
// command: graphix-fuzz run x-engine-seq-errors-queuefn-seq-step-stale-answer.gx
//   (or: graphix --no-cache <file>)
//
// `q2` adds one; its trigger fires every cycle, so no call waits long.
// expected: r = (2, 3, 4), then (11, 12, 13), then (21, 22, 23)
// observed: r = (2, 3, 4), then (2, 3, 4), then (11, 3, 4)
//   (node-walk and JIT agree). The step's fresh frame delivers, fired, the
//   wrapper site's own argument bindings as they stand from the last run, so
//   the wrapped call answers the old arguments and that answer completes the
//   step; the new arguments are written for the next cycle (the site takes
//   the injected fire for a release landing) and reach a step already passed.
let step = 0;
step <- select step { n if n < 30 => n + 1, _ => never() };
let go = select step { 1 | 10 | 20 => step, _ => never() };
let q2 = queuefn(#trigger: step, |y: i64| -> i64 y + 1);
let r = seq go { let c = q2(go); let d = q2(c); let e = q2(d); (c, d, e) };
dbg(r);
step
