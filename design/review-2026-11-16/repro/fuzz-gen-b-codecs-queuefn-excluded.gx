// A codecs program that draws the queuefn-siblings slot loses every comparison.
// gen_slots gates gen_ref_stmts and gen_catch_slot on !ctx.codecs but not
// gen_queuefn_siblings, whose `t <- select t {..}` counter and `queuefn(` put a
// `<-` and a fire-count-sensitive builtin beside the codec round trip's async
// reader, so oracle_tier classifies the whole program Excluded.
// This is the shape gen_queuefn_siblings emits beside try_format_round_trip.
// command: graphix-fuzz check fuzz-gen-b-codecs-queuefn-excluded.gx
// expected: AGREE (a value comparison), as the same program without the queuefn slot gives
// observed: EXCLUDED — the oracle compares no values of this program; its sessions agree in kind
{ let v0: i64 = { let r: i64 = json::read(json::write_str(i64:42)$)$; r }; let v3 = i64:0; v3 <- select v3 { s if s < i64:1 => s + i64:1, _ => never() }; let v1 = queuefn(#trigger: v3, |v2: i64| -> i64 v2 + (i64:1 + i64:2)); let v4 = v1(i64:7); let v5 = v1(i64:9); println("[v5]"); println("[v0]"); println("[v4]"); (v0 + v4) }
