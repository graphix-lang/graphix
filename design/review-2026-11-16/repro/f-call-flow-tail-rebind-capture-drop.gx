// A tail loop rebinds a `_` formal (declared `a: string`) into the i64
// capture `a`, dropping the capture as a string (body.rs::lookup_slot's
// name fallback finds the later-bound capture by the formal's declared name).
// command:  graphix --no-cache f-call-flow-tail-rebind-capture-drop.gx
// expected: 100, as `graphix --no-cache --no-fusion` prints
// observed (debug build): panicked at arcstr-1.2.0/src/arc_str.rs:1293:9:
//   misaligned pointer dereference: address must be a multiple of 0x8 but
//   is 0x64 ... thread caused non-unwinding panic. aborting.
//   (graphix_arcstr_drop on the capture's payload 100; a release build
//   frees a wild pointer)
let a = 100;
let rec f: fn(a: string, n: i64) -> i64 = |_, n| select n { 0 => a, k => f("[k]", k - 1) };
let r = |n: i64| -> i64 f("x", n);
r(3)
