// A core-trait hook answers from a stale capture: a part of an impl's method
// that reads only captured variables keeps the value it had at the hook's
// last dispatch, and the two engines disagree about it.
//
// `strict` turns true at n = 1 and `x` changes at n = 2 only. From n = 2 on
// `x == y` is T(2) == T(5) under strict = true: false, as `plain`, the same
// body called as a function, answers.
//
// Command (node-walk):
//   graphix --no-cache --no-fusion design/review-2026-11-16/repro/c-prune-wake-hook-stale-capture.gx
// Expected from n = 2 on: hook=false inline=false plain=false
// Observed:
//   n=1 strict=true hook=true inline=true plain=false
//   n=2 strict=true hook=true inline=true plain=false   (and so on to n=4)
// Command (JIT): the same without --no-fusion. Observed:
//   n=1 strict=true hook=true inline=false plain=false
//   n=2 strict=true hook=false inline=false plain=false   (and so on to n=4)
// so the engines disagree: the kernel holding `inline` dispatches the hook in
// the cycle `strict` fires, which refreshes the pooled site `h` shares.
type T = Abstract<i64>;
let t = sys::time::timer(duration:100.ms, true);
let n = 0;
n <- t ~ n + 1;
let strict = uniq(n >= 1);
impl Eq for T { let eq = |a, b| !strict || a.0 == b.0 };
let plain = |a: T, b: T| !strict || a.0 == b.0;
let x = T(uniq(select n { 0 => 1, 1 => 1, _ => 2 }));
let y = T(5);
let h = x == y;
let p = plain(x, y);
sys::exit(select n { 4 => 0, _ => never() });
println("n=[n] strict=[strict] hook=[h] inline=[x == y] plain=[p]")
