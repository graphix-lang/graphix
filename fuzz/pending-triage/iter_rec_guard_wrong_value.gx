{let x = array::iter([i64:1, i64:2, i64:3, i64:9223372036854775807]); let m = x / i64:3; let rec f = |n| select n {i64:0 => select i64:0 {i64:0 if m == i64:0 => is_err(i64:3), _ => i64:2}, _ => f(i64:0)}; f(i64:3)}
