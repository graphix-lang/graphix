// bisect: divergence (interp != jit) — OPEN, parked 2026-08-14.
// Found by soak aug14d (hz0 fuzz divergence_000005) on the tree with
// the arm-local-bind fixes; NOT that seam.
//
//   interp: [1:i64:1  2:<sys::tcp::connect fn value>  3:i64:1  4:f64:2.]
//   jit:    [1:i64:1                                  3:i64:1]
//
// The source array is HETEROGENEOUS — i64, a function value, and an
// f64 — and the select's guard (x < i64:10) can only be meaningful for
// the i64 elements. The interp emits every element (passing the fn
// value and the f64 through the wildcard arm); the kernel emits only
// the two guard-true i64s and drops the others entirely.
//
// Adjudicate before touching either engine: what should a guard that
// bottoms on a non-numeric element do — fall through to the wildcard
// arm (interp) or bottom the whole select (kernel)? The guard-ride
// rules (aug06ghz0) and the depth-trip poisoning both bear on it.
{let x = array::iter([i64:0, sys::tcp::connect, i64:0, math::abs(f64:2.)]); let rec f = |n: i64| -> i64 n; select x {x if x < i64:10 => f(x + i64:1), x => x}}
