// OPEN — aug18a class 6 (aieka divergence_000001; ryouko
// divergence_000000 was a flap face of the same class that no longer
// reproduces). Lowest severity: both modes REJECT the program; only
// the diagnostic detail differs.
//
//   interp: ... within Array<'a: i64> does not contain i64
//   jit:    ... within Array<'a: unbound> does not contain i64
//
// The error is a TYPECHECK error, and typecheck is mode-independent —
// so the divergent tvar-bound rendering must leak from the STDLIB
// compile, which runs with fusion on in jit mode: some fusion-phase
// walk binds (or leaves bound) a shared stdlib-signature tvar cell
// that the no-fusion compile leaves unbound, and the user program's
// later error message renders that cell's state. Same invariant
// check_mode_parity protects on the --check success path; this is the
// runtime-diagnostic face. Hunt tool: GRAPHIX_DBG_BIND=1 diffed
// between modes over the stdlib compile, looking for the cell that
// feeds array::group's signature.
{let a = [i64:0, i64:1, i64:100, i64:3, i64:4, i64:5, i64:6]; {let f = |a, b| array::group(count(array::iter(a)), |n, _| n == i64:4); f(i64:1, f64:2.5)}}
