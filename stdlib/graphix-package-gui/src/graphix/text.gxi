use super::{Color, Font, HAlign, Length, VAlign, Widget};
type Text = {
  content: &string,
  size: &[f64, null],
  color: &[Color, null],
  font: &[Font, null],
  width: &Length,
  height: &Length,
  halign: &HAlign,
  valign: &VAlign
};

// A non-null #size must be finite, positive and at most 4096 pixels.
val text: fn(
  ?#size: &[f64, null],
  ?#color: &[Color, null],
  ?#font: &[Font, null],
  ?#width: &Length,
  ?#height: &Length,
  ?#halign: &HAlign,
  ?#valign: &VAlign,
  content: &string
) -> Widget
