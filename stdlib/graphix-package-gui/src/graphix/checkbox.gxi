use super::{Length, Widget};
type Checkbox = {
  disabled: &bool,
  is_checked: &bool,
  label: &string,
  on_toggle: &[fn(b: bool) -> Any, null],
  width: &Length,
  size: &[f64, null],
  spacing: &[f64, null]
};

// A non-null #size must be finite, positive and at most 4096 pixels.
val checkbox: fn(
  ?#label: &string,
  ?#on_toggle: [fn(b: bool) -> Any, null],
  ?#width: &Length,
  ?#size: &[f64, null],
  ?#spacing: &[f64, null],
  ?#disabled: &bool,
  is_checked: &bool
) -> Widget
