use super::{Length, Widget};
type Checkbox = {
  disabled: &bool,
  is_checked: &bool,
  label: &string,
  on_toggle: &[fn(b: bool) -> Any, null],
  width: &Length,
  size: &[f64, null],
  spacing: &[f64, null]
};

// A non-null #size must be finite, positive and at most 4096 pixels.
// CR claude for claude: [doc-drift/low] The size rule above this val is a `//` comment,
// so the LSP hover and the docs never show it. The same holds in markdown.gxi,
// radio.gxi, text.gxi, text_editor.gxi, text_input.gxi, toggler.gxi and canvas.gxi
// (above `type CanvasShape`). chart.gxi writes the same rule as `///`. Make all eight
// `///` docs. Found by reading; not run. (gx-ui-05)
val checkbox: fn(
  ?#label: &string,
  ?#on_toggle: [fn(b: bool) -> Any, null],
  ?#width: &Length,
  ?#size: &[f64, null],
  ?#spacing: &[f64, null],
  ?#disabled: &bool,
  is_checked: &bool
) -> Widget
