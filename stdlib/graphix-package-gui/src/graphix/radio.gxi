use super::{Length, Widget};
/// A radio of any value type: `on_select` is called with `value`.
type Radio = {
  disabled: &bool,
  value: &Any,
  label: &string,
  on_select: &[fn(v: Any) -> Any, null],
  selected: &[Any, null],
  width: &Length,
  size: &[f64, null],
  spacing: &[f64, null]
};

/// A non-null #size must be finite, positive and at most 4096 pixels.
val radio: fn(
  #label: &string,
  ?#selected: &['a, null],
  ?#on_select: [fn(v: 'a) -> Any, null],
  ?#width: &Length,
  ?#size: &[f64, null],
  ?#spacing: &[f64, null],
  ?#disabled: &bool,
  value: &'a
) -> Widget
