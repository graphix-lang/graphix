use super::{Length, Widget};
type Markdown = {
  content: &string,
  on_link: &[fn(url: string) -> Any, null],
  spacing: &[f64, null],
  text_size: &[f64, null],
  width: &Length
};

/// A non-null #text_size must be finite, positive and at most 4096 pixels.
val markdown: fn(
  ?#on_link: [fn(url: string) -> Any, null],
  ?#spacing: &[f64, null],
  ?#text_size: &[f64, null],
  ?#width: &Length,
  content: &string
) -> Widget
