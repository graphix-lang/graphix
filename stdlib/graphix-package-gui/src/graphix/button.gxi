use super::{Length, Padding, Widget};
type Button = {
  child: &Widget,
  disabled: &bool,
  on_press: &[fn(e: null) -> Any, null],
  width: &Length,
  height: &Length,
  padding: &Padding
};

val button: fn(
  ?#on_press: [fn(e: null) -> Any, null],
  ?#width: &Length,
  ?#height: &Length,
  ?#padding: &Padding,
  ?#disabled: &bool,
  child: &Widget
) -> Widget
