use super::Widget;
type KeyEvent = {
  key: string,
  modifiers: {shift: bool, ctrl: bool, alt: bool, logo: bool},
  text: string,
  repeat: bool
};

type KeyboardArea = {
  child: &Widget,
  on_key_press: &[fn(e: KeyEvent) -> Any, null],
  on_key_release: &[fn(e: KeyEvent) -> Any, null]
};

/// A key no callback is given for goes on to an enclosing area.
val keyboard_area: fn(
  ?#on_key_press: [fn(e: KeyEvent) -> Any, null],
  ?#on_key_release: [fn(e: KeyEvent) -> Any, null],
  child: &Widget
) -> Widget
