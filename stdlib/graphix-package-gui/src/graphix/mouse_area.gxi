use super::Widget;
type MouseButton = [`Left, `Right, `Middle];

type MouseArea = {
  child: &Widget,
  on_press: &[fn(button: MouseButton) -> Any, null],
  on_release: &[fn(button: MouseButton) -> Any, null],
  on_enter: &[fn(e: null) -> Any, null],
  on_exit: &[fn(e: null) -> Any, null],
  on_move: &[fn(pos: {x: f64, y: f64}) -> Any, null]
};

val mouse_area: fn(
  ?#on_press: [fn(button: MouseButton) -> Any, null],
  ?#on_release: [fn(button: MouseButton) -> Any, null],
  ?#on_enter: [fn(e: null) -> Any, null],
  ?#on_exit: [fn(e: null) -> Any, null],
  ?#on_move: [fn(pos: {x: f64, y: f64}) -> Any, null],
  child: &Widget
) -> Widget
