use super::{Font, Padding, Widget};
type TextEditor = {
  content: &string,
  disabled: &bool,
  on_edit: &[fn(s: string) -> Any, null],
  placeholder: &string,
  width: &[f64, null],
  height: &[f64, null],
  padding: &Padding,
  font: &[Font, null],
  size: &[f64, null]
};

// A non-null #size must be finite, positive and at most 4096 pixels.
val text_editor: fn(
  ?#placeholder: &string,
  ?#on_edit: [fn(s: string) -> Any, null],
  ?#width: &[f64, null],
  ?#height: &[f64, null],
  ?#padding: &Padding,
  ?#font: &[Font, null],
  ?#size: &[f64, null],
  ?#disabled: &bool,
  content: &string
) -> Widget
