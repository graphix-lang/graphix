let read = 'b: Concrete |input: [string, bytes]| -> Result<'b, [`JsonErr(string), `InvalidCast(string)]> 'json_read;
let write_str = 'a: Data |#pretty: bool = false, value: 'a| -> Result<string, `JsonErr(string)> 'json_write_str;
let write_bytes = 'a: Data |#pretty: bool = false, value: 'a| -> Result<bytes, `JsonErr(string)> 'json_write_bytes
