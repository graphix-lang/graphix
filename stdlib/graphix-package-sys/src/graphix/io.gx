impl Read for Stdio {
    let read = |s, n| 'sys_io_read;
    let read_exact = |s, n| 'sys_io_read_exact
};

impl Lines for Stdio {
    let lines = |s| 'sys_io_lines;
    let lines_batched = |s| 'sys_io_lines_batched
};

impl Write for Stdio {
    let write = |s, data| 'sys_io_write;
    let write_exact = |s, data| 'sys_io_write_exact;
    let flush = |s| 'sys_io_flush
};

impl Close for Stdio { let close = |s| 'sys_io_close };

let stdin = |trigger: Any| -> Stdio 'sys_io_stdin;
let stdout = |trigger: Any| -> Stdio 'sys_io_stdout;
let stderr = |trigger: Any| -> Stdio 'sys_io_stderr
