/// A single-line text editor's state: the text and the cursor's
/// character position within it (0 ..= str::len(value)).
type State = { value: string, cursor: i64 };

/// Fresh editor state holding `initial`, cursor at the end.
val state: fn(initial: string) -> State;

/// Apply one terminal key event to the editor: printable characters
/// insert at the cursor; Backspace and Delete remove; Left, Right,
/// Home, and End move. Returns `Stop for consumed events and
/// `Continue for everything else — call it from an input_handler's
/// handle function, typically as the fallback after the form's own
/// keys (Enter, Tab, Esc) are handled.
val handle: fn(st: &State, e: input_handler::Event) -> [`Stop, `Continue];

/// Render the editor as a Line: the value (each character replaced by
/// `#mask` when given, for secrets) with the cursor cell reverse-video
/// highlighted when `#focused` (the default). An unfocused editor
/// renders without a cursor.
val view: fn(
  ?#mask: [string, null],
  ?#style: [Style, null],
  ?#focused: bool,
  st: &State
) -> Line;
