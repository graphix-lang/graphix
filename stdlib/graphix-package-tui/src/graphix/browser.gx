let browser = |
    #selected_style: Style = style(#bg:`Indexed(20), #fg:`Indexed(227)),
    #header_style: Style = style(#fg:`Indexed(111)),
    #style: Style = style(#fg:`Indexed(227), #bg:`Indexed(234)),
    #cursor: MoveCursor = never(),
    #selected_row: &mut [string, null] = &mut never(),
    #selected_path: &mut [string, null] = &mut never(),
    #flex: Flex = `SpaceBetween,
    #rate: duration = duration:0.5s,
    #size: Size,
    path: string
| -> Tui {
    let selected: {x: i64, y: i64} = { x: 1, y: 0 };
    let viewport: {x: i64, y: i64} = { x: 0, y: 0 };
    let listing = net::list_table(path)$;
    // until a path's first listing arrives the old one stands, and the
    // selection names none of its rows
    let fresh = true;
    fresh <- uniq(path) ~ true;
    fresh <- listing ~ false;
    let restart = select listing ~ fresh {
        true => listing,
        false => never()
    };
    selected <- restart ~ { x: 1, y: 0 };
    viewport <- restart ~ { x: 0, y: 0 };
    let (mode, structure) = select listing {
        { columns, rows: listed } => {
            let mode = uniq(select columns {
                [] => `List,
                _ => `Table
            });
            let columns: Array<string> = select columns {
                [] => ["Value"],
                cols => array::sort(#numeric:true, cols)
            };
            let paths: Array<string> = {
                let base = select str::dirname(listed[0]$) {
                    null as _ => "/",
                    s => s
                };
                let names = array::filter_map(listed, |r| select str::basename(r) {
                    null as _ => null,
                    n => `Keep(n)
                });
                let names = array::sort(#numeric:true, names);
                array::map(names, |name| select base {
                    "/" => "/[name]",
                    base => "[base]/[name]"
                })
            };
            (mode, { columns, rows: paths })
        }
    };
    let row_slots = max(1, size.height - 1);
    // CR claude for claude: [bug/low] The window start is clamped to the last row, not
    // to a full window, and viewport.y itself is never clamped. When the listing
    // shrinks under the same path while scrolled down (or the window grows while at the
    // bottom), only the last row or rows show while every row would fit. Up steps from
    // the stale viewport.y, so several presses change nothing. Clamp to
    // `array::len(structure.rows) - row_slots` and read first_row instead of viewport.y
    // in the Up/Down arms' updates. Fix it together with the column offset in the
    // candidates slice, which has the same flaw. probe:
    // design/review-2026-10-26/repro/gx-ui-browser-shrunk-listing.gx (gx-ui-02)
    // 2026-10-26 claude: Rows done: first_row clamps to len(rows) - row_slots, so a
    // shrunk listing or a grown window shows a full window, and every cursor arm writes
    // the viewport from first_row/first_col, so a stale viewport.y no longer swallows
    // presses. Pin: input_test::a_browser_window_fills_from_a_shrunk_listing (12 rows
    // scrolled to the end, shrunk to 3: shows 3 and two Ups reach r0; the old code
    // showed 1 row and stayed on r2). Remains: the column start clamps only to the last
    // column (gx-ui-01), so after the columns shrink under a scrolled window it shows
    // from that column on although earlier ones might fit; the window's extent is known
    // only after the width fold over first_col.., so a full-window column clamp needs a
    // second (reverse) fold over the widths, and its content widths are indexed by
    // visible slot, not column.
    // 2026-10-28 qwen: Column start now clamps to a full window. browser.gx folds the
    // width twice: window(first) is the fold over columns[first ..] as it was,
    // scrolled_col is the clamped viewport.x, and when window(scrolled_col) ends with
    // room left over — every column from the stale offset already fits — a reverse fold
    // walks the columns before it and takes them in while the room lasts, each charged
    // at its name and the width of the leftmost visible slot, which is the only cost a
    // column that has never been drawn can have. first_col is that start, and the
    // window that is drawn (visible_columns, widths) is folded from it. A start with no
    // room left over is unchanged, so a full 8-column window still starts at 5. Not
    // observable in this sandbox: every browser fixture feeds its listing through
    // sys::net::publish and netidx cannot start here (subscribe answers
    // SubscribeError("loading the netidx config: Operation not permitted"), the
    // resolver server logs Operation not permitted), so all of them time out on a blank
    // render. cargo test -p graphix-package-tui --offline was 144 passed, 8 failed
    // before any change here — every_example_renders and seven browser fixtures, among
    // them a_browser_window_fills_from_a_shrunk_listing, the pin the note above names.
    // It is 144 passed, 9 failed after: the new fixture fails the same blank-render
    // way, and no other test moved. What was checked without a fixture. graphix --check
    // on a program that calls browser compiles this module — proved by planting a type
    // error in the width fold, which --check reported in module tui/browser — so the
    // new code type-checks, and the same check passes on the fixture's own program. The
    // arithmetic ran outside the browser over a fake listing (no netidx): a 24-wide
    // window with 4-wide columns over a listing shrunk to 3 columns and scrolled to its
    // last starts at 0 and shows col0..col2 where the old rule started at 2 and showed
    // col2 alone; 8 columns scrolled to 5 start at 5, unscrolled start at 0, wide
    // columns (nothing fits) keep their start, one column is unchanged. Pin:
    // input_test::a_browser_window_fills_from_shrunk_columns — 8 columns in a 24-wide
    // window, scrolled right, then shrunk to 3: the header's widths plus the selected
    // path must read "3 /local/refill_cols/row0/col2". The old rule reads "1
    // /local/refill_cols/row0/col1". Its expected value is derived from the fold above
    // and was never observed: run it once where netidx works. The neighbouring
    // a_browser_selection_survives_shrunk_columns should be unaffected — its selection
    // lands on the last column under either rule — but it is unrun here too.
    let first_row = max(0, min(array::len(structure.rows) - row_slots, viewport.y));
    let scrolled_col = max(0, min(array::len(structure.columns) - 1, viewport.x));
    let visible_rows = {
        let end = min(array::len(structure.rows), first_row + row_slots);
        (structure.rows)[first_row .. end]$
    };
    // A ring of n slots over a window starting at first: slot k holds the
    // window position p where (first + p) % n == k, so a scroll by one moves
    // one item to another slot and leaves every other where it was.
    let slot_item = |first, n, k| first + ((k - first) % n + n) % n;
    let in_order = |first, len, slots| array::init(len, |p| slots[(first + p) % array::len(slots)]$);
    let content_widths: Array<i64> = [];
    let get_width = |i| select content_widths[i] {
        error as _ => 0,
        w => w
    };
    let name_width = max(4, get_width(0));
    let max_width = size.width / 2;
    let window = |first| {
        let init: { total: i64, cols: Array<string>, widths: Array<Constraint> } = {
            total: size.width - name_width,
            cols: [],
            widths: [`Min(name_width)]
        };
        let candidates = array::enumerate((structure.columns)[first ..]$);
        array::fold(candidates, init, |{total, cols, widths}, (i, col)| {
            let len = min(max_width, max(str::char_len(col), get_width(i + 1)));
            select total {
                x if x > 0 => {
                    total: x - len - 4,
                    cols: array::push(cols, col),
                    widths: array::push(widths, `Min(len))
                },
                x => { total: x - len - 4, cols, widths }
            }
        })
    };
    // What a column costs is only known once it is drawn, so how wide a window
    // is follows from where it starts: a start with room left over takes in the
    // columns before it, at the cost of the slot one of them would land in,
    // until the room is spent.
    let scrolled = window(scrolled_col);
    let first_col = select scrolled.total {
        x if x <= 0 => scrolled_col,
        x => {
            let cost = |c| {
                let col = (structure.columns)[c]$;
                min(max_width, max(str::char_len(col), get_width(1))) + 4
            };
            let back = array::init(scrolled_col, |k| scrolled_col - 1 - k);
            let start = array::fold(
                back,
                { left: x, first: scrolled_col },
                |{left, first}, c| select left {
                    y if y > 0 => { left: y - cost(c), first: c },
                    y => { left: y, first }
                }
            );
            start.first
        }
    };
    let { total: _, cols: visible_columns, widths } = window(first_col);
    let visible_columns: Array<string> = uniq(visible_columns);
    let sel = {
        x: max(1, min(array::len(visible_columns), selected.x)),
        y: max(0, min(array::len(visible_rows) - 1, selected.y))
    };
    let row_path: [string, null] = select visible_rows[sel.y] {
        error as _ => null,
        r => r
    };
    let cell_path: [string, null] = select row_path {
        null as n => n,
        r => select mode {
            `List => r,
            `Table => "[r]/[visible_columns[sel.x - 1]$]"
        }
    };
    *selected_row <- select fresh {
        false => row_path,
        true => never()
    };
    *selected_path <- select fresh {
        false => cell_path,
        true => never()
    };
    let header = select mode {
        `List => row(#style:header_style, [cell(line("Name")), cell(line("Value"))]),
        `Table => {
            let cols = array::map(visible_columns, |col| cell(line(col)));
            row(#style:header_style, array::push_front(cols, cell(line("Name"))))
        }
    };
    let row_cells = array::map(array::init(row_slots, |k| k), |k|
        select (structure.rows)[slot_item(first_row, row_slots, k)] {
            error as _ => [],
            row => {
                let name = select str::basename(row) { null as _ => "", s => s };
                select mode {
                    `List => {
                        let v: Result<PrimNoErr, [`InvalidCast(string), `SubscribeError(string)]> =
                            throttle(#rate, net::subscribe(row));
                        [name, "[any(uniq(row) ~ "#SUB", v)]"]
                    },
                    `Table => {
                        let col_slots = array::len(visible_columns);
                        let a = array::map(array::init(col_slots, |c| c), |c| {
                            let col = (structure.columns)[slot_item(first_col, col_slots, c)]$;
                            let path = "[row]/[col]";
                            let v: Result<PrimNoErr, [`InvalidCast(string), `SubscribeError(string)]> =
                                throttle(#rate, net::subscribe(path));
                            "[any(uniq(path) ~ "#SUB", v)]"
                        });
                        array::push_front(in_order(first_col, col_slots, a), name)
                    }
                }
            }
        });
    let cells = in_order(first_row, array::len(visible_rows), row_cells);
    content_widths <- array::fold(throttle(#rate:duration:1.0s, cells), [], |acc, row| {
            let row = array::map(row, |s| select s {
                "#SUB" => 0,
                s => str::char_len(s)
            });
            select acc {
                [] => row,
                acc => array::map(array::zip(row, acc), |(l0, l1)| max(l0, l1))
            }
        });
    let rows = array::map(cells, |row|
        &tui::table::row(array::map(array::enumerate(row), |(i, s)| select i {
            0 => cell(#style:header_style, line(s)),
            _ => cell(line(s))
        })));
    select cursor {
        `Left(n) => select n ~ sel.x {
            e if e <= 1 => viewport <- e ~ { x: max(0, first_col - n), y: first_row },
            e => selected <- e ~ { sel with x: max(1, sel.x - n) }
        },
        `Right(n) => {
            let clim = array::len(structure.columns) - array::len(visible_columns);
            select n ~ (sel.x, array::len(visible_columns)) {
                (x, limit) if x >= limit =>
                    viewport <- x ~ { x: min(clim, first_col + n), y: first_row },
                (x, limit) => selected <- x ~ { sel with x: min(limit, sel.x + n) }
            }
        },
        `Down(n) => {
            let rlim = array::len(structure.rows) - array::len(visible_rows);
            select n ~ (sel.y, array::len(visible_rows) - 1) {
                (y, limit) if y >= limit =>
                    viewport <- y ~ { x: first_col, y: min(rlim, first_row + n) },
                (y, limit) => selected <- y ~ { sel with y: min(limit, sel.y + n) }
            }
        },
        `Up(n) => select n ~ sel.y {
            y if y <= 0 => viewport <- y ~ { x: first_col, y: max(0, first_row - n) },
            y => selected <- y ~ { sel with y: max(0, sel.y - n) }
        }
    };
    table(
        #cell_highlight_style:&selected_style,
        #header:&header,
        #widths:&widths,
        #flex:&flex,
        #selected_cell: &sel,
        #style:&style,
        &rows
    )
}
