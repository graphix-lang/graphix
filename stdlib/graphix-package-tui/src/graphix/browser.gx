let browser = |
    #selected_style: Style = style(#bg:`Indexed(20), #fg:`Indexed(227)),
    #header_style: Style = style(#fg:`Indexed(111)),
    #style: Style = style(#fg:`Indexed(227), #bg:`Indexed(234)),
    #cursor: MoveCursor = never(),
    #selected_row: &mut string = &mut never(),
    #selected_path: &mut string = &mut never(),
    #flex: Flex = `SpaceBetween,
    #rate: duration = duration:0.5s,
    #size: Size,
    path: string
| -> Tui {
    let selected: {x: i64, y: i64} = { x: 1, y: 0 };
    let viewport: {x: i64, y: i64} = { x: 0, y: 0 };
    select uniq(path) {
        p => {
            selected <- p ~ { x: 1, y: 0 };
            viewport <- p ~ { x: 0, y: 0 }
        }
    };
    let (mode, structure) = select net::list_table(path)$ {
        { columns, rows: listed } => {
            let mode = uniq(select columns {
                [] => `List,
                _ => `Table
            });
            let columns: Array<string> = select columns {
                [] => ["Value"],
                cols => array::sort(#numeric:true, cols)
            };
            let paths: Array<string> = {
                let base = select str::dirname(listed[0]$) {
                    null as _ => "/",
                    s => s
                };
                let names = array::filter_map(listed, |r| str::basename(r));
                let names = array::sort(#numeric:true, names);
                array::map(names, |name| select base {
                    "/" => "/[name]",
                    base => "[base]/[name]"
                })
            };
            (mode, { columns, rows: paths })
        }
    };
    let row_slots = max(1, size.height - 1);
    let first_row = max(0, min(array::len(structure.rows) - 1, viewport.y));
    let visible_rows = {
        let end = min(array::len(structure.rows), first_row + row_slots);
        (structure.rows)[first_row .. end]$
    };
    // A ring of n slots over a window starting at first: slot k holds the
    // window position p where (first + p) % n == k, so a scroll by one moves
    // one item to another slot and leaves every other where it was.
    let slot_item = |first, n, k| first + ((k - first) % n + n) % n;
    let in_order = |first, len, slots| array::init(len, |p| slots[(first + p) % array::len(slots)]$);
    let content_widths: Array<i64> = [];
    let get_width = |i| select content_widths[i] {
        error as _ => 0,
        w => w
    };
    let { total: _, cols: visible_columns, widths }:
        { total: i64, cols: Array<string>, widths: Array<Constraint> } = {
        let name_width = max(4, get_width(0));
        let max_width = size.width / 2;
        let init = {
            total: size.width - name_width,
            cols: [],
            widths: [`Min(name_width)]
        };
        let candidates = array::enumerate((structure.columns)[viewport.x ..]$);
        array::fold(candidates, init, |{total, cols, widths}, (i, col)| {
            let len = min(max_width, max(str::char_len(col), get_width(i + 1)));
            select total {
                x if x > 0 => {
                    total: x - len - 4,
                    cols: array::push(cols, col),
                    widths: array::push(widths, `Min(len))
                },
                // CR claude for claude: [bug/medium] gx-ui-03 still reproduces: tui browser
                // publishes a row of the old listing on navigation. Part B of gx-ui-03 is
                // unfixed (part A, selected_path without #selected_row, is fixed). On a
                // path change, `selected <- p ~ {x: 1, y: 0}` lands while
                // `structure`/`visible_rows` still hold the previous path's listing. So
                // `row_path = visible_rows[selected.y]$` takes row 0 of the old listing,
                // and `*selected_row <- row_path` / `*selected_path <- ...` publish a path
                // the user never selected. When the new listing is empty,
                // `visible_rows[0]$` is bottom, so nothing overwrites that stale value. The
                // outputs keep naming a row of the previous listing, and a caller that
                // navigates on Enter goes there. Whether it happens depends on whether the
                // reset or the new listing arrives first (7-8 of every 10 B lines in 3 of 4
                // runs; 0 in one --no-fusion run). Failure: Publish /p/d/w and /p/d/x,
                // browse /p/d, move the cursor down to /p/d/x and enter it (its listing is
                // empty). The outputs switch to selected_row=/p/d/w selected_path=/p/d/w
                // and stay there; the next Enter navigates to /p/d/w. Fix: Key the listing
                // to the path it lists (carry `path` with the list_table result and drop it
                // unless it equals the current path). Reset `selected` when the new listing
                // arrives, not when the path changes. Keep the stale-read guard so no row
                // path is published while the listing is empty. Unverified: the reviewer's
                // report, not checked by a verifier. (x-rerun-4-02)
                x => { total: x - len - 4, cols, widths }
            }
        })
    };
    let visible_columns: Array<string> = uniq(visible_columns);
    let row_path = visible_rows[selected.y]$;
    // CR claude for claude: [bug/medium] selected_row and selected_path report rows
    // that are not on screen. The selection reset `selected <- p ~ {..}` fires on the
    // path, but `structure` still holds the old listing until net::list_table answers.
    // So for one cycle row_path is row 0 of the previous directory, and that row is
    // written to both outputs. When the new listing is empty (a leaf, an unpublished
    // path, or a list error), `visible_rows[selected.y]$` is bottom and nothing is
    // written. The caller then keeps a row of the previous directory, and netidx-tools'
    // browser `:w` and Enter act on it. Fix: reset the selection when the new listing
    // arrives (trigger it on `structure`, not on `path`). Also make both outputs `&mut
    // [string, null]` (the .gxi and the callers too), and write null when visible_rows
    // is empty. probe: design/review-2026-10-12/repro/gx-ui-03.gx (gx-ui-03)
    *selected_row <- row_path;
    *selected_path <- select mode {
        `List => row_path,
        `Table => "[row_path]/[visible_columns[selected.x - 1]$]"
    };
    let header = select mode {
        `List => row(#style:header_style, [cell(line("Name")), cell(line("Value"))]),
        `Table => {
            let cols = array::map(visible_columns, |col| cell(line(col)));
            row(#style:header_style, array::push_front(cols, cell(line("Name"))))
        }
    };
    let row_cells = array::map(array::init(row_slots, |k| k), |k|
        select (structure.rows)[slot_item(first_row, row_slots, k)] {
            error as _ => [],
            row => {
                let name = select str::basename(row) { null as _ => "", s => s };
                select mode {
                    `List => {
                        let v: Result<Primitive, [`InvalidCast(string), `SubscribeError(string)]> =
                            throttle(#rate, net::subscribe(row));
                        [name, "[any(uniq(row) ~ "#SUB", v)]"]
                    },
                    `Table => {
                        let col_slots = array::len(visible_columns);
                        let a = array::map(array::init(col_slots, |c| c), |c| {
                            let col = (structure.columns)[slot_item(viewport.x, col_slots, c)]$;
                            let path = "[row]/[col]";
                            let v: Result<Primitive, [`InvalidCast(string), `SubscribeError(string)]> =
                                throttle(#rate, net::subscribe(path));
                            "[any(uniq(path) ~ "#SUB", v)]"
                        });
                        array::push_front(in_order(viewport.x, col_slots, a), name)
                    }
                }
            }
        });
    let cells = in_order(first_row, array::len(visible_rows), row_cells);
    // CR claude for claude: [perf/low] The throttle sits on the fold's output, so the
    // fold over every visible cell (an array::map and an array::zip per row, all
    // allocating) runs in every cycle in which any cell delivers, and the throttle
    // discards nearly all of the results. With a large live table that is O(rows x
    // cols) work per cell update for a value used at most once a second. Throttle the
    // input instead, so the fold runs at most once a second: fold over `throttle(#rate:
    // duration:1.0s, cells)`. (gx-ui-09)
    content_widths <- throttle(#rate:duration:1.0s,
        array::fold(cells, [], |acc, row| {
            let row = array::map(row, |s| select s {
                "#SUB" => 0,
                s => str::char_len(s)
            });
            select acc {
                [] => row,
                acc => array::map(array::zip(row, acc), |(l0, l1)| max(l0, l1))
            }
        }));
    let rows = array::map(cells, |row|
        &tui::table::row(array::map(array::enumerate(row), |(i, s)| select i {
            0 => cell(#style:header_style, line(s)),
            _ => cell(line(s))
        })));
    select cursor {
        `Left(n) => select n ~ selected.x {
            e if e <= 1 =>
                viewport <- uniq(e ~ { viewport with x: max(0, viewport.x - n) }),
            e => selected <- e ~ { selected with x: max(1, selected.x - n) }
        },
        `Right(n) => {
            let limit = array::len(visible_columns);
            let clim = array::len(structure.columns) - array::len(visible_columns);
            select n ~ selected.x {
                x if x >= limit =>
                    viewport <- uniq(x ~ { viewport with x: min(clim, viewport.x + n) }),
                e => selected <- e ~ {selected with x: min(limit, selected.x + n)}
            }
        },
        `Down(n) => {
            let rlim = array::len(structure.rows) - array::len(visible_rows);
            let limit = array::len(visible_rows) - 1;
            select n ~ selected.y {
                x if x >= limit =>
                    viewport <- uniq(x ~ { viewport with y: min(rlim, viewport.y + n) }),
                e => selected <- e ~ { selected with y: min(limit, selected.y + n) }
            }
        },
        `Up(n) => select n ~ selected.y {
            y if y <= 0 =>
                viewport <- uniq(y ~ { viewport with y: max(0, viewport.y - n) }),
            y => selected <- y ~ { selected with y: max(0, selected.y - n) }
        }
    };
    table(
        #cell_highlight_style:&selected_style,
        #header:&header,
        #widths:&widths,
        #flex:&flex,
        #selected_cell: &selected,
        #style:&style,
        &rows
    )
}
