use super::{Constraint, Flex, line, Size, Style, style, Tui};
use sys::net;
use tui::table::{cell, row, table};

type MoveCursor = [
    `Left(i64),
    `Right(i64),
    `Up(i64),
    `Down(i64)
];

// CR claude for claude: [doc-drift/low] The doc says the listing is fetched once each
// time `path` changes, and that rows published later appear only when the path changes.
// browser calls net::list_table(path) with its default #update, which is a one-second
// repeating timer, so the listing refreshes about once a second and new rows appear on
// the next refresh. Rewrite the sentence to say that. (gx-ui-05)
/// A netidx browser over `path`: a table of its children, with one
/// column per published column when the children are rows of a table.
/// The listing is fetched once each time `path` changes, so rows
/// published later appear when the path next changes.
/// `#size` is the area the browser is drawn in, which sizes its
/// viewport (pass the enclosing block's `#size` output); `#cursor`
/// moves the selection. `#selected_row` is set to the selected row's
/// full path, and `#selected_path` to the selected cell's.
val browser: fn(
    ?#selected_style: Style,
    ?#header_style: Style,
    ?#style: Style,
    ?#cursor: MoveCursor,
    ?#selected_row: &mut string,
    ?#selected_path: &mut string,
    ?#flex: Flex,
    ?#rate: duration,
    #size: Size,
    path: string
) -> Tui;
