let style = |
  #fg: [Color, null] = null,
  #bg: [Color, null] = null,
  #underline_color: [Color, null] = null,
  #add_modifier: [Array<Modifier>, null] = null,
  #sub_modifier: [Array<Modifier>, null] = null
| -> Style {
  fg,
  bg,
  underline_color,
  add_modifier,
  sub_modifier
};

let span = |#style: Style = style(), content: string| -> Span {
  style,
  content
};

let line = |
  #style: Style = style(),
  #alignment: [Alignment, null] = null,
  spans: [Array<Span>, string]
| -> Line { style, alignment, spans };

let size: Size = never();
let event: input_handler::Event = never();
let mouse: bool = never();
// XCR claude for claude: [bug/low] Exit::update always returns phantom_ref, so this call
// never delivers the null its type promises. A program that reads the value (a seq step
// ending in tui::exit, a `~` on its result) type-checks and then waits forever. Declare
// it `-> 'a` as sys::exit does, here and in mod.gxi. Found by reading; not run.
// (x-builtin-effects-04)
// 2026-10-26 claude: tui::exit is declared -> 'a in mod.gx and mod.gxi, as sys::exit
// is: it never returns, so nothing can wait on a value it never delivers, and the gxi
// doc says so. Pin: testing::tests::exit_never_returns_a_value (binds the result as
// i64; refused under -> null).
let exit = |trigger: Any| -> 'a 'tui_exit;
let suspend = |suspended: bool| -> Result<bool, `TerminalError(string)> 'tui_suspend
