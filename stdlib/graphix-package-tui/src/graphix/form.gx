use super::{
  line, line_edit, style,
  block::block,
  layout::{child, layout},
  paragraph::paragraph,
  text::text
};

let form = |
  #title: string,
  #help: [string, null] = null,
  #hint: [string, null] = null,
  #on_submit: fn(values: Array<string>) -> null,
  #on_cancel: [fn(e: Any) -> null, null] = null,
  fields: Array<Field>
| -> Form {
  let dim = style(#fg: `DarkGray);
  let n = array::len(fields);
  let vals: Array<line_edit::State> = array::map(fields, |f: Field| line_edit::state(f.value));
  let focus = 0;
  focus <- fields ~ 0;
  let handle = |e: input_handler::Event| input_handler::on_press(e, |k| select k.code {
    `Tab | `Down if n > 0 => { focus <- k ~ (focus + 1) % n; `Stop },
    `BackTab | `Up if n > 0 => { focus <- k ~ (focus + n - 1) % n; `Stop },
    kk@ `Enter => {
      on_submit(kk ~ array::map(vals, |v: line_edit::State| v.value));
      `Stop
    },
    // CR claude for claude: [bug/low] When #on_cancel is null, Esc still answers `Stop:
    // the key is consumed, nothing happens, and an enclosing handler never sees it. The
    // default #hint legend nevertheless advertises 'Esc cancel', so a form on an
    // overlay layer built without on_cancel cannot be dismissed with Esc. Answer
    // `Continue for Esc when on_cancel is null, so the caller's handler can close the
    // layer, or make #on_cancel required. (gx-ui-08)
    kk@ `Esc => {
      select kk ~ on_cancel {
        null as _ => never(),
        f => f(kk)
      };
      `Stop
    },
    _ => {
      let i = k ~ focus;
      select vals[i] {
        error as _ => `Continue,
        _ => line_edit::handle(&mut vals[i], e)
      }
    }
  });
  let width = array::fold(fields, 0, |w: i64, f: Field| max(w, str::char_len(f.label))) + 2;
  let rows = array::map(array::enumerate(vals), |(j, st): (i64, line_edit::State)| {
    let label = (fields[j]$).label;
    child(#constraint: `Length(1), layout(#direction: &`Horizontal, &[
      child(#constraint: `Length(width), text(&[line(#style: dim, "[label]:")])),
      child(#constraint: `Min(1), text(&[line_edit::view(#focused: j == focus, &st)]))
    ]))
  });
  let help_rows = select help {
    null as _ => [],
    h => [child(#constraint: `Length(2), paragraph(#style: &dim, &h))]
  };
  let legend = select hint {
    null as _ => " Tab next field · Enter submit · Esc cancel ",
    h => h
  };
  let view = block(
    #border: &`All,
    #title: &line(title),
    #title_bottom: &line(#style: dim, legend),
    &layout(#direction: &`Vertical, &array::concat(help_rows, rows))
  );
  { view, handle }
}
