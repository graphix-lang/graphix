use super::{
  line, line_edit, style,
  block::block,
  layout::{child, layout},
  paragraph::paragraph,
  text::text
};

let form = |
  #title: string,
  #help: [string, null] = null,
  #hint: [string, null] = null,
  #on_submit: fn(values: Array<string>) -> null,
  #on_cancel: [fn(e: Any) -> null, null] = null,
  fields: Array<Field>
| -> Form {
  let dim = style(#fg: `DarkGray);
  let n = array::len(fields);
  let vals: Array<line_edit::State> = array::map(fields, |f: Field| line_edit::state(f.value));
  let focus = 0;
  focus <- fields ~ 0;
  let handle = |e: input_handler::Event| input_handler::on_press(e, |k| select k.code {
    // CR claude for eric: [bug] Only the left operand is sampled, so `% n` makes `n` a
    // trigger of this arm and of the BackTab/Up arm below, and `n` fires on every
    // `fields` delivery. The handler keeps its last arm between keys. So after
    // Tab/Down/BackTab/Up, a re-seed writes the focus sampled at that key right after
    // `focus <- fields ~ 0`, and the re-seeded form stays on the old field. After any
    // other key it starts at field 0, which is what form.gxi promises. Write `focus <-
    // k ~ (focus + 1) % n` and `focus <- k ~ (focus + n - 1) % n`; nothing tests
    // tui::form. probe: design/review-2026-10-05/repro/gx-ui-04.gx prints ["", "x",
    // ""], expected ["x", "", ""]. (gx-ui-04)
    `Tab | `Down => { focus <- (k ~ focus + 1) % n; `Stop },
    `BackTab | `Up => { focus <- (k ~ focus + n - 1) % n; `Stop },
    kk@ `Enter => {
      on_submit(kk ~ array::map(vals, |v: line_edit::State| v.value));
      `Stop
    },
    kk@ `Esc => {
      select kk ~ on_cancel {
        null as _ => never(),
        f => f(kk)
      };
      `Stop
    },
    // CR claude for eric: [bug] With no fields this arm never answers. vals[0] does not
    // exist, so line_edit::handle's `e ~ *st` waits forever, and the handler produces
    // nothing for any key the form does not take itself. InputHandlerW
    // (tui/src/input_handler.rs:399-460) sends the next event only after an answer, so
    // from that key on every key queues, Esc and Enter included; only Ctrl+C, which
    // ends the program, still works. Tab's `% n` also divides by zero there. Answer
    // `Continue when focus has no editor, e.g. `select vals[i] { error as _ =>
    // `Continue, _ => line_edit::handle(&vals[i], e) }`. probe:
    // design/review-2026-10-05/repro/gx-ui-11.gx (gx-ui-11)
    _ => {
      let i = k ~ focus;
      line_edit::handle(&vals[i], e)
    }
  });
  let width = array::fold(fields, 0, |w: i64, f: Field| max(w, str::len(f.label))) + 2;
  let rows = array::map(array::enumerate(vals), |(j, st): (i64, line_edit::State)| {
    let label = (fields[j]$).label;
    child(#constraint: `Length(1), layout(#direction: &`Horizontal, &[
      child(#constraint: `Length(width), text(&[line(#style: dim, "[label]:")])),
      child(#constraint: `Min(1), text(&[line_edit::view(#focused: j == focus, &st)]))
    ]))
  });
  let help_rows = select help {
    null as _ => [],
    h => [child(#constraint: `Length(2), paragraph(#style: &dim, &h))]
  };
  let legend = select hint {
    null as _ => " Tab next field · Enter submit · Esc cancel ",
    h => h
  };
  let view = block(
    #border: &`All,
    #title: &line(title),
    #title_bottom: &line(#style: dim, legend),
    &layout(#direction: &`Vertical, &array::concat(help_rows, rows))
  );
  { view, handle }
}
