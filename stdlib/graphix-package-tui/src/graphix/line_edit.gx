let state = |initial: string| -> State {
    value: initial,
    // CR claude for eric: [bug] The cursor is a char position (one step per `Char,
    // sliced with str::sub's char indexes), but it is set and bounded by str::len,
    // which counts bytes. The same mistake is in step's Backspace, Delete, Right and
    // End arms and in view's mask and cursor cell. On text holding a non-ASCII char the
    // cursor starts and ends past the last char, so Backspace after End deletes nothing
    // once per extra byte, the cursor cell renders empty, and a mask shows one glyph
    // per byte. The str package has no char count; today it is spelled
    // array::len(str::split(#pat: "", s)) - 2. A char-count builtin is needed here, in
    // netidx-admin's tui/remote.gx:39, and in the browser_commands example's backspace
    // (a no-op on any command holding a non-ASCII char) and text_editor's "characters"
    // label. probe: design/review-2026-10-05/repro/collections-str-07.gx
    // (collections-str-07)
    cursor: str::len(initial)
};

let step = |st: State, e: input_handler::Event| -> [State, null] select e {
    `Key(k) => select k.kind {
        `Press => select k.code {
            // CR claude for eric: [bug] This arm inserts every Char key, whatever
            // k.modifiers holds. crossterm reports Ctrl+U as Char("u") with [`Control]
            // and Alt+B as Char("b") with [`Alt], and only Ctrl+C is taken in Rust
            // (tui/src/lib.rs:676). So a chord types its letter into the field: form.gx
            // sends every key it does not take to the focused editor, and
            // netidx-admin's line prompts do the same. Insert only when the modifiers
            // hold nothing but `Shift, and return null otherwise so handle answers
            // `Continue. Windows reports an AltGr character with Control+Alt, so handle
            // that pair deliberately. probe: design/review-2026-10-05/repro/gx-ui-10.gx
            // (gx-ui-10)
            `Char(ch) => {
                let n = str::len(st.value);
                {
                    value: "[str::sub(#start:0, #len:st.cursor, st.value)$][ch][str::sub(#start:st.cursor, #len:n - st.cursor, st.value)$]",
                    cursor: st.cursor + 1
                }
            },
            `Backspace => {
                let n = str::len(st.value);
                select st.cursor {
                    cur if cur > 0 => {
                        value: "[str::sub(#start:0, #len:cur - 1, st.value)$][str::sub(#start:cur, #len:n - cur, st.value)$]",
                        cursor: cur - 1
                    },
                    _ => st
                }
            },
            `Delete => {
                let n = str::len(st.value);
                select st.cursor {
                    cur if cur < n => {
                        st with value: "[str::sub(#start:0, #len:cur, st.value)$][str::sub(#start:cur + 1, #len:n - cur - 1, st.value)$]"
                    },
                    _ => st
                }
            },
            `Left => { st with cursor: max(0, st.cursor - 1) },
            `Right => { st with cursor: min(str::len(st.value), st.cursor + 1) },
            `Home => { st with cursor: 0 },
            `End => { st with cursor: str::len(st.value) },
            _ => null
        },
        _ => null
    },
    _ => null
};

let handle = |st: &mut State, e: input_handler::Event| -> [`Stop, `Continue]
    select step(e ~ *st, e) {
        null as _ => `Continue,
        s => { *st <- s; `Stop }
    };

let view = |
    #mask: [string, null] = null,
    #style: [Style, null] = null,
    #focused: bool = true,
    st: &State
| -> Line {
    let s = *st;
    let shown = select mask {
        null as _ => s.value,
        m => {
            let n = str::len(s.value);
            select n {
                0 => "",
                _ => str::join(#sep: "", array::init(n, |_| m))
            }
        }
    };
    let base = select style {
        null as _ => tui::style(),
        st => st
    };
    let cursor_style = tui::style(#add_modifier: [`Reversed]);
    select focused {
        false => line(#style: base, shown),
        true => {
            let n = str::len(shown);
            let cur = min(s.cursor, n);
            let before = str::sub(#start: 0, #len: cur, shown)$;
            let at = select cur {
                c if c < n => str::sub(#start: c, #len: 1, shown)$,
                _ => " "
            };
            let after = select cur {
                c if c < n => str::sub(#start: c + 1, #len: n - c - 1, shown)$,
                _ => ""
            };
            line(#style: base, [
                span(before),
                span(#style: cursor_style, at),
                span(after)
            ])
        }
    }
};
