let state = |initial: string| -> State {
    value: initial,
    cursor: str::char_len(initial)
};

let insert = |st: State, text: string| -> State {
    let n = str::char_len(st.value);
    {
        value: "[str::sub(#start:0, #len:st.cursor, st.value)$][text][str::sub(#start:st.cursor, #len:n - st.cursor, st.value)$]",
        cursor: st.cursor + str::char_len(text)
    }
};

// A key that types its character: no modifier but Shift, or Control+Alt,
// which is how Windows reports AltGr.
let types = |mods: Array<input_handler::KeyModifier>| -> bool {
    let only = |allowed: fn(m: input_handler::KeyModifier) -> bool|
        array::len(array::filter(mods, |m| !allowed(m))) == 0;
    let has = |m: input_handler::KeyModifier| opt::is_some(array::find(mods, |x| x == m));
    only(|m| select m { `Shift => true, _ => false })
        || (has(`Control) && has(`Alt)
            && only(|m| select m { `Shift | `Control | `Alt => true, _ => false }))
};

let step = |st: State, e: input_handler::Event| -> [State, null] select e {
    `Paste(text) => insert(st, str::replace(#pat: "\n", #rep: " ", text)),
    `Key(k) => select k.kind {
        `Press => select k.code {
            `Char(ch) if types(k.modifiers) => insert(st, ch),
            `Backspace => {
                let n = str::char_len(st.value);
                select st.cursor {
                    cur if cur > 0 => {
                        value: "[str::sub(#start:0, #len:cur - 1, st.value)$][str::sub(#start:cur, #len:n - cur, st.value)$]",
                        cursor: cur - 1
                    },
                    _ => st
                }
            },
            `Delete => {
                let n = str::char_len(st.value);
                select st.cursor {
                    cur if cur < n => {
                        st with value: "[str::sub(#start:0, #len:cur, st.value)$][str::sub(#start:cur + 1, #len:n - cur - 1, st.value)$]"
                    },
                    _ => st
                }
            },
            `Left => { st with cursor: max(0, st.cursor - 1) },
            `Right => { st with cursor: min(str::char_len(st.value), st.cursor + 1) },
            `Home => { st with cursor: 0 },
            `End => { st with cursor: str::char_len(st.value) },
            _ => null
        },
        _ => null
    },
    _ => null
};

let handle = |st: &mut State, e: input_handler::Event| -> [`Stop, `Continue]
    select step(e ~ *st, e) {
        null as _ => `Continue,
        s => { *st <- s; `Stop }
    };

let view = |
    #mask: [string, null] = null,
    #style: [Style, null] = null,
    #focused: bool = true,
    st: &State
| -> Line {
    let s = *st;
    let shown = select mask {
        null as _ => s.value,
        m => {
            let n = str::char_len(s.value);
            select n {
                0 => "",
                _ => str::join(#sep: "", array::init(n, |_| m))
            }
        }
    };
    let base = select style {
        null as _ => tui::style(),
        st => st
    };
    let cursor_style = tui::style(#add_modifier: [`Reversed]);
    select focused {
        false => line(#style: base, shown),
        true => {
            let n = str::char_len(shown);
            let cur = min(s.cursor, n);
            let before = str::sub(#start: 0, #len: cur, shown)$;
            let at = select cur {
                c if c < n => str::sub(#start: c, #len: 1, shown)$,
                _ => " "
            };
            let after = select cur {
                c if c < n => str::sub(#start: c + 1, #len: n - c - 1, shown)$,
                _ => ""
            };
            line(#style: base, [
                span(before),
                span(#style: cursor_style, at),
                span(after)
            ])
        }
    }
};
