let read = 'b: Concrete |input: [string, bytes]| -> Result<'b, [`TomlErr(string), `InvalidCast(string)]> 'toml_read;
let write_str = 'a: Data |#pretty: bool = false, value: 'a| -> Result<string, `TomlErr(string)> 'toml_write_str;
let write_bytes = 'a: Data |#pretty: bool = false, value: 'a| -> Result<bytes, `TomlErr(string)> 'toml_write_bytes
