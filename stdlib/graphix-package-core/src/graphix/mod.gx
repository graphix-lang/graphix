let all = |@args: Any| -> Any 'core_all;
let and = |@args: bool| -> bool 'core_and;
let count = |x: Any| -> i64 'core_count;
// CR claude for eric: [bug] divide, product and sum (lines 23-24, mod.gxi:123/181/184)
// are typed `-> Number`, but their builtins (lib.rs DivideEv/ProductEv/SumEv) return
// netidx's `Value::Error` when the arithmetic fails. `divide(1, 0)` gives
// `error:"arithmetic error"`, and a decimal overflow in sum or product gives
// `error:"decimal arithmetic error"`. The checker treats the result as error-free, so
// `divide(1, z)?` and an `error as e` arm are refused, and an exhaustive `select n {
// Int as _ => .., Real as _ => .. }` bottoms with no message. A caller has to cast a
// `Number` before any arithmetic (`sum(1, 2) + 1` is refused), and the cast turns the
// error into 0: `cast<i64>(divide(10, z))$ + 1` is 1. Either log and bottom like the
// `/` operator does (node/op.rs:784), or declare the error in the type. probe:
// design/review-2026-10-05/repro/x-builtin-effects-10.gx (x-builtin-effects-10)
let divide = |@args: [Number, Array<[Number, Array<Number>]>]| -> Number 'core_divide;
let filter_err = |e: Result<'a, 'b>| -> Error<'b> 'core_filter_err;
let filter = |v: 'a, f: fn(v: 'a) -> bool throws 'e| -> 'a throws 'e 'core_filter;
let is_err = |e: Any| -> bool 'core_is_err;
let error = |e: 'a| -> Error<'a> 'core_error;
let max = |a: 'a, @args: 'a| -> 'a 'core_max;
let mean = |v: [Number, Array<Number>], @args: [Number, Array<Number>]| -> Result<f64, `MeanError(string)> 'core_mean;
let min = |a: 'a, @args: 'a| -> 'a 'core_min;
let once = |v: 'a| -> 'a 'core_once;
// CR claude for eric: [risk] #n is typed Any and the builtins read it with
// cast_to::<usize>, so any value type-checks and nothing is reported: a value that does
// not cast ("x", null) leaves n None, so take never emits and skip passes everything; a
// negative i64 wraps to a huge count, so take(#n: -1, x) passes everything and skip(#n:
// -3, x) swallows everything; [1, 2], "2" and 2.7 pass as counts through netidx's
// casts. Type #n as an integer here and in mod.gxi (i64, or 'n: Int) and give a
// negative count a rule in Take/Skip (0). probe:
// design/review-2026-10-05/repro/core-lib-15.gx (core-lib-15)
let take = |#n: Any, e: 'a| -> 'a 'core_take;
let skip = |#n: Any, e: 'a| -> 'a 'core_skip;
let range = |i: i64, j: i64| -> Result<i64, `RangeError(string)> 'core_seq;
let or = |@args: bool| -> bool 'core_or;
let bit_and = 'a: Int |a: 'a, b: 'a| -> 'a 'core_bit_and;
let bit_or = 'a: Int |a: 'a, b: 'a| -> 'a 'core_bit_or;
let bit_xor = 'a: Int |a: 'a, b: 'a| -> 'a 'core_bit_xor;
let bit_not = 'a: Int |a: 'a| -> 'a 'core_bit_not;
let shl = 'a: Int |a: 'a, b: 'a| -> 'a 'core_shl;
let shr = 'a: Int |a: 'a, b: 'a| -> 'a 'core_shr;
let product = |@args: [Number, Array<[Number, Array<Number>]>]| -> Number 'core_product;
let sum = |@args: [Number, Array<[Number, Array<Number>]>]| -> Number 'core_sum;
let uniq = |v: 'a| -> 'a 'core_uniq;
let queue = |#clock: Any, #flush: Any = null, v: 'a| -> 'a 'core_queue;
let queuefn = 'a: Function |#count: &[i64, null] = &null, #trigger: Any, f: 'a| -> 'a 'core_queuefn;
let hold = |#clock: Any, v: 'a| -> 'a 'core_hold;
let dbg = |#dest: [`Stdout, `Stderr, Log] = `Stderr, v: 'a| -> 'a 'core_dbg;
let log = |#dest: Log = `Stdout, msg: 'a| -> null 'core_log;
let print = |#dest: Log = `Stdout, msg: 'a| -> null 'core_print;
let println = |#dest: Log = `Stdout, msg: 'a| -> null 'core_println;
let throttle = |#rate: duration = duration:0.5s, v: 'a| -> 'a 'core_throttle;

let map_union = |a: Map<'k, 'v>, b: Map<'k, 'v>| -> Map<'k, 'v> 'core_map_union;
let map_pairs = |m: Map<'k, 'v>, f: fn(kv: ('k, 'v)) -> ('k2, 'v2) throws 'e| -> Map<'k2, 'v2> throws 'e 'map_map;
let filter_map_pairs = |m: Map<'k, 'v>, f: fn(kv: ('k, 'v)) -> Option<('k2, 'v2)> throws 'e| -> Map<'k2, 'v2> throws 'e 'map_filter_map;
let fold_pairs = |m: Map<'k, 'v>, init: 'b, f: fn(acc: 'b, kv: ('k, 'v)) -> 'b throws 'e| -> 'b throws 'e 'map_fold;

impl Collection for Array<'_> {
    let fold = |a, init, f| 'array_fold;
    let filter_map = |a, f| 'array_filter_map;
    let flat_map = |a, f| 'array_flat_map;
    let map = |a, f| 'array_map;
    let filter = |a, f| 'array_filter;
    let find = |a, f| 'array_find;
    let find_map = |a, f| 'array_find_map;
    let len = |a| 'core_array_len
};

impl<'k> Collection for Map<'k, '_> {
    let fold = |m, init, f| fold_pairs(m, init, |acc, (_, v)| f(acc, v));
    let filter_map = |m, f| filter_map_pairs(m, |(k, v)| select f(v) { null as _ => null, r => (k, r) });
    let flat_map = |m, f| fold_pairs(m, {}, |acc, (_, v)| map_union(acc, f(v)));
    let map = |m, f| map_pairs(m, |(k, v)| (k, f(v)));
    let len = |m| 'core_map_len
};

impl Collection for List<'_> {
    let fold = |l, init, f| 'list_fold;
    let filter_map = |l, f| 'list_filter_map;
    let flat_map = |l, f| 'list_flat_map;
    let map = |l, f| 'list_map;
    let filter = |l, f| 'list_filter;
    let find = |l, f| 'list_find;
    let find_map = |l, f| 'list_find_map
}
