let is_some = |v: ['a, null]| -> bool 'core_opt_is_some;
let is_none = |v: ['a, null]| -> bool 'core_opt_is_none;
let contains = 'a: Discernible |v: ['a, null], x: 'a| -> bool select v {
    null as _ => false,
    v => v == x
};
let or_default = |v: ['a, null], d: 'a| -> 'a 'core_opt_or_default;
let or = |a: ['a, null], b: ['a, null]| -> ['a, null] 'core_opt_or;
let and = |a: ['a, null], b: ['b, null]| -> ['b, null] 'core_opt_and;
let xor = |a: ['a, null], b: ['a, null]| -> ['a, null] 'core_opt_xor;
let ok_or = |v: ['a, null], e: 'e| -> Result<'a, 'e> 'core_opt_ok_or;
let zip = |a: ['a, null], b: ['b, null]| -> [('a, 'b), null] 'core_opt_zip;
let unzip = |p: [('a, 'b), null]| -> (['a, null], ['b, null]) 'core_opt_unzip;
let map = |v: ['a, null], f: fn(x: 'a) -> 'b throws 'e| -> ['b, null] throws 'e select v {
    null as _ => null,
    x => f(x)
};
let flat_map = |v: ['a, null], f: fn(x: 'a) -> ['b, null] throws 'e| -> ['b, null] throws 'e select v {
    null as _ => null,
    x => f(x)
};
let filter = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> ['a, null] throws 'e select v {
    null as _ => null,
    x => select f(x) { true => x, false => null }
};
let or_else = |v: ['a, null], f: fn() -> ['a, null] throws 'e| -> ['a, null] throws 'e select v {
    null as _ => f(),
    x => x
};
let ok_or_else = |v: ['a, null], f: fn() -> 'e throws 'x| -> Result<'a, 'e> throws 'x select v {
    null as _ => error(f()),
    x => x
};
let is_some_and = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> bool throws 'e select v {
    null as _ => false,
    x => f(x)
};
let is_none_or = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> bool throws 'e select v {
    null as _ => true,
    x => f(x)
}
