let is_some = |v: ['a, null]| -> bool 'core_opt_is_some;
let is_none = |v: ['a, null]| -> bool 'core_opt_is_none;
// CR claude for claude: [bug/medium] contains compares values, but neither this
// signature nor the `val contains` in opt.gxi has a `'a: Discernible` bound. As a
// result it accepts types that `==` refuses: over `[(i64, i64), Array<i64>, null]`, the
// tuple (1, 2) "contains" the array [1, 2]. Also, fc_contains compares the raw Values.
// That means references are compared by cell, not by what they name (bind::ref_target).
// So with r1: [&i64, null] = &a, `opt::contains(r1, &a)` is false while `r1$ == &a` is
// true. To fix, declare `'a: Discernible` here and in the gxi. Then either write the
// body in Graphix as a select over null that uses `==`, so it gets the operator's
// reference handling, or refuse a type that holds a reference (Type::holds_ref). Pin
// both cases. probe: design/review-2026-10-12/repro/core-aux-05.sh Also reported as
// (gx-stdlib-01), (x-builtin-effects-04). (core-aux-05)
let contains = |v: ['a, null], x: 'a| -> bool 'core_opt_contains;
let or_default = |v: ['a, null], d: 'a| -> 'a 'core_opt_or_default;
let or = |a: ['a, null], b: ['a, null]| -> ['a, null] 'core_opt_or;
let and = |a: ['a, null], b: ['b, null]| -> ['b, null] 'core_opt_and;
let xor = |a: ['a, null], b: ['a, null]| -> ['a, null] 'core_opt_xor;
let ok_or = |v: ['a, null], e: 'e| -> Result<'a, 'e> 'core_opt_ok_or;
let zip = |a: ['a, null], b: ['b, null]| -> [('a, 'b), null] 'core_opt_zip;
let unzip = |p: [('a, 'b), null]| -> (['a, null], ['b, null]) 'core_opt_unzip;
let map = |v: ['a, null], f: fn(x: 'a) -> 'b throws 'e| -> ['b, null] throws 'e 'core_opt_map;
let flat_map = |v: ['a, null], f: fn(x: 'a) -> ['b, null] throws 'e| -> ['b, null] throws 'e 'core_opt_flat_map;
let filter = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> ['a, null] throws 'e 'core_opt_filter;
let or_else = |v: ['a, null], f: fn() -> ['a, null] throws 'e| -> ['a, null] throws 'e 'core_opt_or_else;
let ok_or_else = |v: ['a, null], f: fn() -> 'e throws 'x| -> Result<'a, 'e> throws 'x 'core_opt_ok_or_else;
let is_some_and = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> bool throws 'e 'core_opt_is_some_and;
let is_none_or = |v: ['a, null], f: fn(x: 'a) -> bool throws 'e| -> bool throws 'e 'core_opt_is_none_or
