use gui::{
  window,
  column::column,
  data_table::{data_table, progress_column, sparkline_column, text_column},
  text::text
};
use sys::{time, net};
mod icon;

// Enough rows and columns that both the vertical and horizontal
// virtualized scrollbars kick in at the window's 900x400. Rows are real
// netidx paths, and more of them than the subscription window around
// the viewport holds (the displayed rows plus 50 on each side), so
// scrolling subscribes the rows that enter it and drops those that
// leave.

let host_ids = array::init(300, |i| "[i + 1]");

let base = "/local/graphix/data_table_scrolling";

// Drive every metric off one clock so all rows update in lockstep.
let tick = time::timer(duration:2.s, true);

let rand01 = || rand::rand(#start: 0., #end: 1., #clock: tick);
let rand100 = || rand::rand(#start: 0., #end: 100., #clock: tick);
let rand_mbps = || rand::rand(#start: 0., #end: 1000., #clock: tick);

let publish_host = |name: string| {
    net::publish("[base]/host-[name]/cpu_pct", rand100());
    net::publish("[base]/host-[name]/mem_pct", rand100());
    net::publish("[base]/host-[name]/disk_pct", rand100());
    net::publish("[base]/host-[name]/net_in_mbps", rand_mbps());
    net::publish("[base]/host-[name]/net_out_mbps", rand_mbps());
    net::publish("[base]/host-[name]/load_1m", rand01());
    net::publish("[base]/host-[name]/load_5m", rand01());
    net::publish("[base]/host-[name]/load_15m", rand01());
    net::publish("[base]/host-[name]/error_count", rand100());
    net::publish("[base]/host-[name]/request_count", rand_mbps())
};

array::map(host_ids, publish_host);

let make_columns = |raw: Array<string>| array::map(raw, |name| select name {
    "cpu_pct"       => progress_column(#name: "cpu_pct",     #display_name: "CPU %",   #width: &90.),
    "mem_pct"       => progress_column(#name: "mem_pct",     #display_name: "Memory %",#width: &90.),
    "disk_pct"      => progress_column(#name: "disk_pct",    #display_name: "Disk %",  #width: &90.),
    "net_in_mbps"   => text_column(    #name: "net_in_mbps", #display_name: "Net In",  #width: &110.),
    "net_out_mbps"  => text_column(    #name: "net_out_mbps",#display_name: "Net Out", #width: &110.),
    "load_1m"       => sparkline_column(#name: "load_1m",    #history_seconds: 60.,  #display_name: "Load 1m",  #width: &120.),
    "load_5m"       => sparkline_column(#name: "load_5m",    #history_seconds: 300., #display_name: "Load 5m",  #width: &120.),
    "load_15m"      => sparkline_column(#name: "load_15m",   #history_seconds: 900., #display_name: "Load 15m", #width: &120.),
    "error_count"   => text_column(    #name: "error_count", #display_name: "Errors",   #width: &100.),
    "request_count" => text_column(    #name: "request_count",#display_name: "Requests",#width: &110.),
    other => other
});

let raw_tbl = net::list_table(base)$;
let tbl = { rows: raw_tbl.rows, columns: make_columns(raw_tbl.columns) };

let layout = column(
    #spacing: &10.0,
    #padding: &`All(14.0),
    #width: &`Fill,
    #height: &`Fill,
    &[
        text(#size: &18.0, &"300 hosts × 10 metrics"),
        text(&"Scroll vertically or horizontally to reveal off-screen cells."),
        data_table(#table: &tbl)
    ]
);

[&window(
    #icon: &icon::icon,
    #title: &"Data Table — Scrolling",
    #theme: &`CatppuccinMocha,
    #size: &mut {width: 900., height: 400.},
    &layout
)]
