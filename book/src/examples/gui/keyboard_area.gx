use gui::{
  window,
  column::column,
  container::container,
  keyboard_area::keyboard_area,
  text::text
};
mod icon;

let last_key = "None";
let mod_name = "None";

[&window(
    #icon: &icon::icon,
    #title: &"Keyboard Area",
    &keyboard_area(
        #on_key_press: |e| {
            last_key <- e ~ e.key;
            mod_name <- e ~ select e.modifiers {
                { ctrl: true, shift: _, alt: _, logo: _ } => "Ctrl",
                { ctrl: _, shift: true, alt: _, logo: _ } => "Shift",
                { ctrl: _, shift: _, alt: true, logo: _ } => "Alt",
                { ctrl: _, shift: _, alt: _, logo: true } => "Logo",
                _ => "None"
            }
        },
        &container(
            #width: &`Fill,
            #height: &`Fill,
            #halign: &`Center,
            #valign: &`Center,
            &column(
                #spacing: &15.0,
                #halign: &`Center,
                &[
                    text(#size: &24.0, &"Keyboard Area Demo"),
                    // CR claude for claude: [readability/low] The keyboard area hears
                    // no keys until a left click inside it gives it focus
                    // (State::is_focused starts false in iced_keyboard_area), and
                    // keyboard_area.md says so. This prompt tells the user to press a
                    // key, so the demo looks broken until they happen to click. Change
                    // it to "Click here, then press any key...". (examples-gui-05)
                    text(&"Press any key..."),
                    text(#size: &32.0, &last_key),
                    text(&"Modifier: [mod_name]")
                ]
            )
        )
    )
)]
