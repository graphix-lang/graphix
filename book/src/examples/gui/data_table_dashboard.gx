use gui::{
  window,
  column::column,
  data_table::{
    SortBy, SortDirection, Table, button_column, combo_column, data_table,
    progress_column, sparkline_column
  },
  pick_list::pick_list,
  row::row,
  text::text,
  text_input::text_input
};
use core::math;
use sys::{net, time};
mod icon;

// Kitchen-sink example combining the main data_table features:
// * Combo column for state picklists
// * Sparkline column for rolling cpu metrics
// * Progress column for uptime %
// * Button column that fires an action callback
// * Regex row filter wired to a text input
// * Column sort driven by pick_list widgets in the sidebar
// * Selection echoed in the footer

let t = cast<f64>(count(time::timer(duration:1.s, true)))$;

type State = [`Healthy, `Degraded, `Down];

// Publish a tiny fleet of services. state is writable (Combo).
// CR claude for claude: [readability/low] The comment above calls this 'a tiny fleet',
// but the array::init below publishes 1024 services, 4096 cells. The header list puts
// the sort pick-lists 'in the sidebar', but they are in the `controls` row above the
// table. Say 1024 services and 'controls row'. data_table_filter_sort.gx's 'sidebar
// controls' needs the same fix. Found by reading; not run. (examples-gui-02)
let svc = |#state:State, #cpu:f64, #uptime:f64, #name:string| {
    net::publish(
        #on_write: |v: State| state <- v,
        "/local/graphix/data_table_dashboard/[name]/state",
        state
    );
    net::publish("/local/graphix/data_table_dashboard/[name]/cpu", cpu);
    net::publish("/local/graphix/data_table_dashboard/[name]/uptime", uptime);
    net::publish("/local/graphix/data_table_dashboard/[name]/action", "Restart");
};

// single random number
let rn = |start, end| rand::rand(#start, #end, #clock:1);

array::init(1024, |i| svc(
    #name:"svc-[i]",
    #state:select rand::rand(#clock:1) {
        n if n <= 0.8 => `Healthy,
        n if n <= 0.9 => `Degraded,
        _ => `Down
    },
    #uptime:rn(0., 1.),
    #cpu:rn(0., 30.) + rn(1., 5.) * math::sin((t + rn(0., 5.)) / rn(1., 5.))
));

let last_action = "";

// Map the resolver-derived columns array. Bare-string entries
// (anything we don't recognize) pass through as default Text columns;
// the four named columns get their custom ColumnSpec.
let make_columns = |raw: Array<string>| array::map(raw, |name| select name {
    "state" => combo_column(
        #name: "state",
        #choices: [
            { id: "Healthy", label: "Healthy" },
            { id: "Degraded", label: "Degraded" },
            { id: "Down", label: "Down" }
        ],
        #on_edit: |#path: string, #value: string|
            net::write(path, value)$,
        #display_name: "State",
        #width: &110.
    ),
    "cpu" => sparkline_column(
        #name: "cpu",
        #history_seconds: 30.0,
        #display_name: "CPU",
        #width: &220.0,
        #min:0.,
        #max:100.
    ),
    "uptime" => progress_column(
        #name: "uptime",
        #display_name: "Uptime",
        #width: &180.0
    ),
    "action" => button_column(
        #name: "action",
        #on_click: |#path: string, #value: Any|
            last_action <- "[path]",
        #display_name: "Action"
    ),
    other => other
});

// Caller-side filter: apply the regex to the Table's rows, then
// rewrap with the column specs.
let pattern = "";
let tbl: Table = {
    let raw = net::list_table("/local/graphix/data_table_dashboard")$;
    let rows = select str::len(pattern) {
        0 => raw.rows,
        _ => array::filter(raw.rows, |r| {
            let row = opt::or_default(str::basename(r), r);
            select re::is_match(#pat: pattern, row) {
                error as _ => false,
                b => b
            }
        })
    };
    { rows, columns: make_columns(raw.columns) }
};

let sort_col = "state";
let sort_dir: SortDirection = `Ascending;
let sort_by: Array<SortBy> = [{ column: sort_col, direction: sort_dir }];

// Selection + footer
let selection: Array<string> = [];

let controls = row(
    #spacing: &10.0,
    &[
        text(&"Filter:"),
        text_input(
            #on_input: |v| pattern <- v,
            #placeholder: &"regex or blank",
            #width: &`Fill,
            &pattern
        ),
        text(&"Sort:"),
        pick_list(
            #on_select: |v| sort_col <- v,
            #selected: &sort_col,
            &["state", "cpu", "uptime"]
        ),
        pick_list(
            #on_select: |v| sort_dir <- cast<SortDirection>(v)$,
            #selected: &cast<string>(sort_dir)$,
            &["Ascending", "Descending"]
        )
    ]
);

let footer = row(
    #spacing: &10.0,
    &[
        text(&"Selected:"),
        text(&select selection { [p, ..] => "[p]", [] => "" }),
        text(&"  Last action:"),
        text(&"[last_action]")
    ]
);

let layout = column(
    #spacing: &10.0,
    #padding: &`All(20.0),
    #width: &`Fill,
    #height: &`Fill,
    &[
        text(#size: &20.0, &"Service dashboard"),
        controls,
        data_table(
            #sort_by: &sort_by,
            #selection: &selection,
            #on_select: |#path: string| selection <- [path],
            #table: &tbl
        ),
        footer
    ]
);

[&window(
    #icon: &icon::icon,
    #title: &"Data Table — Dashboard",
    #theme: &`CatppuccinMocha,
    &layout
)]
