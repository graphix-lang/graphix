use gui::{window, button::button, column::column, text::text};
mod icon;

let clicks = 0;

[&window(
  #icon: &icon::icon,
  #title: &"Graphix Demo",
  #theme: &`CatppuccinMocha,
  &column(
    #spacing: &20.0,
    #padding: &`All(40.0),
    #halign: &`Center,
    #width: &`Fill,
    #height: &`Fill,
    &[
      text(#size: &24.0, &"Hello, Graphix GUI!"),
      text(&"A simple window with text and a button"),
      button(
        #on_press: |c| clicks <- c ~ clicks + 1,
        #padding: &`All(10.0),
        &text(&"Click me!")
      ),
      text(&"Clicked [clicks] times")
    ]
  )
)]
