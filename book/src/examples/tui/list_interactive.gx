use tui::{
  line, style,
  block::block,
  input_handler::{Event, input_handler, on_press},
  list::list
};

let items = [
    line("Apple"), line("Banana"), line("Cherry"),
    line("Date"), line("Elderberry"), line("Fig"), line("Grape")
];

let last = array::len(items) - 1;
let selected = 0;
let scroll_pos = 0;
let visible = 5;

// Auto-scroll to keep selection visible
// CR claude for claude: [bug/medium] This hand-kept scroll offset uses the constant
// `visible = 5`, not the list's real height. In a 9-row terminal, End scrolls Apple and
// Banana off and leaves two blank rows, although all 7 items fit. With no `#scroll`,
// ratatui's ListState already keeps the selection visible at any size (see the doc on
// ListW's `state`). Delete `scroll_pos`, `visible`, this connect and `#scroll:
// &scroll_pos`. probe: design/review-2026-10-19/repro/examples-tui-list-overscroll.sh
// (examples-tui-01)
scroll_pos <- select selected {
    s if s < scroll_pos => s,
    s if s > (scroll_pos + visible - 1) => s - visible + 1,
    _ => never()
};

let handle_event = |e: Event| on_press(e, |k| select k.code {
    k@`Up if selected > 0 => {
        selected <- (k ~ selected) - 1;
        `Stop
    },
    k@`Down if selected < last => {
        selected <- (k ~ selected) + 1;
        `Stop
    },
    k@`Home => { selected <- k ~ 0; `Stop },
    k@`End => { selected <- k ~ last; `Stop },
    _ => `Continue
});

input_handler(
    #handle: &handle_event,
    &block(
        #border: &`All,
        #title: &line("Fruit Selection"),
        &list(
            #highlight_style: &style(#fg: `Black, #bg: `Yellow),
            #highlight_symbol: &"▶ ",
            #selected: &selected,
            #scroll: &scroll_pos,
            &items
        )
    )
)
