use tui::{line, span, style, Span};
use tui::paragraph::{self, *};

let span: Array<Span> = select range(0, 256)$ {
    i => [
        span(#style:style(#fg:`Indexed(i)), "██"),
        span("[i]"),
        span(#style:style(#fg:`Indexed(i)), "██")
    ]
};
let l = line(array::flatten(array::group(span, |n, _| n == 255)));
paragraph(&[l])
