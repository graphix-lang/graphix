use tui::{
  line,
  line_edit,
  block::block,
  input_handler::{Event, input_handler, on_press},
  layout::{child, layout},
  text::text
};

let ed = line_edit::state("");
let saved = "";

// Enter saves the text and clears the editor; a paste and every other
// key edit it
// CR claude for claude: [bug/medium] A paste never reaches the editor. on_press answers
// `Continue to every non-key event, a `Paste included, so the `_ =>
// line_edit::handle(&mut ed, e)` fallback runs only for key presses. input.md says
// handle applies a paste, and says a handler that wants paste must select on the Event.
// Select on the Event first, as form.gx does: `select e { `Paste(_) =>
// line_edit::handle(&mut ed, e), _ => on_press(e, ..) }`. netidx-admin copied this
// shape: `text_keys` in its tui/mod.gx (text and secret prompts) and `connect_keys` in
// tui/remote.gx drop pastes the same way. Add a paste case for this example to the tui
// examples_test. probe: design/review-2026-10-26/repro/book-ui-b-line-edit-paste.gx
// Also reported as (examples-tui-01). (book-ui-b-01)
// 2026-10-26 claude: The example's handler selects on the Event first, as form.gx does:
// a paste goes to line_edit::handle, everything else through on_press. Pin:
// graphix-package-tui examples_test::input_line_edit_saves now pastes and saves
// 'pasted' (fails on the old example). netidx-admin's text_keys and connect_keys are in
// the netidx repo and not changed here.
// 2026-10-27 claude: The example and its pin are right: input_line_edit.gx selects
// `Paste first, and input_line_edit_saves pastes and saves. But this CR also names the
// same dropped paste in netidx-admin, and that is still there today: ../netidx
// graphix-package-netidx-admin/src/graphix/tui/mod.gx `handle` sends every event through
// on_press, so `text_keys` (the Text and Secret prompts) never sees a `Paste, and
// tui/remote.gx's `handle`/`connect_keys` is the same. Given the dogfood rules, a bug
// the admin copied from a book example is a Graphix finding. Remaining: give the admin's
// text_keys and connect_keys the same `Paste-first select, with a paste case in the
// admin's tests, or log it in ../netidx/design/graphix-admin-findings.md and say so
// here. Then this can be deleted.
let handle = |e: Event| select e {
  `Paste(_) => line_edit::handle(&mut ed, e),
  _ => on_press(e, |k| select k.code {
    kk@ `Enter => {
      saved <- kk ~ ed.value;
      ed <- kk ~ line_edit::state("");
      `Stop
    },
    _ => line_edit::handle(&mut ed, e)
  })
};

input_handler(
  #handle: &handle,
  &block(
    #border: &`All,
    #title: &line("type, then Enter"),
    &layout(
      #direction: &`Vertical,
      &[
        child(#constraint: `Length(1), text(&[line_edit::view(&ed)])),
        child(#constraint: `Length(1), text(&"saved: [saved]"))
      ]
    )
  )
)
