use tui::{
  Size,
  block::block,
  browser::{MoveCursor, browser},
  input_handler::{Event, input_handler, on_press}
};

let path = "/";
let selected_path: [string, null] = never();
let selected_row: [string, null] = never();
let cursor: MoveCursor = never();
let size: Size = never();

let handle_event = |e: Event| on_press(e, |k| on k {
    select k.code {
        `Up => { cursor <- `Up(1); `Stop },
        `Down => { cursor <- `Down(1); `Stop },
        `Left => { cursor <- `Left(1); `Stop },
        `Right => { cursor <- `Right(1); `Stop },
        `Enter => { path <- selected_row$; `Stop },
        _ => `Continue
    }
});

input_handler(
    #handle: &handle_event,
    &block(
        #border: &`None,
        #size: &mut size,
        &browser(
            #size,
            #cursor,
            #selected_path: &mut selected_path,
            #selected_row: &mut selected_row,
            path
        )
    )
)
