use tui::{
  Size, line, span, style,
  block::block,
  browser::{MoveCursor, browser},
  input_handler::{Event, KeyCode, input_handler, on_press}
};

let path = "/";
let command_error = "";
let selected_path: string = never();
let selected_row: string = never();
let cursor: MoveCursor = never();
let command_mode = false;
let command = "";

let run_command = |c: string, path: string| {
    catch(e) command_error <- "[e]";
    select str::sub(#start:0, #len:2, c)? {
        "w " => {
            let v = str::sub(#start:2, #len:str::char_len(c) - 2, c)?;
            let v: Primitive = str::parse(v)?;
            sys::net::write(path, v)?
        },
        s => error("invalid command [s]")?
    }
};

let title_style = style(#fg:`Indexed(202));
let title_bottom = select command_mode {
    true => line(#style:title_style, ":[command]"),
    false => {
        let spans = [
            span("[path] ([selected_path])"),
            span(#style:style(#fg:`Red), "  [command_error]")
        ];
        line(#style:title_style, spans)
    }
};

let handle_normal_mode_key = |e: KeyCode| -> [`Stop, `Continue] select e {
    e@ `Left => { cursor <- e ~ `Left(1); `Stop },
    e@ `Right => { cursor <- e ~ `Right(1); `Stop },
    e@ `Down => { cursor <- e ~ `Down(1); `Stop },
    e@ `Up => { cursor <- e ~ `Up(1); `Stop },
    e@ `Enter => { path <- e ~ selected_row; `Stop },
    e@ `Backspace => select e ~ str::dirname(path) {
        null as _ => `Stop,
        s => {
            path <- s;
            `Stop
        }
    },
    `Char(":") => {
        command <- "";
        command_error <- "";
        command_mode <- true;
        `Stop
    },
    _ => `Continue
};

let handle_command_mode_key = |e: KeyCode| -> [`Stop, `Continue] select e {
    `Char(c) => {
        command <- c ~ "[command][c]";
        `Stop
    },
    x@ `Enter => {
        command_mode <- false;
        // CR claude for claude: [bug/medium] browser_commands: `x ~ selected_path`
        // banks, so ':w' runs unasked or twice. `run_command(command, x ~
        // selected_path)` samples selected_path with the banking `~`. selected_path
        // starts as `never()` and has no value until the browser's async listing gives
        // it a row. Enter pressed before then banks the trigger. The command then runs
        // when the row arrives, against whatever row is selected first, with no Enter
        // for it. If the arm slept in between, the next real Enter runs the command
        // twice. `command` is also left unsampled, against the skill's rule that an
        // effect samples its whole input on the trigger. run_command performs
        // `sys::net::write`, so the phantom run is a netidx write to a path the user
        // never chose. Failure: Model of the example's key logic. (a) Keys ':', 'a',
        // Enter while selected_path is absent; 300 ms later selected_path arrives: it
        // prints `RUN a at /rows/first` with no further key. (b) ':', 'a', Enter (no
        // selection), Down, rows arrive, ':', 'b', Enter: `RUN b at /rows/first` is
        // printed twice, so the write would be sent twice. Fix: `run_command(x ~!
        // command, x ~! selected_path)`: strict sampling, no bank. With it, (a) prints
        // nothing and (b) prints one RUN. Unverified: the reviewer's report, not
        // checked by a verifier. (examples-tui-02)
        run_command(command, x ~ selected_path);
        `Stop
    },
    e@ `Backspace if command != "" => {
        let len = str::char_len(command) - 1;
        command <- e ~ str::sub(#start:0, #len, command)$;
        `Stop
    },
    `Esc => {
        command_mode <- false;
        `Stop
    },
    _ => `Continue
};

let handle_event = |e: Event| on_press(e, |k| select k ~ command_mode {
    true => handle_command_mode_key(k.code),
    false => handle_normal_mode_key(k.code)
});

let size: Size = never();

let browser = browser(
    #cursor,
    #selected_row: &mut selected_row,
    #selected_path: &mut selected_path,
    #size,
    path
);

let block = block(
    #border:&`None,
    #title_bottom:&title_bottom,
    #style:&style(#bg:`Indexed(234)),
    #size:&size,
    &browser
);

input_handler(#handle: &handle_event, &block)
