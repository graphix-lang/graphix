use tui::{
  Size, line, style,
  input_handler::{Event, input_handler, on_press},
  list::list,
  scrollbar::scrollbar
};

let items = array::init(30, |i| line("Item [i + 1]"));
let last = array::len(items) - 1;
let selected = 0;
let scroll_pos = 0;
let size: Size = never();
let visible = size.height;

// Auto-scroll to keep selection visible
scroll_pos <- select selected {
    s if s < scroll_pos => s,
    s if s >= (scroll_pos + visible) => s - visible + 1,
    _ => never()
};

let handle_event = |e: Event| on_press(e, |k| select k.code {
    k@`Up if selected > 0 => {
        selected <- (k ~ selected) - 1;
        `Stop
    },
    k@`Down if selected < last => {
        selected <- (k ~ selected) + 1;
        `Stop
    },
    _ => `Continue
});

input_handler(
    #handle: &handle_event,
    &scrollbar(
        #position: &scroll_pos,
        #content_length: &array::len(items),
        #viewport_length: &visible,
        #size: &mut size,
        &list(
            #highlight_style: &style(#fg: `Black, #bg: `Yellow),
            #scroll: &scroll_pos,
            #selected: &selected,
            &items
        )
    )
)
