use tui::{
  input_handler::{Event, input_handler, on_press},
  paragraph::paragraph
};

let count = 0;

let handle = |e: Event| on_press(e, |k| on k {
  select k.code {
    `Char("q") => {
      tui::exit(null);
      `Stop
    },
    `Up => {
      count <- count + 1;
      `Stop
    },
    `Down => {
      count <- count - 1;
      `Stop
    },
    _ => `Continue
  }
});

input_handler(#handle: &handle, &paragraph(&"[count]"))
