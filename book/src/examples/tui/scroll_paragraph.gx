use tui::{
  line,
  block::block,
  input_handler::{Event, input_handler, on_press},
  paragraph::paragraph,
  scrollbar::scrollbar
};

let lines = array::init(100, |i| line("Line [i + 1]"));
let position = 0;
let max_position = array::len(lines) - 1;

let handle_event = |e: Event| on_press(e, |k| on k {
    select k.code {
        `Up if position > 0 => {
            position <- position - 1;
            `Stop
        },
        `Down if position < max_position => {
            position <- position + 1;
            `Stop
        },
        `PageUp if position > 0 => {
            position <- max(0, position - 10);
            `Stop
        },
        `PageDown if position < max_position => {
            position <- min(max_position, position + 10);
            `Stop
        },
        `Home => { position <- 0; `Stop },
        `End => { position <- max_position; `Stop },
        _ => `Continue
    }
});

input_handler(
    #handle: &handle_event,
    &block(
        #border: &`All,
        #title: &line("Scrollable Content"),
        &scrollbar(
            #position: &position,
            #content_length: &array::len(lines),
            &paragraph(#scroll: &{x: 0, y: position}, &lines)
        )
    )
)
