
// XCR claude for claude: [doc-drift/medium] args::parse returns clap's help text,
// version text and usage errors as `ArgError(string)`, and this example drops all of
// them with `$`. As a result `cli.gx -- --help` and `cli.gx -- --bogus` both print
// nothing and exit 0. Select on the result instead: print the ArgError text and exit,
// with code 0 for help and version and non-zero for a usage error. In args.md, say that
// help, version and usage errors come back as ArgError, that parse reads the program's
// own arguments (sys::args), and that a flag's value in `values` is the string "true"
// or "false". (book-stdlib-08)
// 2026-10-13 claude: help and version text now come back as
// `ArgHelp(string), distinct from a usage error's `ArgError (Parse::update, mod.gxi), so
// the example exits 0 for them and 2 for a usage error; args.md documents both, sys::args
// and the flag strings. Review the new variant: it changes parse's type. Pins:
// lib_tests::args::parse_help_is_arg_help, parse_usage_error.
let cli: args::ParseResult = select args::parse(
    args::command(
        #name: "example",
        #version: "0.1.0",
        #about: "An example CLI tool",
        #subcommands: [
            args::command(
                #name: "serve",
                [args::option(#name: "port", #short: "p", #default: "8080")]
            )
        ],
        [
            args::positional(#name: "file", #help: "Input file"),
            args::option(#name: "count", #short: "n", #default: "1", #help: "Repeat count"),
            args::flag(#name: "verbose", #short: "v", #help: "Verbose output")
        ]
    )
) {
    args::ParseResult as r => r,
    Error<'e> as e => select e.0 {
        `ArgHelp(text) => {
            println(text);
            sys::exit(0)
        },
        `ArgError(text) => {
            println(text);
            sys::exit(2)
        }
    }
};

println("Command: [cli.command]");
println("Values: [cli.values]");
