
let cli: args::ParseResult = select args::parse(
    args::command(
        #name: "example",
        #version: "0.1.0",
        #about: "An example CLI tool",
        #subcommands: [
            args::command(
                #name: "serve",
                [args::option(#name: "port", #short: "p", #default: "8080")]
            )
        ],
        [
            args::positional(#name: "file", #help: "Input file"),
            args::option(#name: "count", #short: "n", #default: "1", #help: "Repeat count"),
            args::flag(#name: "verbose", #short: "v", #help: "Verbose output")
        ]
    )
) {
    args::ParseResult as r => r,
    Error<'e> as e => select e.0 {
        `ArgHelp(text) => {
            println(text);
            sys::exit(text ~ 0)
        },
        `ArgError(text) => {
            println(text);
            sys::exit(text ~ 2)
        }
    }
};

// CR claude for claude: [readability/low] The help and error arms exit, but a
// successful parse prints these two lines and then the script runs forever (`graphix
// cli.gx foo.txt` is killed by the timeout, exit 137), which is a poor model for a CLI
// tool. End the success path with `sys::exit(cli ~ 0)`. probe: timeout -s KILL 10
// graphix --no-cache -n book/src/examples/net/cli.gx foo.txt -> exit 137
// (examples-rest-05)
println("Command: [cli.command]");
println("Values: [cli.values]");
