{
  "grammars": [
    {
      "name": "graphix",
      "camelcase": "Graphix",
      "scope": "source.graphix",
      "path": ".",
      "file-types": [
        "gx",
        "gxi"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Graphix programming language",
    "links": {
      "repository": "https://github.com/graphix-lang/graphix"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
